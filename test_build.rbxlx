            <string name="Source"><![CDATA[--!strict
-- src/client/ui/components/ActionDockView.luau
-- Manages the center action dock with "BID" and "LEADERBOARD" quick-reopen buttons.

local ActionDockView = {}
ActionDockView.__index = ActionDockView

export type ActionDock = {
	DockFrame: Frame,
	ReopenBidBtn: TextButton,
	ReopenRankBtn: TextButton,
	UpdateVisibility: (self: ActionDock, phase: string, isActiveInRound: boolean, bidModalVisible: boolean, rankModalVisible: boolean) -> (),
	SetVisible: (self: ActionDock, visible: boolean) -> (),
}

local function applySVG3ButtonStyle(button: TextButton, labelText: string, textSize: number?)
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	button.BackgroundTransparency = 0
	button.BorderSizePixel = 0
	button.Text = ""

	local corner = button:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 1)
	corner.Parent = button

	local stroke = button:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Miter
	stroke.Parent = button

	local gradient = button:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromHex("#EC0000")),
		ColorSequenceKeypoint.new(0.54, Color3.fromHex("#F50505")),
		ColorSequenceKeypoint.new(0.78, Color3.fromHex("#E25A5A")),
		ColorSequenceKeypoint.new(1.00, Color3.fromHex("#D6C7C7")),
	})
	gradient.Enabled = true
	gradient.Parent = button

	local label = button:FindFirstChild("BtnLabel") :: TextLabel?
	if not label then
		label = Instance.new("TextLabel")
		label.Name = "BtnLabel"
		label.Size = UDim2.fromScale(1, 1)
		label.Position = UDim2.fromScale(0, 0)
		label.BackgroundTransparency = 1
		label.ZIndex = button.ZIndex + 3
		label.Parent = button
	end
	label.Text = labelText
	label.Font = Enum.Font.GothamMedium
	label.TextSize = textSize or 24
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
end

function ActionDockView.new(gui: ScreenGui, onOpenBid: () -> (), onOpenRank: () -> ()): ActionDock
	local self = setmetatable({}, ActionDockView) :: any

	local centerActionDock = (gui:FindFirstChild("CenterActionDock") or gui:FindFirstChild("ReopenContainer")) :: Frame?
	if not centerActionDock then
		centerActionDock = Instance.new("Frame")
		centerActionDock.Name = "CenterActionDock"
		centerActionDock.AnchorPoint = Vector2.new(0.5, 0.5)
		centerActionDock.Position = UDim2.new(0.5, 0, 0.25, 0)
		centerActionDock.Size = UDim2.new(0, 184, 0, 50)
		centerActionDock.BackgroundTransparency = 1
		centerActionDock.ZIndex = 35
		centerActionDock.Visible = false
		centerActionDock.Parent = gui
	else
		centerActionDock.AnchorPoint = Vector2.new(0.5, 0.5)
		centerActionDock.Position = UDim2.new(0.5, 0, 0.25, 0)
		centerActionDock.Size = UDim2.new(0, 184, 0, 50)
	end
	self.DockFrame = centerActionDock

	-- 1. ReopenBidBtn
	local reopenBidBtn = centerActionDock:FindFirstChild("ReopenBidBtn") :: TextButton?
	if not reopenBidBtn then
		reopenBidBtn = Instance.new("TextButton")
		reopenBidBtn.Name = "ReopenBidBtn"
		reopenBidBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		reopenBidBtn.Size = UDim2.new(0, 184, 0, 50)
		reopenBidBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
		reopenBidBtn.ZIndex = 36
		reopenBidBtn.Visible = false
		reopenBidBtn.Parent = centerActionDock
	end
	applySVG3ButtonStyle(reopenBidBtn, "BID", 24)
	self.ReopenBidBtn = reopenBidBtn

	-- 2. ReopenRankBtn
	local reopenRankBtn = centerActionDock:FindFirstChild("ReopenRankBtn") :: TextButton?
	if not reopenRankBtn then
		reopenRankBtn = Instance.new("TextButton")
		reopenRankBtn.Name = "ReopenRankBtn"
		reopenRankBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		reopenRankBtn.Size = UDim2.new(0, 184, 0, 50)
		reopenRankBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
		reopenRankBtn.ZIndex = 36
		reopenRankBtn.Visible = false
		reopenRankBtn.Parent = centerActionDock
	end
	applySVG3ButtonStyle(reopenRankBtn, "LEADERBOARD", 18)
	self.ReopenRankBtn = reopenRankBtn

	reopenBidBtn.MouseButton1Click:Connect(function()
		if onOpenBid then onOpenBid() end
	end)

	reopenRankBtn.MouseButton1Click:Connect(function()
		if onOpenRank then onOpenRank() end
	end)

	function self:UpdateVisibility(phase: string, isActiveInRound: boolean, bidModalVisible: boolean, rankModalVisible: boolean)
		if not isActiveInRound then
			self.ReopenBidBtn.Visible = false
			self.ReopenRankBtn.Visible = false
			self.DockFrame.Visible = false
			return
		end

		if phase == "Phase3_Bid" then
			self.ReopenBidBtn.Visible = not bidModalVisible
			self.ReopenRankBtn.Visible = false
		elseif phase == "Phase4_Reveal" then
			self.ReopenBidBtn.Visible = false
			self.ReopenRankBtn.Visible = not rankModalVisible
		else
			self.ReopenBidBtn.Visible = false
			self.ReopenRankBtn.Visible = false
		end

		self.DockFrame.Visible = (self.ReopenBidBtn.Visible or self.ReopenRankBtn.Visible)
	end

	function self:SetVisible(visible: boolean)
		self.DockFrame.Visible = visible
	end

	return self
end

return ActionDockView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">ControlsDockView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/components/ControlsDockView.luau
-- Manages the middle-left controls dock: Settings gear button and AFK toggle button.

local GuiService = game:GetService("GuiService")

local ControlsDockView = {}
ControlsDockView.__index = ControlsDockView

export type ControlsDock = {
	DockFrame: Frame,
	SettingsButton: ImageButton,
	AFKButton: TextButton,
	IsAFK: boolean,
	SetAFK: (self: ControlsDock, isAFK: boolean) -> (),
	GetAFK: (self: ControlsDock) -> boolean,
	SetVisible: (self: ControlsDock, visible: boolean) -> (),
}

function ControlsDockView.new(gui: ScreenGui, setAFKRemote: RemoteEvent?): ControlsDock
	local self = setmetatable({}, ControlsDockView) :: any
	self.IsAFK = false

	-- Clean up legacy root-level buttons to avoid duplicate instances
	local legacySettings = gui:FindFirstChild("SettingsButton")
	if legacySettings and legacySettings.Parent == gui then
		legacySettings:Destroy()
	end
	local legacyAFK = gui:FindFirstChild("AFKButton")
	if legacyAFK and legacyAFK.Parent == gui then
		legacyAFK:Destroy()
	end

	-- Root LeftControlsDock frame
	local leftControlsDock = gui:FindFirstChild("LeftControlsDock") :: Frame?
	if not leftControlsDock then
		leftControlsDock = Instance.new("Frame")
		leftControlsDock.Name = "LeftControlsDock"
		leftControlsDock.AnchorPoint = Vector2.new(0, 0.5)
		leftControlsDock.Position = UDim2.new(0, 24, 0.5, 0)
		leftControlsDock.Size = UDim2.new(0, 134, 0, 84)
		leftControlsDock.BackgroundTransparency = 1
		leftControlsDock.ZIndex = 20
		leftControlsDock.Parent = gui
	end
	self.DockFrame = leftControlsDock

	-- 1. Settings gear button
	local settingsButton = leftControlsDock:FindFirstChild("SettingsButton") :: ImageButton?
	if not settingsButton then
		settingsButton = Instance.new("ImageButton")
		settingsButton.Name = "SettingsButton"
		settingsButton.AnchorPoint = Vector2.new(0, 0)
		settingsButton.Position = UDim2.new(0, 0, 0, 0)
		settingsButton.Size = UDim2.new(0, 36, 0, 36)
		settingsButton.BackgroundTransparency = 1
		settingsButton.Image = "rbxassetid://6031280882"
		settingsButton.ImageColor3 = Color3.fromRGB(240, 240, 240)
		settingsButton.ZIndex = 21
		settingsButton.Parent = leftControlsDock
	end
	self.SettingsButton = settingsButton

	settingsButton.MouseButton1Click:Connect(function()
		pcall(function()
			GuiService:SetMenuIsOpen(true)
		end)
	end)

	-- 2. AFK toggle button
	local afkButton = leftControlsDock:FindFirstChild("AFKButton") :: TextButton?
	if not afkButton then
		afkButton = Instance.new("TextButton")
		afkButton.Name = "AFKButton"
		afkButton.AnchorPoint = Vector2.new(0, 0)
		afkButton.Position = UDim2.new(0, 0, 0, 44)
		afkButton.Size = UDim2.new(0, 130, 0, 34)
		afkButton.Font = Enum.Font.GothamBold
		afkButton.TextSize = 14
		afkButton.TextColor3 = Color3.fromRGB(0, 0, 0)
		afkButton.ZIndex = 21
		afkButton.AutoButtonColor = false

		local afkCorner = Instance.new("UICorner")
		afkCorner.CornerRadius = UDim.new(0, 4)
		afkCorner.Parent = afkButton

		local afkStroke = Instance.new("UIStroke")
		afkStroke.Thickness = 2
		afkStroke.Color = Color3.fromRGB(0, 0, 0)
		afkStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		afkStroke.Parent = afkButton

		afkButton.Parent = leftControlsDock
	end
	self.AFKButton = afkButton

	local function updateAFKVisual()
		if self.IsAFK then
			afkButton.BackgroundColor3 = Color3.fromRGB(255, 215, 0) -- Yellow when ON
			afkButton.Text = "AFK: ON"
		else
			afkButton.BackgroundColor3 = Color3.fromRGB(0, 200, 80) -- Clean green when OFF
			afkButton.Text = "AFK: OFF"
		end
	end

	updateAFKVisual()

	afkButton.MouseButton1Click:Connect(function()
		self.IsAFK = not self.IsAFK
		updateAFKVisual()
		if setAFKRemote then
			setAFKRemote:FireServer(self.IsAFK)
		end
	end)

	function self:SetAFK(isAFK: boolean)
		self.IsAFK = isAFK
		updateAFKVisual()
	end

	function self:GetAFK(): boolean
		return self.IsAFK
	end

	function self:SetVisible(visible: boolean)
		self.DockFrame.Visible = visible
	end

	return self
end

return ControlsDockView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">HammerRouletteView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/components/HammerRouletteView.luau
-- Encapsulates the SVG.5 3-slot horizontal hammer spinning roulette, needle kickers,
-- dynamic deceleration curves, multi-pitch audio clicks, and victory celebration flare.

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")

local VERIFIED_BASE_HAMMER = "rbxassetid://99122878797775"

local HammerRouletteView = {}
HammerRouletteView.__index = HammerRouletteView

export type HammerRoulette = {
	Container: Frame,
	RouletteScale: UIScale,
	RouletteBg: ImageLabel,
	RouletteBgFallback: Frame,
	ReelClipper: Frame,
	ReelTrack: Frame,
	CenterSlotFrame: Frame,
	TopPointer: Frame,
	BottomPointer: Frame,
	SunburstRays: ImageLabel,
	IsRoulettePlaying: boolean,
	GameConfig: any,
	ShakeCamera: (intensity: number, duration: number) -> (),
	PendingAssets: {[string]: boolean},
	Play: (self: HammerRoulette, targetRarity: any, totalDuration: number?, spinnerReel: {string}?, isRoundActive: () -> boolean, sessionToken: number, getCurrentToken: () -> number) -> (),
	Stop: (self: HammerRoulette) -> (),
	IsPlaying: (self: HammerRoulette) -> boolean,
	SetVisible: (self: HammerRoulette, visible: boolean) -> (),
}

function HammerRouletteView.new(gui: ScreenGui, gameConfig: any, shakeCameraFn: ((number, number) -> ())?): HammerRoulette
	local self = setmetatable({}, HammerRouletteView) :: any
	self.GameConfig = gameConfig
	self.IsRoulettePlaying = false
	self.PendingAssets = {}
	self.ShakeCamera = shakeCameraFn or function(_i: number, _d: number) end

	-- Preload probe for rarity assets
	task.spawn(function()
		if gameConfig and gameConfig.RarityOrder and gameConfig.HammerRarities then
			for _, rarityName in ipairs(gameConfig.RarityOrder) do
				local rData = gameConfig.HammerRarities[rarityName]
				if rData and rData.AssetId then
					local testImg = Instance.new("ImageLabel")
					testImg.Image = rData.AssetId
					ContentProvider:PreloadAsync({testImg}, function(assetId, status)
						if status == Enum.AssetFetchStatus.Failure then
							self.PendingAssets[assetId] = true
						end
					end)
				end
			end
		end
	end)

	-- Root RouletteContainer
	local rouletteContainer = gui:FindFirstChild("RouletteContainer") :: Frame?
	if not rouletteContainer then
		rouletteContainer = Instance.new("Frame")
		rouletteContainer.Name = "RouletteContainer"
		rouletteContainer.AnchorPoint = Vector2.new(0.5, 0.5)
		rouletteContainer.Position = UDim2.new(0.5, 0, 0.44, 0)
		rouletteContainer.Size = UDim2.new(0, 584, 0, 218)
		rouletteContainer.BackgroundTransparency = 1
		rouletteContainer.ZIndex = 30
		rouletteContainer.Visible = false
		rouletteContainer.Parent = gui
	end
	self.Container = rouletteContainer

	-- UIScale for responsiveness
	local rouletteScale = rouletteContainer:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	rouletteScale.Parent = rouletteContainer
	self.RouletteScale = rouletteScale

	local function updateResponsiveScale()
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local scaleW = (vp.X - 32) / 670
		local scaleH = (vp.Y - 120) / 380
		rouletteScale.Scale = 1.20 * math.clamp(math.min(scaleW, scaleH), 0.58, 1.0)
	end
	task.defer(updateResponsiveScale)
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateResponsiveScale)

	-- 1. SVG.5 Background & Fallback
	local rouletteBg = rouletteContainer:FindFirstChild("RouletteBg") :: ImageLabel?
	if not rouletteBg then
		rouletteBg = Instance.new("ImageLabel")
		rouletteBg.Name = "RouletteBg"
		rouletteBg.Size = UDim2.new(1, 0, 1, 0)
		rouletteBg.Position = UDim2.new(0, 0, 0, 0)
		rouletteBg.BackgroundTransparency = 1
		rouletteBg.Image = "rbxasset://textures/spin_bg.png"
		rouletteBg.ScaleType = Enum.ScaleType.Fit
		rouletteBg.ZIndex = 31
		rouletteBg.Parent = rouletteContainer
	end
	self.RouletteBg = rouletteBg

	local rouletteBgFallback = rouletteContainer:FindFirstChild("RouletteBgFallback") :: Frame?
	if not rouletteBgFallback then
		rouletteBgFallback = Instance.new("Frame")
		rouletteBgFallback.Name = "RouletteBgFallback"
		rouletteBgFallback.Size = UDim2.new(1, 0, 1, 0)
		rouletteBgFallback.BackgroundColor3 = Color3.fromRGB(255, 119, 0)
		rouletteBgFallback.BackgroundTransparency = 0
		rouletteBgFallback.ZIndex = 30

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(0, 13)
		bgCorner.Parent = rouletteBgFallback

		local bgStroke = Instance.new("UIStroke")
		bgStroke.Color = Color3.fromRGB(0, 0, 0)
		bgStroke.Thickness = 3
		bgStroke.Parent = rouletteBgFallback

		rouletteBgFallback.Parent = rouletteContainer
	end
	self.RouletteBgFallback = rouletteBgFallback

	-- 2. Reel Clipper & Track
	local reelClipper = rouletteContainer:FindFirstChild("ReelClipper") :: Frame?
	if not reelClipper then
		reelClipper = Instance.new("Frame")
		reelClipper.Name = "ReelClipper"
		reelClipper.Size = UDim2.new(0, 566, 0, 200)
		reelClipper.Position = UDim2.new(0.5, 0, 0.5, 0)
		reelClipper.AnchorPoint = Vector2.new(0.5, 0.5)
		reelClipper.BackgroundTransparency = 1
		reelClipper.BorderSizePixel = 0
		reelClipper.ClipsDescendants = true
		reelClipper.ZIndex = 33
		reelClipper.Parent = rouletteContainer

		local clipperGradient = Instance.new("UIGradient")
		clipperGradient.Name = "ClipperGradient"
		clipperGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0.00, 1.00),
			NumberSequenceKeypoint.new(0.08, 0.50),
			NumberSequenceKeypoint.new(0.20, 0.00),
			NumberSequenceKeypoint.new(0.80, 0.00),
			NumberSequenceKeypoint.new(0.92, 0.50),
			NumberSequenceKeypoint.new(1.00, 1.00),
		})
		clipperGradient.Parent = reelClipper
	end
	self.ReelClipper = reelClipper

	local reelTrack = reelClipper:FindFirstChild("ReelTrack") :: Frame?
	if not reelTrack then
		reelTrack = Instance.new("Frame")
		reelTrack.Name = "ReelTrack"
		reelTrack.Size = UDim2.new(0, 15000, 1, 0)
		reelTrack.Position = UDim2.new(0, 0, 0, 0)
		reelTrack.BackgroundTransparency = 1
		reelTrack.BorderSizePixel = 0
		reelTrack.ZIndex = 33
		reelTrack.Parent = reelClipper
	end
	self.ReelTrack = reelTrack

	-- 3. Center Result Slot Frame
	local centerSlotFrame = rouletteContainer:FindFirstChild("CenterSlotFrame") :: Frame?
	if not centerSlotFrame then
		centerSlotFrame = Instance.new("Frame")
		centerSlotFrame.Name = "CenterSlotFrame"
		centerSlotFrame.Size = UDim2.new(0, 199, 0, 199)
		centerSlotFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		centerSlotFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		centerSlotFrame.BackgroundTransparency = 1
		centerSlotFrame.BorderSizePixel = 0
		centerSlotFrame.ZIndex = 36

		local csCorner = Instance.new("UICorner")
		csCorner.CornerRadius = UDim.new(0, 5)
		csCorner.Parent = centerSlotFrame

		local csStroke = Instance.new("UIStroke")
		csStroke.Name = "CenterStroke"
		csStroke.Color = Color3.fromRGB(255, 255, 255)
		csStroke.Thickness = 2.5
		csStroke.Parent = centerSlotFrame

		centerSlotFrame.Parent = rouletteContainer
	end
	self.CenterSlotFrame = centerSlotFrame

	-- Top & Bottom Needles
	local topPointer = centerSlotFrame:FindFirstChild("TopPointer") :: Frame?
	if not topPointer then
		topPointer = Instance.new("Frame")
		topPointer.Name = "TopPointer"
		topPointer.Size = UDim2.new(0, 26, 0, 15)
		topPointer.Position = UDim2.new(0.5, 0, 0, -3)
		topPointer.AnchorPoint = Vector2.new(0.5, 1)
		topPointer.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
		topPointer.BorderSizePixel = 0
		topPointer.ZIndex = 40

		local tpCorner = Instance.new("UICorner")
		tpCorner.CornerRadius = UDim.new(0, 3)
		tpCorner.Parent = topPointer

		local tpStroke = Instance.new("UIStroke")
		tpStroke.Color = Color3.fromRGB(0, 0, 0)
		tpStroke.Thickness = 2
		tpStroke.Parent = topPointer

		local tpArrow = Instance.new("TextLabel")
		tpArrow.Name = "Arrow"
		tpArrow.Size = UDim2.new(1, 0, 1, 0)
		tpArrow.BackgroundTransparency = 1
		tpArrow.Font = Enum.Font.GothamBlack
		tpArrow.TextSize = 13
		tpArrow.TextColor3 = Color3.fromRGB(0, 0, 0)
		tpArrow.Text = "▼"
		tpArrow.ZIndex = 41
		tpArrow.Parent = topPointer

		topPointer.Parent = centerSlotFrame
	end
	self.TopPointer = topPointer

	local bottomPointer = centerSlotFrame:FindFirstChild("BottomPointer") :: Frame?
	if not bottomPointer then
		bottomPointer = Instance.new("Frame")
		bottomPointer.Name = "BottomPointer"
		bottomPointer.Size = UDim2.new(0, 26, 0, 15)
		bottomPointer.Position = UDim2.new(0.5, 0, 1, 3)
		bottomPointer.AnchorPoint = Vector2.new(0.5, 0)
		bottomPointer.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
		bottomPointer.BorderSizePixel = 0
		bottomPointer.ZIndex = 40

		local bpCorner = Instance.new("UICorner")
		bpCorner.CornerRadius = UDim.new(0, 3)
		bpCorner.Parent = bottomPointer

		local bpStroke = Instance.new("UIStroke")
		bpStroke.Color = Color3.fromRGB(0, 0, 0)
		bpStroke.Thickness = 2
		bpStroke.Parent = bottomPointer

		local bpArrow = Instance.new("TextLabel")
		bpArrow.Name = "Arrow"
		bpArrow.Size = UDim2.new(1, 0, 1, 0)
		bpArrow.BackgroundTransparency = 1
		bpArrow.Font = Enum.Font.GothamBlack
		bpArrow.TextSize = 13
		bpArrow.TextColor3 = Color3.fromRGB(0, 0, 0)
		bpArrow.Text = "▲"
		bpArrow.ZIndex = 41
		bpArrow.Parent = bottomPointer

		bottomPointer.Parent = centerSlotFrame
	end
	self.BottomPointer = bottomPointer

	-- Sunburst Rays
	local sunburstRays = centerSlotFrame:FindFirstChild("SunburstRays") :: ImageLabel?
	if not sunburstRays then
		sunburstRays = Instance.new("ImageLabel")
		sunburstRays.Name = "SunburstRays"
		sunburstRays.Size = UDim2.new(0, 185, 0, 185)
		sunburstRays.Position = UDim2.new(0.5, 0, 0.5, -8)
		sunburstRays.AnchorPoint = Vector2.new(0.5, 0.5)
		sunburstRays.BackgroundTransparency = 1
		sunburstRays.Image = "rbxassetid://2583861218"
		sunburstRays.ImageColor3 = Color3.fromRGB(255, 225, 100)
		sunburstRays.ImageTransparency = 1
		sunburstRays.ScaleType = Enum.ScaleType.Fit
		sunburstRays.ZIndex = 32
		sunburstRays.Visible = false
		sunburstRays.Parent = centerSlotFrame
	end
	self.SunburstRays = sunburstRays

	function self:Play(targetRarity: any, totalDuration: number?, spinnerReel: {string}?, isRoundActive: () -> boolean, sessionToken: number, getCurrentToken: () -> number)
		if self.IsRoulettePlaying then return end
		if isRoundActive and not isRoundActive() then return end
		self.IsRoulettePlaying = true
		local myToken = sessionToken

		if typeof(targetRarity) == "string" then
			targetRarity = (self.GameConfig and self.GameConfig.HammerRarities and self.GameConfig.HammerRarities[targetRarity]) or {
				Name = targetRarity,
				DamagePercent = 30,
				Color = Color3.fromRGB(220, 225, 235),
				GlowColor = Color3.fromRGB(240, 240, 255),
				AssetId = VERIFIED_BASE_HAMMER,
			}
		elseif typeof(targetRarity) ~= "table" then
			targetRarity = (self.GameConfig and self.GameConfig.HammerRarities and self.GameConfig.HammerRarities.Common) or {
				Name = "Common",
				DamagePercent = 20,
				Color = Color3.fromRGB(200, 200, 200),
				GlowColor = Color3.fromRGB(220, 220, 220),
				AssetId = VERIFIED_BASE_HAMMER,
			}
		end

		local csStroke = self.CenterSlotFrame:FindFirstChild("CenterStroke") :: UIStroke?
		if csStroke then
			csStroke.Color = Color3.fromRGB(255, 255, 255)
			csStroke.Thickness = 2.0
			csStroke.Transparency = 0
		end

		for _, child in ipairs(self.ReelTrack:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		local CARD_STEP = 190
		local TOTAL_CARDS = 60
		local WIN_INDEX = 10
		local SPIN_TRAVEL_CARDS = 35

		local raritiesList = (self.GameConfig and self.GameConfig.GetRarityList and self.GameConfig.GetRarityList()) or {}
		if #raritiesList == 0 and self.GameConfig and self.GameConfig.HammerRarities then
			for _, name in ipairs(self.GameConfig.RarityOrder or {"Common", "Uncommon", "Rare", "Legendary", "Mythical"}) do
				table.insert(raritiesList, self.GameConfig.HammerRarities[name])
			end
		end

		local reelData = {}
		for i = 1, TOTAL_CARDS do
			if i == WIN_INDEX then
				reelData[i] = targetRarity
			elseif i == WIN_INDEX + 1 then
				local alt = (self.GameConfig and self.GameConfig.HammerRarities and (self.GameConfig.HammerRarities.Legendary or self.GameConfig.HammerRarities.Mythical))
				if alt and alt.Name == targetRarity.Name then
					alt = self.GameConfig.HammerRarities.Rare or self.GameConfig.HammerRarities.Common
				end
				reelData[i] = alt or targetRarity
			elseif i == WIN_INDEX - 1 then
				local alt = (self.GameConfig and self.GameConfig.HammerRarities and (self.GameConfig.HammerRarities.Rare or self.GameConfig.HammerRarities.Uncommon))
				if alt and alt.Name == targetRarity.Name then
					alt = self.GameConfig.HammerRarities.Common
				end
				reelData[i] = alt or targetRarity
			elseif spinnerReel and spinnerReel[i] and self.GameConfig and self.GameConfig.HammerRarities and self.GameConfig.HammerRarities[spinnerReel[i]] then
				reelData[i] = self.GameConfig.HammerRarities[spinnerReel[i]]
			else
				local pick = raritiesList[math.random(1, math.max(1, #raritiesList))]
				if i > 1 and reelData[i - 1] and pick and reelData[i - 1].Name == pick.Name then
					local alt = raritiesList[(math.random(1, math.max(1, #raritiesList - 1)))]
					pick = (alt and alt.Name ~= pick.Name) and alt or raritiesList[1]
				end
				reelData[i] = pick or targetRarity
			end
		end

		local items = {}
		for i = 1, TOTAL_CARDS do
			local rData = reelData[i]
			if typeof(rData) == "string" and self.GameConfig and self.GameConfig.HammerRarities then
				rData = self.GameConfig.HammerRarities[rData] or targetRarity
			elseif typeof(rData) ~= "table" then
				rData = targetRarity
			end

			local itemFrame = Instance.new("Frame")
			itemFrame.Name = "HammerItem_" .. i
			itemFrame.Size = UDim2.new(0, 190, 0, 199)
			itemFrame.AnchorPoint = Vector2.new(0.5, 0.5)
			local cardCenterX = (i - 1) * CARD_STEP
			itemFrame.Position = UDim2.new(0, cardCenterX, 0.5, 0)
			itemFrame.BackgroundTransparency = 1
			itemFrame.BorderSizePixel = 0
			itemFrame.ZIndex = 34

			local icon = Instance.new("ImageLabel")
			icon.Name = "HammerIcon"
			icon.Size = UDim2.new(0, 140, 0, 140)
			icon.Position = UDim2.new(0.5, 0, 0, 14)
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.BackgroundTransparency = 1
			icon.ScaleType = Enum.ScaleType.Fit
			local assetId = rData.AssetId
			if not assetId or assetId == "" or self.PendingAssets[assetId] then
				assetId = VERIFIED_BASE_HAMMER
			end
			icon.Image = assetId
			icon.ZIndex = 35
			icon.Parent = itemFrame

			local dmgLabel = Instance.new("TextLabel")
			dmgLabel.Name = "DmgLabel"
			dmgLabel.Size = UDim2.new(1, 0, 0, 26)
			dmgLabel.Position = UDim2.new(0.5, 0, 1, -16)
			dmgLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			dmgLabel.BackgroundTransparency = 1
			dmgLabel.Font = Enum.Font.FredokaOne
			dmgLabel.TextSize = 22
			dmgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			dmgLabel.Text = string.format("+%d dmg", rData.DamagePercent or 30)
			dmgLabel.TextXAlignment = Enum.TextXAlignment.Center
			dmgLabel.TextStrokeTransparency = 0.5
			dmgLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			dmgLabel.ZIndex = 36
			dmgLabel.Parent = itemFrame

			itemFrame.Parent = self.ReelTrack
			items[i] = {
				frame = itemFrame,
				icon = icon,
				label = dmgLabel,
				relX = cardCenterX,
			}
		end

		local function updateOpacities(curTrackX)
			for i = 1, TOTAL_CARDS do
				local it = items[i]
				local screenX = curTrackX + it.relX
				local dist = math.abs(screenX - 283)
				if dist >= 270 then
					it.frame.Visible = false
					it.icon.ImageTransparency = 1
					it.label.TextTransparency = 1
				else
					it.frame.Visible = true
					local currentScale = 1.0
					if dist <= 40 then
						it.icon.ImageTransparency = 0
						currentScale = 1.0
					elseif dist <= 190 then
						local t = (dist - 40) / 150
						it.icon.ImageTransparency = t * 0.45
						currentScale = 1.0 - (t * 0.16)
					else
						local t = (dist - 190) / 80
						it.icon.ImageTransparency = math.clamp(0.45 + t * 0.55, 0, 1)
						currentScale = math.clamp(0.84 - (t * 0.16), 0.68, 0.84)
					end

					local iconSize = math.round(140 * currentScale)
					local iconY = math.round(14 + (140 - iconSize) * 0.5)
					it.icon.Size = UDim2.new(0, iconSize, 0, iconSize)
					it.icon.Position = UDim2.new(0.5, 0, 0, iconY)

					if dist <= 25 then
						it.label.TextTransparency = 0
						it.label.Visible = true
					elseif dist <= 55 then
						it.label.TextTransparency = (dist - 25) / 30
						it.label.Visible = true
					else
						it.label.TextTransparency = 1
						it.label.Visible = false
					end
				end
			end
		end

		local targetCardCenter = (WIN_INDEX - 1) * CARD_STEP
		local trackX_final = 283 - targetCardCenter
		local travelDistance = SPIN_TRAVEL_CARDS * CARD_STEP
		local trackX_start = trackX_final - travelDistance
		local trackX_overshoot = trackX_final + 12

		local function kickNeedles()
			if self.TopPointer then
				self.TopPointer.Position = UDim2.new(0.5, 0, 0, -6)
				TweenService:Create(self.TopPointer, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Position = UDim2.new(0.5, 0, 0, -3),
				}):Play()
			end
			if self.BottomPointer then
				self.BottomPointer.Position = UDim2.new(0.5, 0, 1, 6)
				TweenService:Create(self.BottomPointer, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Position = UDim2.new(0.5, 0, 1, 3),
				}):Play()
			end
		end

		self.ReelTrack.Position = UDim2.new(0, math.round(trackX_start), 0, 0)
		updateOpacities(trackX_start)

		-- Stage 1: Fast Spin
		local spinProgress = Instance.new("NumberValue")
		spinProgress.Value = 0

		local lastTickStep = -1
		local progressConn = spinProgress.Changed:Connect(function(val)
			if (isRoundActive and not isRoundActive()) or (getCurrentToken and myToken ~= getCurrentToken()) then return end
			local curX = trackX_start + (trackX_overshoot - trackX_start) * val
			self.ReelTrack.Position = UDim2.new(0, math.round(curX), 0, 0)
			updateOpacities(curX)

			local currentStep = math.floor((curX - trackX_start) / CARD_STEP)
			if currentStep ~= lastTickStep and currentStep >= 0 then
				lastTickStep = currentStep
				kickNeedles()

				pcall(function()
					local tickSound = Instance.new("Sound")
					tickSound.SoundId = "rbxassetid://6895079853"
					local basePitch = 1.55 - (val * 0.70)
					tickSound.PlaybackSpeed = math.clamp(basePitch, 0.85, 1.65)
					-- Increased sound volume by 50%
					tickSound.Volume = (val >= 0.85) and 0.60 or (0.24 + val * 0.21)
					tickSound.Parent = SoundService
					tickSound:Play()
					Debris:AddItem(tickSound, 0.25)

					if val >= 0.85 then
						local thud = Instance.new("Sound")
						thud.SoundId = "rbxasset://sounds/action_jump.mp3"
						thud.PlaybackSpeed = 0.82
						thud.Volume = 0.42 -- Increased by 50% (was 0.28)
						thud.Parent = SoundService
						thud:Play()
						Debris:AddItem(thud, 0.3)
					end
				end)
			end
		end)

		local spinTween1 = TweenService:Create(spinProgress, TweenInfo.new(4.30, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Value = 1,
		})

		spinTween1:Play()
		self.Container.Visible = true

		spinTween1.Completed:Wait()
		progressConn:Disconnect()
		spinProgress:Destroy()

		if (isRoundActive and not isRoundActive()) or (getCurrentToken and myToken ~= getCurrentToken()) then
			self.Container.Visible = false
			self.IsRoulettePlaying = false
			return
		end

		task.wait(0.06)

		-- Stage 2: Recoil Snap
		local recoilProgress = Instance.new("NumberValue")
		recoilProgress.Value = 0
		local recoilConn = recoilProgress.Changed:Connect(function(rVal)
			if (isRoundActive and not isRoundActive()) or (getCurrentToken and myToken ~= getCurrentToken()) then return end
			local rX = trackX_overshoot + (trackX_final - trackX_overshoot) * rVal
			self.ReelTrack.Position = UDim2.new(0, math.round(rX), 0, 0)
			updateOpacities(rX)
		end)

		local recoilTween = TweenService:Create(recoilProgress, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Value = 1,
		})
		recoilTween:Play()
		kickNeedles()

		pcall(function()
			local lockSound = Instance.new("Sound")
			lockSound.SoundId = "rbxassetid://6895079853"
			lockSound.PlaybackSpeed = 1.05
			lockSound.Volume = 0.83 -- Increased by 50% (was 0.55)
			lockSound.Parent = SoundService
			lockSound:Play()
			Debris:AddItem(lockSound, 0.3)
		end)

		recoilTween.Completed:Wait()
		recoilConn:Disconnect()
		recoilProgress:Destroy()

		if (isRoundActive and not isRoundActive()) or (getCurrentToken and myToken ~= getCurrentToken()) then
			self.Container.Visible = false
			self.IsRoulettePlaying = false
			return
		end

		self.ReelTrack.Position = UDim2.new(0, math.round(trackX_final), 0, 0)
		updateOpacities(trackX_final)

		-- Victory Reveal
		local winningItem = items[WIN_INDEX]
		local raySpinConn = nil

		if self.SunburstRays then
			self.SunburstRays.Visible = true
			self.SunburstRays.ImageTransparency = 0.55
			self.SunburstRays.Rotation = 0
			raySpinConn = RunService.RenderStepped:Connect(function(dt)
				self.SunburstRays.Rotation = (self.SunburstRays.Rotation + dt * 60) % 360
			end)
		end

		if winningItem then
			winningItem.icon.Size = UDim2.new(0, 168, 0, 168)
			winningItem.icon.Position = UDim2.new(0.5, 0, 0, 0)
			winningItem.icon.Rotation = -6
			TweenService:Create(winningItem.icon, TweenInfo.new(0.40, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 148, 0, 148),
				Position = UDim2.new(0.5, 0, 0, 10),
				Rotation = 0,
			}):Play()

			winningItem.label.TextSize = 27
			winningItem.label.TextColor3 = Color3.fromRGB(255, 245, 180)
			TweenService:Create(winningItem.label, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				TextSize = 22,
				TextColor3 = Color3.fromRGB(255, 255, 255),
			}):Play()
		end

		local targetGlowColor = targetRarity.GlowColor or targetRarity.Color or Color3.fromRGB(255, 220, 50)
		if csStroke then
			csStroke.Color = targetGlowColor
			csStroke.Thickness = 4.5
			TweenService:Create(csStroke, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Thickness = 2.5,
			}):Play()
		end

		if self.TopPointer and self.BottomPointer then
			self.TopPointer.BackgroundColor3 = targetGlowColor
			self.BottomPointer.BackgroundColor3 = targetGlowColor
		end

		self.ShakeCamera(targetRarity.CameraShake or 1.1, 0.45)
		pcall(function()
			local winSound = Instance.new("Sound")
			winSound.SoundId = "rbxasset://sounds/action_get_up.mp3"
			winSound.PlaybackSpeed = 1.05
			winSound.Volume = 1.28 -- Increased by 50% (was 0.85)
			winSound.Parent = SoundService
			winSound:Play()
			Debris:AddItem(winSound, 1.8)
		end)

		task.wait(2.0)

		if (isRoundActive and not isRoundActive()) or (getCurrentToken and myToken ~= getCurrentToken()) then
			if raySpinConn then raySpinConn:Disconnect() end
			if self.SunburstRays then self.SunburstRays.Visible = false end
			self.Container.Visible = false
			self.IsRoulettePlaying = false
			return
		end

		-- Fade-out
		local fadeTweens = {}
		table.insert(fadeTweens, TweenService:Create(self.RouletteBg, TweenInfo.new(0.35), { ImageTransparency = 1 }))
		if self.RouletteBgFallback then
			table.insert(fadeTweens, TweenService:Create(self.RouletteBgFallback, TweenInfo.new(0.35), { BackgroundTransparency = 1 }))
		end
		if csStroke then
			table.insert(fadeTweens, TweenService:Create(csStroke, TweenInfo.new(0.35), { Transparency = 1 }))
		end
		if self.CenterSlotFrame then
			table.insert(fadeTweens, TweenService:Create(self.CenterSlotFrame, TweenInfo.new(0.35), { BackgroundTransparency = 1 }))
		end
		if self.TopPointer and self.BottomPointer then
			local tpSt = self.TopPointer:FindFirstChildOfClass("UIStroke")
			local bpSt = self.BottomPointer:FindFirstChildOfClass("UIStroke")
			if tpSt then table.insert(fadeTweens, TweenService:Create(tpSt, TweenInfo.new(0.35), { Transparency = 1 })) end
			if bpSt then table.insert(fadeTweens, TweenService:Create(bpSt, TweenInfo.new(0.35), { Transparency = 1 })) end
		end
		if self.SunburstRays then
			table.insert(fadeTweens, TweenService:Create(self.SunburstRays, TweenInfo.new(0.35), { ImageTransparency = 1 }))
		end
		if winningItem then
			table.insert(fadeTweens, TweenService:Create(winningItem.icon, TweenInfo.new(0.35), { ImageTransparency = 1 }))
			table.insert(fadeTweens, TweenService:Create(winningItem.label, TweenInfo.new(0.35), { TextTransparency = 1 }))
		end
		for _, tw in ipairs(fadeTweens) do tw:Play() end
		task.wait(0.35)

		if raySpinConn then raySpinConn:Disconnect() end
		if self.SunburstRays then
			self.SunburstRays.Visible = false
			self.SunburstRays.ImageTransparency = 1
		end
		self.Container.Visible = false
		self.RouletteBg.ImageTransparency = 0
		if self.RouletteBgFallback then
			self.RouletteBgFallback.BackgroundTransparency = 0
		end
		if self.CenterSlotFrame then
			self.CenterSlotFrame.BackgroundTransparency = 1
		end
		if csStroke then
			csStroke.Transparency = 0
			csStroke.Thickness = 2.5
			csStroke.Color = Color3.fromRGB(255, 255, 255)
		end
		if self.TopPointer and self.BottomPointer then
			self.TopPointer.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
			self.BottomPointer.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
			local tpSt = self.TopPointer:FindFirstChildOfClass("UIStroke")
			local bpSt = self.BottomPointer:FindFirstChildOfClass("UIStroke")
			if tpSt then tpSt.Transparency = 0 end
			if bpSt then bpSt.Transparency = 0 end
		end
		self.IsRoulettePlaying = false
	end

	function self:Stop()
		self.Container.Visible = false
		self.IsRoulettePlaying = false
	end

	function self:IsPlaying(): boolean
		return self.IsRoulettePlaying
	end

	function self:SetVisible(visible: boolean)
		self.Container.Visible = visible
		if not visible then
			self.IsRoulettePlaying = false
		end
	end

	return self
end

return HammerRouletteView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">PhaseBannerView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/components/PhaseBannerView.luau
-- Manages the top floating banner, phase name display, round counter, and frame-accurate countdown ticker.

local RunService = game:GetService("RunService")

local PhaseBannerView = {}
PhaseBannerView.__index = PhaseBannerView

export type PhaseBanner = {
	BannerFrame: Frame,
	PhaseTitle: TextLabel,
	TimerLabel: TextLabel,
	InfoLabel: TextLabel,
	RoundLabel: TextLabel,
	CurrentPhase: string,
	CurrentDeadline: number,
	IsActiveInRound: boolean,
	IsAFK: boolean,
	HeartbeatConn: RBXScriptConnection?,
	SetPhase: (self: PhaseBanner, phase: string, round: number, living: number, deadline: number) -> (),
	UpdateParticipation: (self: PhaseBanner, isActive: boolean, isAFK: boolean) -> (),
	SetVisible: (self: PhaseBanner, visible: boolean) -> (),
	Destroy: (self: PhaseBanner) -> (),
}

local function getSimplePhaseName(phase: any): string
	if not phase then return "" end
	if typeof(phase) == "table" then
		phase = phase.Phase or phase.Name or ""
	end
	if typeof(phase) ~= "string" then return "" end

	if phase == "Phase6_Smash" then
		return "Smash"
	elseif phase == "Phase5_Scramble" then
		return "Survival Stance"
	elseif phase == "Phase3_Bid" then
		return "Bidding"
	elseif phase == "Phase4_Reveal" then
		return "Rankings"
	elseif phase == "Phase1_Spawn" then
		return "Hammer Reveal"
	elseif phase == "Phase2_Vote" then
		return "Vote"
	elseif phase == "Phase7_Settlement" then
		return "Settlement"
	elseif phase == "Intermission" then
		return "Lobby"
	elseif phase == "MatchOver" then
		return "Match Over"
	else
		return (string.gsub(phase, "^Phase%d*_*", ""))
	end
end

function PhaseBannerView.new(gui: ScreenGui): PhaseBanner
	local self = setmetatable({}, PhaseBannerView) :: any
	self.CurrentPhase = "Intermission"
	self.CurrentDeadline = 0
	self.IsActiveInRound = false
	self.IsAFK = false

	-- 1. TopBanner Frame
	local topBanner = gui:FindFirstChild("TopBanner") :: Frame?
	if not topBanner then
		topBanner = Instance.new("Frame")
		topBanner.Name = "TopBanner"
		topBanner.AnchorPoint = Vector2.new(0.5, 0)
		topBanner.Position = UDim2.new(0.5, 0, 0, 10)
		topBanner.Size = UDim2.new(0, 440, 0, 56)
		topBanner.BackgroundTransparency = 1
		topBanner.BorderSizePixel = 0
		topBanner.ZIndex = 20
		topBanner.Visible = false
		topBanner.Parent = gui
	else
		topBanner.BackgroundTransparency = 1
		topBanner.BorderSizePixel = 0
		topBanner.AnchorPoint = Vector2.new(0.5, 0)
		topBanner.Position = UDim2.new(0.5, 0, 0, 10)
		topBanner.Size = UDim2.new(0, 440, 0, 56)
		local oldStroke = topBanner:FindFirstChildOfClass("UIStroke")
		if oldStroke then oldStroke:Destroy() end
		local oldCorner = topBanner:FindFirstChildOfClass("UICorner")
		if oldCorner then oldCorner:Destroy() end
	end
	self.BannerFrame = topBanner

	-- 2. PhaseTitle TextLabel
	local phaseTitle = topBanner:FindFirstChild("PhaseTitle") :: TextLabel?
	if not phaseTitle then
		phaseTitle = Instance.new("TextLabel")
		phaseTitle.Name = "PhaseTitle"
		phaseTitle.AnchorPoint = Vector2.new(0.5, 0)
		phaseTitle.Position = UDim2.new(0.5, 0, 0, 0)
		phaseTitle.Size = UDim2.new(1, 0, 0, 26)
		phaseTitle.BackgroundTransparency = 1
		phaseTitle.Font = Enum.Font.GothamBlack
		phaseTitle.TextSize = 22
		phaseTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		phaseTitle.TextXAlignment = Enum.TextXAlignment.Center
		phaseTitle.TextYAlignment = Enum.TextYAlignment.Center
		phaseTitle.ZIndex = 22

		local pStroke = Instance.new("UIStroke")
		pStroke.Color = Color3.fromRGB(0, 0, 0)
		pStroke.Thickness = 2.5
		pStroke.Parent = phaseTitle

		phaseTitle.Parent = topBanner
	else
		phaseTitle.AnchorPoint = Vector2.new(0.5, 0)
		phaseTitle.Position = UDim2.new(0.5, 0, 0, 0)
		phaseTitle.Size = UDim2.new(1, 0, 0, 26)
		phaseTitle.BackgroundTransparency = 1
		phaseTitle.Font = Enum.Font.GothamBlack
		phaseTitle.TextSize = 22
		phaseTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		phaseTitle.TextXAlignment = Enum.TextXAlignment.Center
		phaseTitle.TextYAlignment = Enum.TextYAlignment.Center
	end
	self.PhaseTitle = phaseTitle

	-- 3. RoundLabel TextLabel
	local roundLabel = topBanner:FindFirstChild("RoundLabel") :: TextLabel?
	if not roundLabel then
		roundLabel = Instance.new("TextLabel")
		roundLabel.Name = "RoundLabel"
		roundLabel.AnchorPoint = Vector2.new(0.5, 0)
		roundLabel.Position = UDim2.new(0.5, 0, 0, 27)
		roundLabel.Size = UDim2.new(1, 0, 0, 20)
		roundLabel.BackgroundTransparency = 1
		roundLabel.Font = Enum.Font.GothamBold
		roundLabel.TextSize = 13
		roundLabel.TextColor3 = Color3.fromRGB(210, 225, 245)
		roundLabel.TextXAlignment = Enum.TextXAlignment.Center
		roundLabel.TextYAlignment = Enum.TextYAlignment.Center
		roundLabel.ZIndex = 22

		local rStroke = Instance.new("UIStroke")
		rStroke.Color = Color3.fromRGB(0, 0, 0)
		rStroke.Thickness = 2
		rStroke.Parent = roundLabel

		roundLabel.Parent = topBanner
	else
		roundLabel.AnchorPoint = Vector2.new(0.5, 0)
		roundLabel.Position = UDim2.new(0.5, 0, 0, 27)
		roundLabel.Size = UDim2.new(1, 0, 0, 20)
		roundLabel.BackgroundTransparency = 1
		roundLabel.Font = Enum.Font.GothamBold
		roundLabel.TextSize = 13
		roundLabel.TextColor3 = Color3.fromRGB(210, 225, 245)
		roundLabel.TextXAlignment = Enum.TextXAlignment.Center
		roundLabel.TextYAlignment = Enum.TextYAlignment.Center
	end
	self.RoundLabel = roundLabel

	-- 4. TimerLabel & InfoLabel (kept for backwards compatibility)
	local timerLabel = topBanner:FindFirstChild("TimerLabel") :: TextLabel?
	if not timerLabel then
		timerLabel = Instance.new("TextLabel")
		timerLabel.Name = "TimerLabel"
		timerLabel.Visible = false
		timerLabel.Parent = topBanner
	else
		timerLabel.Visible = false
	end
	self.TimerLabel = timerLabel

	local infoLabel = topBanner:FindFirstChild("InfoLabel") :: TextLabel?
	if not infoLabel then
		infoLabel = Instance.new("TextLabel")
		infoLabel.Name = "InfoLabel"
		infoLabel.Visible = false
		infoLabel.Parent = topBanner
	else
		infoLabel.Visible = false
	end
	self.InfoLabel = infoLabel

	-- Frame-accurate ticker heartbeat
	self.HeartbeatConn = RunService.Heartbeat:Connect(function()
		-- Inactive/lobby players should not see countdowns for ongoing match phases
		if not self.IsActiveInRound and self.CurrentPhase ~= "Intermission" then
			if self.BannerFrame.Visible then
				self.BannerFrame.Visible = false
			end
			if self.PhaseTitle.Text ~= "" then
				self.PhaseTitle.Text = ""
			end
			return
		end

		if self.CurrentDeadline > 0 and (self.IsActiveInRound or (self.CurrentPhase == "Intermission" and not self.IsAFK and self.BannerFrame.Visible)) then
			local remaining = math.max(0, math.ceil(self.CurrentDeadline - os.clock()))
			local simpleName = getSimplePhaseName(self.CurrentPhase)
			self.PhaseTitle.Text = string.format("%s - %ds", simpleName, remaining)
		else
			local simpleName = getSimplePhaseName(self.CurrentPhase)
			if simpleName ~= "" and simpleName ~= "Lobby" and self.IsActiveInRound then
				self.PhaseTitle.Text = string.format("%s - 0s", simpleName)
			else
				self.PhaseTitle.Text = ""
			end
		end
	end)

	function self:SetPhase(phase: string, round: number, living: number, deadline: number)
		self.CurrentPhase = phase
		self.CurrentDeadline = deadline or 0
		if round and living then
			self.RoundLabel.Text = string.format("ROUND %d • %d ALIVE", round, living)
		end
	end

	function self:UpdateParticipation(isActive: boolean, isAFK: boolean)
		self.IsActiveInRound = isActive
		self.IsAFK = isAFK
	end

	function self:SetVisible(visible: boolean)
		self.BannerFrame.Visible = visible
	end

	function self:Destroy()
		if self.HeartbeatConn then
			self.HeartbeatConn:Disconnect()
			self.HeartbeatConn = nil
		end
	end

	return self
end

return PhaseBannerView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">StatusHUDView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/components/StatusHUDView.luau
-- Manages the bottom-left HP, Energy, and Lifetime Cash status stack,
-- and the bottom-right Wallet balance card with smooth tweens and payout toasts.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local StatusHUDView = {}
StatusHUDView.__index = StatusHUDView

export type StatusHUD = {
	ScreenGui: ScreenGui,
	StatusStack: Frame,
	HpBg: Frame,
	HpFill: Frame,
	HpLabel: TextLabel,
	EnergyFill: Frame,
	EnergyLabel: TextLabel,
	LifetimeCashLabel: TextLabel,
	PayoutToast: TextLabel,
	WalletCard: Frame,
	WalletValLabel: TextLabel,
	WalletScale: UIScale,
	DisplayedOverallCash: number,
	CountUpThread: thread?,
	LastWalletVal: number,
	UpdateHealth: (self: StatusHUD, current: number, max: number) -> (),
	UpdateEnergy: (self: StatusHUD, current: number, max: number) -> (),
	UpdateCurrencyUI: (self: StatusHUD, isInGame: boolean, overallCash: number, matchWallet: number) -> (),
	RollOverallCash: (self: StatusHUD, targetCash: number) -> (),
	PunchWallet: (self: StatusHUD) -> (),
	HandlePayout: (self: StatusHUD, earnedCash: number, secondsSurvived: number, newOverall: number) -> (),
	SetInGame: (self: StatusHUD, isInGame: boolean) -> (),
	SetVisible: (self: StatusHUD, visible: boolean) -> (),
}

function StatusHUDView.new(player: Player?): StatusHUD
	local self = setmetatable({}, StatusHUDView) :: any
	local localPlayer = player or Players.LocalPlayer
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local existing = playerGui:FindFirstChild("BidToSurviveStatusHUD")
	if existing then existing:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BidToSurviveStatusHUD"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui
	self.ScreenGui = screenGui

	-- Bottom-Left Status Stack
	local statusStack = Instance.new("Frame")
	statusStack.Name = "BottomLeftStatusStack"
	statusStack.AnchorPoint = Vector2.new(0, 1)
	statusStack.Position = UDim2.new(0, 24, 1, -34)
	statusStack.Size = UDim2.new(0, 315, 0, 96)
	statusStack.BackgroundTransparency = 1
	statusStack.Parent = screenGui
	self.StatusStack = statusStack

	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 5)
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	listLayout.Parent = statusStack

	local function createComicBar(order: number, name: string, tagText: string, fillColor: Color3, underlayColor: Color3)
		local bg = Instance.new("Frame")
		bg.Name = name .. "Frame"
		bg.LayoutOrder = order
		bg.Size = UDim2.new(1, 0, 0, 34)
		bg.BackgroundColor3 = underlayColor
		bg.BorderSizePixel = 0
		bg.Parent = statusStack

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = bg

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(0, 0, 0)
		stroke.Thickness = 2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = bg

		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.BackgroundColor3 = fillColor
		fill.BorderSizePixel = 0
		fill.Parent = bg

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(0, 4)
		fillCorner.Parent = fill

		local tagLabel = Instance.new("TextLabel")
		tagLabel.Name = "TagLabel"
		tagLabel.Size = UDim2.new(0, 36, 1, 0)
		tagLabel.Position = UDim2.new(0, 10, 0.5, 0)
		tagLabel.AnchorPoint = Vector2.new(0, 0.5)
		tagLabel.BackgroundTransparency = 1
		tagLabel.Font = Enum.Font.GothamBlack
		tagLabel.TextSize = 14
		tagLabel.TextXAlignment = Enum.TextXAlignment.Left
		tagLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		tagLabel.Text = tagText
		tagLabel.ZIndex = 3
		tagLabel.Parent = bg

		local tagStroke = Instance.new("UIStroke")
		tagStroke.Thickness = 2
		tagStroke.Color = Color3.fromRGB(0, 0, 0)
		tagStroke.Parent = tagLabel

		local valLabel = Instance.new("TextLabel")
		valLabel.Name = "ValueLabel"
		valLabel.Size = UDim2.new(0, 56, 1, 0)
		valLabel.Position = UDim2.new(1, -10, 0.5, 0)
		valLabel.AnchorPoint = Vector2.new(1, 0.5)
		valLabel.BackgroundTransparency = 1
		valLabel.Font = Enum.Font.GothamBlack
		valLabel.TextSize = 14
		valLabel.TextXAlignment = Enum.TextXAlignment.Right
		valLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		valLabel.Text = "100"
		valLabel.ZIndex = 3
		valLabel.Parent = bg

		local valStroke = Instance.new("UIStroke")
		valStroke.Thickness = 2
		valStroke.Color = Color3.fromRGB(0, 0, 0)
		valStroke.Parent = valLabel

		return bg, fill, valLabel
	end

	local hpBg, hpFill, hpLabel = createComicBar(2, "HP", "HP", Color3.fromRGB(255, 0, 0), Color3.fromRGB(60, 10, 15))
	hpBg.Visible = false
	self.HpBg = hpBg
	self.HpFill = hpFill
	self.HpLabel = hpLabel

	local _, energyFill, energyLabel = createComicBar(3, "Energy", "EP", Color3.fromRGB(0, 255, 242), Color3.fromRGB(10, 45, 50))
	self.EnergyFill = energyFill
	self.EnergyLabel = energyLabel

	-- Lifetime Cash Frame
	local moneyFrame = Instance.new("Frame")
	moneyFrame.Name = "LifetimeCashFrame"
	moneyFrame.LayoutOrder = 1
	moneyFrame.Size = UDim2.new(1, 0, 0, 42)
	moneyFrame.BackgroundTransparency = 1
	moneyFrame.Parent = statusStack

	local lifetimeCashLabel = Instance.new("TextLabel")
	lifetimeCashLabel.Name = "LifetimeCashLabel"
	lifetimeCashLabel.Size = UDim2.new(1, 0, 1, 0)
	lifetimeCashLabel.Position = UDim2.new(0, 0, 0.5, 0)
	lifetimeCashLabel.AnchorPoint = Vector2.new(0, 0.5)
	lifetimeCashLabel.BackgroundTransparency = 1
	lifetimeCashLabel.Font = Enum.Font.GothamBlack
	lifetimeCashLabel.TextSize = 36
	lifetimeCashLabel.TextXAlignment = Enum.TextXAlignment.Left
	lifetimeCashLabel.TextColor3 = Color3.fromRGB(0, 230, 0)
	lifetimeCashLabel.Text = "+0 $"
	lifetimeCashLabel.ZIndex = 3
	lifetimeCashLabel.Parent = moneyFrame
	self.LifetimeCashLabel = lifetimeCashLabel

	local moneyStroke = Instance.new("UIStroke")
	moneyStroke.Thickness = 3
	moneyStroke.Color = Color3.fromRGB(0, 0, 0)
	moneyStroke.Parent = lifetimeCashLabel

	-- Floating Payout Toast
	local payoutToast = Instance.new("TextLabel")
	payoutToast.Name = "PayoutToast"
	payoutToast.Size = UDim2.new(1, 40, 0, 24)
	payoutToast.Position = UDim2.new(0, 0, 0, -26)
	payoutToast.BackgroundTransparency = 1
	payoutToast.Font = Enum.Font.GothamBlack
	payoutToast.TextSize = 15
	payoutToast.TextXAlignment = Enum.TextXAlignment.Left
	payoutToast.TextColor3 = Color3.fromRGB(52, 211, 153)
	payoutToast.TextStrokeTransparency = 0.2
	payoutToast.TextTransparency = 1
	payoutToast.Text = ""
	payoutToast.Parent = moneyFrame
	self.PayoutToast = payoutToast

	-- Bottom-Right Wallet Card
	local walletCard = Instance.new("Frame")
	walletCard.Name = "BottomRightWalletCard"
	walletCard.AnchorPoint = Vector2.new(1, 1)
	walletCard.Position = UDim2.new(1, -24, 1, -34)
	walletCard.Size = UDim2.new(0, 240, 0, 56)
	walletCard.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	walletCard.BorderSizePixel = 0
	walletCard.Parent = screenGui
	self.WalletCard = walletCard

	local walletCorner = Instance.new("UICorner")
	walletCorner.CornerRadius = UDim.new(0, 4)
	walletCorner.Parent = walletCard

	local walletStroke = Instance.new("UIStroke")
	walletStroke.Thickness = 3
	walletStroke.Color = Color3.fromRGB(0, 0, 0)
	walletStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	walletStroke.Parent = walletCard

	local walletBadge = Instance.new("Frame")
	walletBadge.Name = "WalletBadge"
	walletBadge.Size = UDim2.new(0, 76, 0, 32)
	walletBadge.Position = UDim2.new(0, 10, 0.5, 0)
	walletBadge.AnchorPoint = Vector2.new(0, 0.5)
	walletBadge.BackgroundColor3 = Color3.fromRGB(255, 185, 0)
	walletBadge.BorderSizePixel = 0
	walletBadge.Parent = walletCard

	local wbCorner = Instance.new("UICorner")
	wbCorner.CornerRadius = UDim.new(0, 4)
	wbCorner.Parent = walletBadge

	local wbStroke = Instance.new("UIStroke")
	wbStroke.Thickness = 2
	wbStroke.Color = Color3.fromRGB(0, 0, 0)
	wbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	wbStroke.Parent = walletBadge

	local wbText = Instance.new("TextLabel")
	wbText.Name = "BadgeText"
	wbText.Size = UDim2.new(1, 0, 1, 0)
	wbText.BackgroundTransparency = 1
	wbText.Font = Enum.Font.GothamBlack
	wbText.TextSize = 15
	wbText.TextColor3 = Color3.fromRGB(0, 0, 0)
	wbText.Text = "WALLET"
	wbText.Parent = walletBadge

	local walletValLabel = Instance.new("TextLabel")
	walletValLabel.Name = "WalletValueLabel"
	walletValLabel.Size = UDim2.new(1, -96, 1, 0)
	walletValLabel.Position = UDim2.new(1, -12, 0.5, 0)
	walletValLabel.AnchorPoint = Vector2.new(1, 0.5)
	walletValLabel.BackgroundTransparency = 1
	walletValLabel.Font = Enum.Font.GothamBlack
	walletValLabel.TextSize = 36
	walletValLabel.TextXAlignment = Enum.TextXAlignment.Right
	walletValLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	walletValLabel.Text = "$20.00"
	walletValLabel.ZIndex = 3
	walletValLabel.Parent = walletCard
	self.WalletValLabel = walletValLabel

	local walletValStroke = Instance.new("UIStroke")
	walletValStroke.Thickness = 3
	walletValStroke.Color = Color3.fromRGB(0, 0, 0)
	walletValStroke.Parent = walletValLabel

	local walletScale = Instance.new("UIScale")
	walletScale.Scale = 1.0
	walletScale.Parent = walletCard
	self.WalletScale = walletScale

	self.DisplayedOverallCash = 0
	self.CountUpThread = nil
	self.LastWalletVal = 20

	function self:UpdateHealth(health: number, maxHealth: number)
		local safeMax = (maxHealth > 0) and maxHealth or 100
		local ratio = math.clamp(health / safeMax, 0, 1)
		self.HpLabel.Text = string.format("%d", math.ceil(health))
		TweenService:Create(self.HpFill, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(ratio, 0, 1, 0),
		}):Play()
	end

	function self:UpdateEnergy(currentEnergy: number, maxEnergy: number)
		local safeMax = (maxEnergy > 0) and maxEnergy or 100
		local ratio = math.clamp(currentEnergy / safeMax, 0, 1)
		self.EnergyLabel.Text = string.format("%d", math.ceil(currentEnergy))
		self.EnergyFill.Size = UDim2.new(ratio, 0, 1, 0)
	end

	function self:PunchWallet()
		self.WalletScale.Scale = 1.10
		TweenService:Create(self.WalletScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1.0,
		}):Play()
	end

	function self:RollOverallCash(targetCash: number)
		if self.CountUpThread then
			task.cancel(self.CountUpThread)
			self.CountUpThread = nil
		end

		local startVal = self.DisplayedOverallCash
		local diff = targetCash - startVal
		if math.abs(diff) <= 0.01 then
			self.DisplayedOverallCash = targetCash
			self.LifetimeCashLabel.Text = string.format("+%d $", math.floor(targetCash))
			return
		end

		self.CountUpThread = task.spawn(function()
			local duration = 1.0
			local startTime = os.clock()
			while true do
				local elapsed = os.clock() - startTime
				local progress = math.clamp(elapsed / duration, 0, 1)
				local alpha = TweenService:GetValue(progress, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				local cur = math.floor(startVal + (diff * alpha))
				self.DisplayedOverallCash = cur
				self.LifetimeCashLabel.Text = string.format("+%d $", cur)
				if progress >= 1 then break end
				task.wait(0.03)
			end
			self.DisplayedOverallCash = targetCash
			self.LifetimeCashLabel.Text = string.format("+%d $", math.floor(targetCash))
			self.CountUpThread = nil
		end)
	end

	function self:SetInGame(isInGame: boolean)
		self.HpBg.Visible = isInGame
		self.StatusStack.Size = isInGame and UDim2.new(0, 315, 0, 134) or UDim2.new(0, 315, 0, 82)
	end

	function self:UpdateCurrencyUI(isInGame: boolean, overallCash: number, matchWallet: number)
		self:SetInGame(isInGame)

		if self.CountUpThread == nil then
			self.DisplayedOverallCash = overallCash
			self.LifetimeCashLabel.Text = string.format("+%d $", math.floor(overallCash))
		end

		if matchWallet ~= self.LastWalletVal then
			if matchWallet < self.LastWalletVal then
				self:PunchWallet()
			end
			self.LastWalletVal = matchWallet
		end
		self.WalletValLabel.Text = string.format("$%.2f", matchWallet)
	end

	function self:HandlePayout(earnedCash: number, secondsSurvived: number, newOverall: number)
		self:RollOverallCash(newOverall)

		self.PayoutToast.Text = string.format("+$%d (%ds Survived × $20)", earnedCash, secondsSurvived)
		self.PayoutToast.Position = UDim2.new(0, 0, 0, -18)
		self.PayoutToast.TextTransparency = 0

		TweenService:Create(self.PayoutToast, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 0, 0, -32),
		}):Play()

		task.delay(4.0, function()
			TweenService:Create(self.PayoutToast, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				TextTransparency = 1,
			}):Play()
		end)
	end

	function self:SetVisible(visible: boolean)
		self.ScreenGui.Enabled = visible
	end

	return self
end

return StatusHUDView
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">effects</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ScreenEffectsView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/effects/ScreenEffectsView.luau
-- Manages fullscreen flashes (damage/phase transition) and camera shake spring oscillations.

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ScreenEffectsView = {}
ScreenEffectsView.__index = ScreenEffectsView

export type ScreenEffects = {
	FlashFrame: Frame,
	ActiveFlashTween: Tween?,
	ShakeConn: RBXScriptConnection?,
	LastRecordedHealth: number,
	Flash: (self: ScreenEffects, color: Color3?, transparency: number?, duration: number?) -> (),
	ShakeCamera: (self: ScreenEffects, intensity: number, duration: number, isRoundActive: (() -> boolean)?) -> (),
	StopShake: (self: ScreenEffects) -> (),
	BindCharacterHealth: (self: ScreenEffects, char: Model, isRoundActive: () -> boolean) -> (),
}

function ScreenEffectsView.new(gui: ScreenGui): ScreenEffects
	local self = setmetatable({}, ScreenEffectsView) :: any
	self.LastRecordedHealth = 100

	-- ScreenFlash Frame
	local screenFlash = gui:FindFirstChild("ScreenFlash") :: Frame?
	if not screenFlash then
		screenFlash = Instance.new("Frame")
		screenFlash.Name = "ScreenFlash"
		screenFlash.Size = UDim2.fromScale(1, 1)
		screenFlash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		screenFlash.BackgroundTransparency = 1
		screenFlash.Visible = false
		screenFlash.Active = false
		screenFlash.ZIndex = 25
		screenFlash.Parent = gui
	else
		screenFlash.Visible = false
		screenFlash.Active = false
		screenFlash.ZIndex = 25
	end
	self.FlashFrame = screenFlash

	function self:Flash(color: Color3?, transparency: number?, duration: number?)
		if self.ActiveFlashTween then
			self.ActiveFlashTween:Cancel()
			self.ActiveFlashTween = nil
		end
		self.FlashFrame.Visible = true
		self.FlashFrame.BackgroundColor3 = color or Color3.fromRGB(220, 20, 20)
		self.FlashFrame.BackgroundTransparency = transparency or 0.65

		self.ActiveFlashTween = TweenService:Create(self.FlashFrame, TweenInfo.new(duration or 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1,
		})
		self.ActiveFlashTween:Play()
		self.ActiveFlashTween.Completed:Once(function()
			if self.FlashFrame.BackgroundTransparency >= 0.99 then
				self.FlashFrame.Visible = false
			end
		end)
	end

	function self:StopShake()
		if self.ShakeConn then
			self.ShakeConn:Disconnect()
			self.ShakeConn = nil
		end
	end

	function self:ShakeCamera(intensity: number, duration: number, isRoundActive: (() -> boolean)?)
		self:StopShake()
		local cam = Workspace.CurrentCamera
		if not cam then return end

		local startTime = os.clock()
		self.ShakeConn = RunService.RenderStepped:Connect(function()
			local elapsed = os.clock() - startTime
			if elapsed > duration or (isRoundActive and not isRoundActive()) then
				self:StopShake()
				return
			end
			local factor = (1 - (elapsed / duration)) * intensity
			local shakeX = (math.random() - 0.5) * factor * 0.8
			local shakeY = (math.random() - 0.5) * factor * 0.8
			local shakeZ = (math.random() - 0.5) * factor * 0.4
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(shakeX), math.rad(shakeY), math.rad(shakeZ))
		end)
	end

	function self:BindCharacterHealth(char: Model, isRoundActive: () -> boolean)
		local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
		if not hum then return end
		self.LastRecordedHealth = hum.Health

		hum.HealthChanged:Connect(function(newHealth)
			if newHealth < self.LastRecordedHealth and newHealth > 0 and isRoundActive() then
				self:Flash(Color3.fromRGB(220, 20, 20), 0.65, 0.24)
			end
			self.LastRecordedHealth = newHealth
		end)
	end

	return self
end

return ScreenEffectsView
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">modals</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BiddingModalView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/modals/BiddingModalView.luau
-- Manages the Bidding modal, numeric input sanitization, percentage quick-bid buttons, and bid submission.

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local BiddingModalView = {}
BiddingModalView.__index = BiddingModalView

export type BiddingModal = {
	ModalFrame: Frame,
	CardFrame: Frame,
	BidInput: TextBox,
	SubmitBtn: TextButton,
	SubmittedNotice: TextLabel,
	CloseBidBtn: TextButton,
	HasSubmitted: boolean,
	SubmittedAmount: number?,
	CurrentWallet: number,
	Open: (self: BiddingModal, currentWallet: number) -> (),
	Close: (self: BiddingModal) -> (),
	Reset: (self: BiddingModal) -> (),
	IsVisible: (self: BiddingModal) -> boolean,
	SetVisible: (self: BiddingModal, visible: boolean) -> (),
}

local function applySVG3ButtonStyle(button: TextButton, labelText: string, textSize: number?)
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	button.BackgroundTransparency = 0
	button.BorderSizePixel = 0
	button.Text = ""

	local corner = button:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 1)
	corner.Parent = button

	local stroke = button:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Miter
	stroke.Parent = button

	local gradient = button:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromHex("#EC0000")),
		ColorSequenceKeypoint.new(0.54, Color3.fromHex("#F50505")),
		ColorSequenceKeypoint.new(0.78, Color3.fromHex("#E25A5A")),
		ColorSequenceKeypoint.new(1.00, Color3.fromHex("#D6C7C7")),
	})
	gradient.Enabled = true
	gradient.Parent = button

	local label = button:FindFirstChild("BtnLabel") :: TextLabel?
	if not label then
		label = Instance.new("TextLabel")
		label.Name = "BtnLabel"
		label.Size = UDim2.fromScale(1, 1)
		label.Position = UDim2.fromScale(0, 0)
		label.BackgroundTransparency = 1
		label.ZIndex = button.ZIndex + 3
		label.Parent = button
	end
	label.Text = labelText
	label.Font = Enum.Font.GothamMedium
	label.TextSize = textSize or 24
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
end

function BiddingModalView.new(gui: ScreenGui, bidSubmittedRemote: RemoteEvent?, onVisibilityChanged: (() -> ())?): BiddingModal
	local self = setmetatable({}, BiddingModalView) :: any
	self.HasSubmitted = false
	self.SubmittedAmount = nil :: number?
	self.CurrentWallet = 20.00

	-- BiddingModal Frame
	local biddingModal = (gui:WaitForChild("BiddingModal", 5) or gui:FindFirstChild("BiddingModal")) :: Frame?
	if not biddingModal then
		biddingModal = Instance.new("Frame")
		biddingModal.Name = "BiddingModal"
		biddingModal.AnchorPoint = Vector2.new(0.5, 0.5)
		biddingModal.Position = UDim2.new(0.5, 0, 0.5, 0)
		biddingModal.Size = UDim2.new(0, 480, 0, 250)
		biddingModal.BackgroundTransparency = 1
		biddingModal.Visible = false
		biddingModal.Parent = gui
	end
	self.ModalFrame = biddingModal

	local cardFrame = (biddingModal:WaitForChild("CardFrame", 3) or biddingModal:FindFirstChild("CardFrame") or biddingModal) :: Frame
	self.CardFrame = cardFrame

	-- Close Button
	local closeBidBtn = (cardFrame:FindFirstChild("CloseBidBtn", true) or biddingModal:FindFirstChild("CloseBidBtn")) :: TextButton?
	if not closeBidBtn then
		closeBidBtn = Instance.new("TextButton")
		closeBidBtn.Name = "CloseBidBtn"
		closeBidBtn.Size = UDim2.new(0, 32, 0, 30)
		closeBidBtn.Position = UDim2.new(1, -14, 0, 12)
		closeBidBtn.AnchorPoint = Vector2.new(1, 0)
		closeBidBtn.BackgroundColor3 = Color3.fromRGB(245, 0, 0)
		closeBidBtn.Text = "X"
		closeBidBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		closeBidBtn.Font = Enum.Font.GothamBlack
		closeBidBtn.TextSize = 18
		closeBidBtn.ZIndex = 26

		local cbbCorner = Instance.new("UICorner")
		cbbCorner.CornerRadius = UDim.new(0, 6)
		cbbCorner.Parent = closeBidBtn

		local cbbStroke = Instance.new("UIStroke")
		cbbStroke.Thickness = 2
		cbbStroke.Color = Color3.fromRGB(0, 0, 0)
		cbbStroke.Parent = closeBidBtn

		closeBidBtn.Parent = cardFrame
	end
	self.CloseBidBtn = closeBidBtn

	closeBidBtn.MouseButton1Click:Connect(function()
		self:Close()
		if onVisibilityChanged then onVisibilityChanged() end
	end)

	-- Bid Input TextBox
	local bidInput = (cardFrame:WaitForChild("BidInput", 3) or cardFrame:FindFirstChild("BidInput", true)) :: TextBox
	self.BidInput = bidInput
	bidInput.TextSize = 30
	bidInput.Font = Enum.Font.RobotoMono

	self.IsOpening = false

	local function unlockBidSubmit()
		if self.IsOpening then return end
		if self.HasSubmitted then
			self.HasSubmitted = false
			applySVG3ButtonStyle(self.SubmitBtn, "BID", 24)
			if self.SubmittedNotice and self.SubmittedAmount ~= nil then
				self.SubmittedNotice.Text = string.format("Last Submitted: $%.2f (Press BID to update)", self.SubmittedAmount)
				self.SubmittedNotice.TextColor3 = Color3.fromRGB(255, 230, 130)
			end
		end
	end

	-- Strict numeric and decimal filtering
	bidInput:GetPropertyChangedSignal("Text"):Connect(function()
		local text = bidInput.Text
		local filtered = ""
		local hasDot = false
		for i = 1, #text do
			local c = text:sub(i, i)
			if c:match("%d") then
				filtered = filtered .. c
			elseif c == "." and not hasDot then
				filtered = filtered .. c
				hasDot = true
			end
		end
		if text ~= filtered then
			bidInput.Text = filtered
		end

		-- If user changes/retypes bid value, restore BID button to allow re-submitting!
		if not self.IsOpening then
			unlockBidSubmit()
		end
	end)

	bidInput.Focused:Connect(function()
		unlockBidSubmit()
	end)

	bidInput.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			handleSubmitBid()
		end
	end)

	-- Submit Button
	local submitBtn = (cardFrame:FindFirstChild("SubmitBtn", true) or cardFrame:FindFirstChild("SubmitBtn")) :: TextButton
	self.SubmitBtn = submitBtn
	applySVG3ButtonStyle(submitBtn, "BID", 24)

	local submittedNotice = (cardFrame:FindFirstChild("SubmittedNotice", true) or cardFrame:FindFirstChild("SubmittedNotice")) :: TextLabel?
	if not submittedNotice then
		submittedNotice = Instance.new("TextLabel")
		submittedNotice.Name = "SubmittedNotice"
		submittedNotice.AnchorPoint = Vector2.new(0.5, 0)
		submittedNotice.Position = UDim2.new(0.5, 0, 0, 192)
		submittedNotice.Size = UDim2.new(0.85, 0, 0, 20)
		submittedNotice.BackgroundTransparency = 1
		submittedNotice.Font = Enum.Font.GothamBold
		submittedNotice.TextSize = 13
		submittedNotice.TextColor3 = Color3.fromRGB(160, 255, 160)
		submittedNotice.Text = ""
		submittedNotice.ZIndex = 25
		submittedNotice.Parent = cardFrame
	end
	self.SubmittedNotice = submittedNotice

	-- Quick fraction buttons
	local quickFrame = (biddingModal:FindFirstChild("QuickFrame") or cardFrame:FindFirstChild("QuickFrame")) :: Frame?
	if quickFrame then
		local function setBidFraction(frac: number)
			local amtCents = math.round((self.CurrentWallet * frac) * 100)
			local amt = amtCents / 100
			bidInput.Text = string.format("%.2f", amt)
			unlockBidSubmit()
		end

		for _, btn in ipairs(quickFrame:GetChildren()) do
			if btn:IsA("TextButton") then
				btn.MouseButton1Click:Connect(function()
					if btn.Text == "25%" then setBidFraction(0.25)
					elseif btn.Text == "50%" then setBidFraction(0.50)
					elseif btn.Text == "75%" then setBidFraction(0.75)
					elseif btn.Text == "MAX" then setBidFraction(1.00)
					elseif btn.Text == "CLEAR" then
						bidInput.Text = "0.00"
						unlockBidSubmit()
					end
				end)
			end
		end
	end

	-- Submit Click Handler
	local function handleSubmitBid()
		if self.HasSubmitted then return end

		local cleanStr = bidInput.Text:gsub("[^%d%.]", "")
		local rawVal = tonumber(cleanStr) or 0
		local walletCents = math.round(self.CurrentWallet * 100)
		local valCents = math.clamp(math.round(rawVal * 100), 0, walletCents)
		local val = valCents / 100

		self.HasSubmitted = true
		self.SubmittedAmount = val
		if bidSubmittedRemote then
			bidSubmittedRemote:FireServer(val)
		end

		submitBtn.Text = ""
		local submitGrad = submitBtn:FindFirstChildOfClass("UIGradient")
		if submitGrad then submitGrad.Enabled = false end
		submitBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		local submitLabel = submitBtn:FindFirstChild("BtnLabel") :: TextLabel?
		if submitLabel then
			submitLabel.Text = "SUBMITTED!"
			submitLabel.TextColor3 = Color3.fromRGB(160, 255, 160)
		end
		submittedNotice.Text = string.format("Secret Bid Registered: $%.2f", val)

		pcall(function()
			local clickSound = Instance.new("Sound")
			clickSound.SoundId = "rbxasset://sounds/action_jump.mp3"
			clickSound.Volume = 0.5
			clickSound.Parent = SoundService
			clickSound:Play()
			Debris:AddItem(clickSound, 1)
		end)
	end

	submitBtn.MouseButton1Click:Connect(handleSubmitBid)
	submitBtn.Activated:Connect(handleSubmitBid)

	function self:Open(currentWallet: number)
		self.CurrentWallet = currentWallet or 20.00
		self.IsOpening = true

		if self.HasSubmitted and self.SubmittedAmount ~= nil then
			-- Retain submitted amount and notice until the bidding round completes
			self.BidInput.Text = string.format("%.2f", self.SubmittedAmount)
			self.SubmittedNotice.Text = string.format("Secret Bid Registered: $%.2f", self.SubmittedAmount)
			self.SubmittedNotice.TextColor3 = Color3.fromRGB(160, 255, 160)

			self.SubmitBtn.Text = ""
			local submitGrad = self.SubmitBtn:FindFirstChildOfClass("UIGradient")
			if submitGrad then submitGrad.Enabled = false end
			self.SubmitBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			local submitLabel = self.SubmitBtn:FindFirstChild("BtnLabel") :: TextLabel?
			if submitLabel then
				submitLabel.Text = "SUBMITTED!"
				submitLabel.TextColor3 = Color3.fromRGB(160, 255, 160)
			end
		else
			self.BidInput.Text = ""
			self.SubmittedNotice.Text = ""
			applySVG3ButtonStyle(self.SubmitBtn, "BID", 24)
		end
		self.IsOpening = false

		self.ModalFrame.Visible = true
		self.ModalFrame.Size = UDim2.new(0, 430, 0, 220)
		TweenService:Create(self.ModalFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 480, 0, 250),
		}):Play()

		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:Close()
		self.ModalFrame.Visible = false
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:Reset()
		self.HasSubmitted = false
		self.SubmittedAmount = nil
		self.BidInput.Text = ""
		self.SubmittedNotice.Text = ""
		applySVG3ButtonStyle(self.SubmitBtn, "BID", 24)
		self.ModalFrame.Visible = false
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:IsVisible(): boolean
		return self.ModalFrame.Visible
	end

	function self:SetVisible(visible: boolean)
		self.ModalFrame.Visible = visible
		if onVisibilityChanged then onVisibilityChanged() end
	end

	return self
end

return BiddingModalView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MatchOverModalView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/modals/MatchOverModalView.luau
-- Manages the Match Over / Results podium modal (1st, 2nd, 3rd places),
-- avatar headshots, survival time pills, responsive scaling, and victory animations.

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local RESULTS_BG_ASSET = "rbxassetid://136247699248783"

local MatchOverModalView = {}
MatchOverModalView.__index = MatchOverModalView

export type MatchOverModal = {
	ModalFrame: Frame,
	CardFrame: Frame,
	PodiumContainer: Frame,
	CloseResultsBtn: TextButton,
	Show: (self: MatchOverModal, data: any, localPlayer: Player) -> (),
	Hide: (self: MatchOverModal) -> (),
	IsVisible: (self: MatchOverModal) -> boolean,
	SetVisible: (self: MatchOverModal, visible: boolean) -> (),
}

local function formatSurvivalTime(seconds: number?): string
	local totalSecs = math.max(0, math.floor(seconds or 83))
	local m = math.floor(totalSecs / 60)
	local s = totalSecs % 60
	return string.format("Time:- %dm %02d sec", m, s)
end

local function formatPodiumName(name: string?): string
	local str = tostring(name or "Player")
	if string.sub(str, 1, 1) == "@" then
		return str
	end
	return "@" .. str
end

local function getAvatarHeadshot(userId: number?): string
	local id = tonumber(userId)
	if id and id > 0 then
		return string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", id)
	end
	return "rbxthumb://type=AvatarHeadShot&id=1&w=150&h=150"
end

local function createPodiumColumn(parent: Frame, rank: number, data: any, config: any, localPlayer: Player)
	local col = Instance.new("Frame")
	col.Name = "Col_" .. rank
	col.Size = UDim2.new(0, 122, 1, 0)
	col.Position = config.colPosition
	col.AnchorPoint = config.colAnchor
	col.BackgroundTransparency = 1
	col.BorderSizePixel = 0
	col.ZIndex = 46

	local isMe = localPlayer and ((data.UserId == localPlayer.UserId) or (data.Name == localPlayer.Name) or (data.DisplayName == localPlayer.DisplayName))

	-- 1. Profile Box
	local profileBox = Instance.new("Frame")
	profileBox.Name = "ProfileBox"
	profileBox.Size = UDim2.new(0, 122, 0, 111)
	profileBox.Position = UDim2.new(0.5, 0, 0, config.boxY)
	profileBox.AnchorPoint = Vector2.new(0.5, 0)
	profileBox.BackgroundColor3 = Color3.fromRGB(217, 217, 217)
	profileBox.BorderSizePixel = 0
	profileBox.ZIndex = 46

	local pbCorner = Instance.new("UICorner")
	pbCorner.CornerRadius = UDim.new(0, 4)
	pbCorner.Parent = profileBox

	local pbStroke = Instance.new("UIStroke")
	if isMe then
		pbStroke.Color = Color3.fromRGB(255, 215, 0)
		pbStroke.Thickness = 3.5
	else
		pbStroke.Color = Color3.fromRGB(0, 0, 0)
		pbStroke.Thickness = 2.5
	end
	pbStroke.Parent = profileBox

	local avatarImg = Instance.new("ImageLabel")
	avatarImg.Name = "AvatarImg"
	avatarImg.Size = UDim2.new(1, -4, 1, -4)
	avatarImg.Position = UDim2.new(0.5, 0, 0.5, 0)
	avatarImg.AnchorPoint = Vector2.new(0.5, 0.5)
	avatarImg.BackgroundTransparency = 1
	avatarImg.Image = getAvatarHeadshot(data.UserId)
	avatarImg.ScaleType = Enum.ScaleType.Fit
	avatarImg.ZIndex = 47

	local avCorner = Instance.new("UICorner")
	avCorner.CornerRadius = UDim.new(0, 3)
	avCorner.Parent = avatarImg
	avatarImg.Parent = profileBox
	profileBox.Parent = col

	-- 2. Username Pill
	local userPill = Instance.new("Frame")
	userPill.Name = "UserPill"
	userPill.Size = UDim2.new(0, 110, 0, 24)
	userPill.Position = UDim2.new(0.5, 0, 0, config.pill1Y)
	userPill.AnchorPoint = Vector2.new(0.5, 0)
	userPill.BackgroundColor3 = Color3.fromRGB(33, 33, 33)
	userPill.BorderSizePixel = 0
	userPill.ZIndex = 47

	local upCorner = Instance.new("UICorner")
	upCorner.CornerRadius = UDim.new(0, 12)
	upCorner.Parent = userPill

	local upStroke = Instance.new("UIStroke")
	upStroke.Color = isMe and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(255, 255, 255)
	upStroke.Thickness = isMe and 2 or 1.5
	upStroke.Parent = userPill

	local userLabel = Instance.new("TextLabel")
	userLabel.Size = UDim2.new(1, -10, 1, 0)
	userLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	userLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	userLabel.BackgroundTransparency = 1
	local podiumDispName = (isMe and localPlayer.DisplayName) or data.DisplayName
	if (not podiumDispName or podiumDispName == data.Name) and data.UserId and data.UserId > 0 then
		local pObj = Players:GetPlayerByUserId(data.UserId)
		if pObj then podiumDispName = pObj.DisplayName end
	end
	userLabel.Text = formatPodiumName(podiumDispName or data.Name or "Player")
	userLabel.Font = Enum.Font.GothamBold
	userLabel.TextSize = 11
	userLabel.TextScaled = true
	userLabel.TextColor3 = isMe and Color3.fromRGB(255, 235, 120) or Color3.fromRGB(255, 255, 255)
	userLabel.TextTruncate = Enum.TextTruncate.AtEnd
	userLabel.TextXAlignment = Enum.TextXAlignment.Center
	userLabel.ZIndex = 48

	local userSizeConstraint = Instance.new("UITextSizeConstraint")
	userSizeConstraint.MaxTextSize = 12
	userSizeConstraint.MinTextSize = 8
	userSizeConstraint.Parent = userLabel
	userLabel.Parent = userPill
	userPill.Parent = col

	-- 3. Time Pill
	local timePill = Instance.new("Frame")
	timePill.Name = "TimePill"
	timePill.Size = UDim2.new(0, 110, 0, 24)
	timePill.Position = UDim2.new(0.5, 0, 0, config.pill2Y)
	timePill.AnchorPoint = Vector2.new(0.5, 0)
	timePill.BackgroundColor3 = Color3.fromRGB(33, 33, 33)
	timePill.BorderSizePixel = 0
	timePill.ZIndex = 47

	local tpCorner = Instance.new("UICorner")
	tpCorner.CornerRadius = UDim.new(0, 12)
	tpCorner.Parent = timePill

	local tpStroke = Instance.new("UIStroke")
	tpStroke.Color = Color3.fromRGB(255, 255, 255)
	tpStroke.Thickness = 1.5
	tpStroke.Parent = timePill

	local timeLabel = Instance.new("TextLabel")
	timeLabel.Size = UDim2.new(1, -10, 1, 0)
	timeLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	timeLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	timeLabel.BackgroundTransparency = 1
	timeLabel.Text = formatSurvivalTime(data.SurvivalTime)
	timeLabel.Font = Enum.Font.GothamBold
	timeLabel.TextSize = 10
	timeLabel.TextScaled = true
	timeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	timeLabel.TextTruncate = Enum.TextTruncate.AtEnd
	timeLabel.TextXAlignment = Enum.TextXAlignment.Center
	timeLabel.ZIndex = 48

	local timeSizeConstraint = Instance.new("UITextSizeConstraint")
	timeSizeConstraint.MaxTextSize = 11
	timeSizeConstraint.MinTextSize = 7
	timeSizeConstraint.Parent = timeLabel
	timeLabel.Parent = timePill
	timePill.Parent = col

	-- 4. Big Bold Rank Text
	local rankLabel = Instance.new("TextLabel")
	rankLabel.Name = "RankLabel"
	rankLabel.Size = UDim2.new(0, 108, 0, 48)
	rankLabel.Position = UDim2.new(0.5, 0, 0, config.rankY)
	rankLabel.AnchorPoint = Vector2.new(0.5, 0)
	rankLabel.BackgroundTransparency = 1
	rankLabel.Text = "#" .. tostring(rank)
	rankLabel.Font = Enum.Font.GothamBlack
	rankLabel.TextSize = config.rankSize
	rankLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	rankLabel.ZIndex = 49

	local rkStroke = Instance.new("UIStroke")
	rkStroke.Color = Color3.fromRGB(0, 0, 0)
	rkStroke.Thickness = config.rankStroke
	rkStroke.Parent = rankLabel
	rankLabel.Parent = col

	col.Parent = parent
	return col
end

function MatchOverModalView.new(gui: ScreenGui, onVisibilityChanged: (() -> ())?): MatchOverModal
	local self = setmetatable({}, MatchOverModalView) :: any

	local matchOverModal = (gui:WaitForChild("MatchOverModal", 5) or gui:FindFirstChild("MatchOverModal")) :: Frame?
	if not matchOverModal then
		matchOverModal = Instance.new("Frame")
		matchOverModal.Name = "MatchOverModal"
		matchOverModal.AnchorPoint = Vector2.new(0.5, 0.5)
		matchOverModal.Position = UDim2.new(0.5, 0, 0.5, 0)
		matchOverModal.Size = UDim2.new(0, 560, 0, 420)
		matchOverModal.BackgroundTransparency = 1
		matchOverModal.BorderSizePixel = 0
		matchOverModal.ZIndex = 40
		matchOverModal.Visible = false
		matchOverModal.Parent = gui
	end
	self.ModalFrame = matchOverModal

	-- Responsive UIScale
	local uiScale = matchOverModal:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	uiScale.Parent = matchOverModal
	local cam = Workspace.CurrentCamera
	local function updateResultsScale()
		if not cam then return end
		local vp = cam.ViewportSize
		local scaleW = vp.X / 580
		local scaleH = vp.Y / 440
		uiScale.Scale = math.clamp(math.min(scaleW, scaleH), 0.5, 1.0)
	end
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateResultsScale)
		updateResultsScale()
	end

	for _, child in ipairs(matchOverModal:GetChildren()) do
		if child.Name == "Title" or child.Name == "WinnerName" or child.Name == "Subtitle" then
			child.Visible = false
		end
	end

	-- Shadow Frame
	local shadowFrame = matchOverModal:FindFirstChild("ShadowFrame") :: Frame?
	if not shadowFrame then
		shadowFrame = Instance.new("Frame")
		shadowFrame.Name = "ShadowFrame"
		shadowFrame.Size = UDim2.new(1, -12, 1, -12)
		shadowFrame.Position = UDim2.new(0, 12, 0, 12)
		shadowFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		shadowFrame.BorderSizePixel = 0
		shadowFrame.ZIndex = 40

		local sCorner = Instance.new("UICorner")
		sCorner.CornerRadius = UDim.new(0, 8)
		sCorner.Parent = shadowFrame
		shadowFrame.Parent = matchOverModal
	end

	-- Border Frame
	local borderFrame = matchOverModal:FindFirstChild("BorderFrame") :: Frame?
	if not borderFrame then
		borderFrame = Instance.new("Frame")
		borderFrame.Name = "BorderFrame"
		borderFrame.Size = UDim2.new(1, -10, 1, -10)
		borderFrame.Position = UDim2.new(0, 0, 0, 0)
		borderFrame.BackgroundTransparency = 1
		borderFrame.BorderSizePixel = 0
		borderFrame.ZIndex = 41

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 8)
		bCorner.Parent = borderFrame

		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(0, 175, 255)
		bStroke.Thickness = 2.5
		bStroke.LineJoinMode = Enum.LineJoinMode.Round
		bStroke.Parent = borderFrame

		borderFrame.Parent = matchOverModal
	end

	-- Card Frame
	local cardFrame = matchOverModal:FindFirstChild("CardFrame") :: Frame?
	if not cardFrame then
		cardFrame = Instance.new("Frame")
		cardFrame.Name = "CardFrame"
		cardFrame.Size = UDim2.new(1, -12, 1, -12)
		cardFrame.Position = UDim2.new(0, 0, 0, 0)
		cardFrame.BackgroundColor3 = Color3.fromRGB(242, 118, 16)
		cardFrame.BorderSizePixel = 0
		cardFrame.ZIndex = 42

		local cCorner = Instance.new("UICorner")
		cCorner.CornerRadius = UDim.new(0, 8)
		cCorner.Parent = cardFrame

		local cStroke = Instance.new("UIStroke")
		cStroke.Name = "CardStroke"
		cStroke.Color = Color3.fromRGB(0, 0, 0)
		cStroke.Thickness = 4.5
		cStroke.LineJoinMode = Enum.LineJoinMode.Round
		cStroke.Parent = cardFrame

		local bgImage = Instance.new("ImageLabel")
		bgImage.Name = "BgImage"
		bgImage.Size = UDim2.new(1, 0, 1, 0)
		bgImage.Position = UDim2.new(0, 0, 0, 0)
		bgImage.BackgroundTransparency = 1
		bgImage.Image = RESULTS_BG_ASSET
		bgImage.ScaleType = Enum.ScaleType.Crop
		bgImage.ZIndex = 43

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(0, 8)
		bgCorner.Parent = bgImage
		bgImage.Parent = cardFrame

		cardFrame.Parent = matchOverModal
	end
	self.CardFrame = cardFrame

	-- Title
	local titleLabel = cardFrame:FindFirstChild("TitleLabel") :: TextLabel?
	if not titleLabel then
		titleLabel = Instance.new("TextLabel")
		titleLabel.Name = "TitleLabel"
		titleLabel.Size = UDim2.new(0, 240, 0, 48)
		titleLabel.Position = UDim2.new(0.5, 0, 0, 10)
		titleLabel.AnchorPoint = Vector2.new(0.5, 0)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = "Results"
		titleLabel.Font = Enum.Font.FredokaOne
		titleLabel.TextSize = 38
		titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		titleLabel.ZIndex = 48

		local tStroke = Instance.new("UIStroke")
		tStroke.Color = Color3.fromRGB(0, 0, 0)
		tStroke.Thickness = 4.5
		tStroke.Parent = titleLabel
		titleLabel.Parent = cardFrame
	end

	-- Close Results Button
	local closeResultsBtn = cardFrame:FindFirstChild("CloseResultsBtn") :: TextButton?
	if not closeResultsBtn then
		closeResultsBtn = Instance.new("TextButton")
		closeResultsBtn.Name = "CloseResultsBtn"
		closeResultsBtn.Size = UDim2.new(0, 36, 0, 36)
		closeResultsBtn.Position = UDim2.new(1, -14, 0, 14)
		closeResultsBtn.AnchorPoint = Vector2.new(1, 0)
		closeResultsBtn.BackgroundColor3 = Color3.fromRGB(235, 25, 25)
		closeResultsBtn.Text = "X"
		closeResultsBtn.Font = Enum.Font.GothamBlack
		closeResultsBtn.TextSize = 20
		closeResultsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		closeResultsBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		closeResultsBtn.TextStrokeTransparency = 0
		closeResultsBtn.ZIndex = 50

		local crCorner = Instance.new("UICorner")
		crCorner.CornerRadius = UDim.new(0, 6)
		crCorner.Parent = closeResultsBtn

		local crStroke = Instance.new("UIStroke")
		crStroke.Color = Color3.fromRGB(0, 0, 0)
		crStroke.Thickness = 2.5
		crStroke.Parent = closeResultsBtn

		closeResultsBtn.MouseEnter:Connect(function()
			TweenService:Create(closeResultsBtn, TweenInfo.new(0.12), {
				BackgroundColor3 = Color3.fromRGB(255, 60, 60),
				Size = UDim2.new(0, 38, 0, 38),
			}):Play()
		end)
		closeResultsBtn.MouseLeave:Connect(function()
			TweenService:Create(closeResultsBtn, TweenInfo.new(0.12), {
				BackgroundColor3 = Color3.fromRGB(235, 25, 25),
				Size = UDim2.new(0, 36, 0, 36),
			}):Play()
		end)

		closeResultsBtn.Parent = cardFrame
	end
	self.CloseResultsBtn = closeResultsBtn

	closeResultsBtn.MouseButton1Click:Connect(function()
		self:Hide()
		if onVisibilityChanged then onVisibilityChanged() end
	end)

	-- Podium Container
	local podiumContainer = cardFrame:FindFirstChild("PodiumContainer") :: Frame?
	if not podiumContainer then
		podiumContainer = Instance.new("Frame")
		podiumContainer.Name = "PodiumContainer"
		podiumContainer.Size = UDim2.new(1, 0, 1, 0)
		podiumContainer.Position = UDim2.new(0, 0, 0, 0)
		podiumContainer.BackgroundTransparency = 1
		podiumContainer.BorderSizePixel = 0
		podiumContainer.ZIndex = 45
		podiumContainer.Parent = cardFrame
	end
	self.PodiumContainer = podiumContainer

	function self:Show(data: any, localPlayer: Player)
		for _, child in ipairs(self.PodiumContainer:GetChildren()) do
			child:Destroy()
		end

		local rawPodium = data and data.Podium or {}
		local winnerNameStr = data and data.Winner or "Winner"
		local totalDur = data and data.TotalDuration or 83

		local p1 = rawPodium[1] or { Rank = 1, UserId = localPlayer.UserId, Name = winnerNameStr, DisplayName = winnerNameStr, SurvivalTime = totalDur }
		local p2 = rawPodium[2] or { Rank = 2, UserId = 1, Name = "RunnerUp", DisplayName = "RunnerUp", SurvivalTime = math.max(1, totalDur - 12) }
		local p3 = rawPodium[3] or { Rank = 3, UserId = 2, Name = "Contender", DisplayName = "Contender", SurvivalTime = math.max(1, totalDur - 25) }

		local cfg1 = {
			colPosition = UDim2.new(0.5, 0, 0, 0),
			colAnchor = Vector2.new(0.5, 0),
			boxY = 68,
			pill1Y = 186,
			pill2Y = 213,
			rankY = 244,
			rankSize = 48,
			rankStroke = 5,
		}
		local cfg2 = {
			colPosition = UDim2.new(0, 97, 0, 0),
			colAnchor = Vector2.new(0.5, 0),
			boxY = 124,
			pill1Y = 242,
			pill2Y = 269,
			rankY = 302,
			rankSize = 44,
			rankStroke = 4.5,
		}
		local cfg3 = {
			colPosition = UDim2.new(1, -97, 0, 0),
			colAnchor = Vector2.new(0.5, 0),
			boxY = 180,
			pill1Y = 298,
			pill2Y = 325,
			rankY = 356,
			rankSize = 44,
			rankStroke = 4.5,
		}

		createPodiumColumn(self.PodiumContainer, 1, p1, cfg1, localPlayer)
		createPodiumColumn(self.PodiumContainer, 2, p2, cfg2, localPlayer)
		createPodiumColumn(self.PodiumContainer, 3, p3, cfg3, localPlayer)

		self.ModalFrame.Size = UDim2.new(0, 480, 0, 360)
		self.ModalFrame.Visible = true
		TweenService:Create(self.ModalFrame, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 560, 0, 420),
		}):Play()

		pcall(function()
			local popSound = Instance.new("Sound")
			popSound.SoundId = "rbxasset://sounds/action_get_up.mp3"
			popSound.Volume = 0.8
			popSound.Parent = self.ModalFrame
			popSound:Play()
			Debris:AddItem(popSound, 2)
		end)

		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:Hide()
		self.ModalFrame.Visible = false
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:IsVisible(): boolean
		return self.ModalFrame.Visible
	end

	function self:SetVisible(visible: boolean)
		self.ModalFrame.Visible = visible
		if onVisibilityChanged then onVisibilityChanged() end
	end

	return self
end

return MatchOverModalView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">RankingsModalView</string>
            <string name="Source"><![CDATA[--!strict
-- src/client/ui/modals/RankingsModalView.luau
-- Manages the 4-column game-show Rankings Leaderboard (SI.NO, PLAYER NAME, BID, TIME),
-- avatar thumbnails, safe green/danger red dynamic row styling, and modal display.

local Players = game:GetService("Players")

local RankingsModalView = {}
RankingsModalView.__index = RankingsModalView

export type RankingsModal = {
	ModalFrame: Frame,
	ShadowFrame: Frame,
	CardFrame: Frame,
	CloseRankBtn: TextButton?,
	Populate: (self: RankingsModal, data: any, localPlayer: Player, currentRound: number) -> (),
	Open: (self: RankingsModal) -> (),
	Close: (self: RankingsModal) -> (),
	IsVisible: (self: RankingsModal) -> boolean,
	SetVisible: (self: RankingsModal, visible: boolean) -> (),
}

local function resolvePlayerDisplayName(pData, localPlayer: Player): string
	if not pData then return "Player" end
	if localPlayer and pData.UserId == localPlayer.UserId then
		return localPlayer.DisplayName
	end
	if pData.DisplayName and #pData.DisplayName > 0 then
		return pData.DisplayName
	end
	if pData.UserId and pData.UserId > 0 then
		local realP = Players:GetPlayerByUserId(pData.UserId)
		if realP then return realP.DisplayName end
	end
	return pData.Name or "Player"
end

function RankingsModalView.new(gui: ScreenGui, onVisibilityChanged: (() -> ())?): RankingsModal
	local self = setmetatable({}, RankingsModalView) :: any

	local rankingsModal = (gui:WaitForChild("RankingsModal", 5) or gui:FindFirstChild("RankingsModal")) :: Frame?
	if not rankingsModal then
		rankingsModal = Instance.new("Frame")
		rankingsModal.Name = "RankingsModal"
		rankingsModal.AnchorPoint = Vector2.new(0.5, 0.5)
		rankingsModal.Position = UDim2.new(0.5, 0, 0.5, 0)
		rankingsModal.Size = UDim2.new(0, 580, 0, 360)
		rankingsModal.BackgroundTransparency = 1
		rankingsModal.BorderSizePixel = 0
		rankingsModal.Visible = false
		rankingsModal.ZIndex = 60
		rankingsModal.Parent = gui
	else
		rankingsModal.ZIndex = 60
	end
	self.ModalFrame = rankingsModal

	local shadowFrame = rankingsModal:FindFirstChild("ShadowFrame") :: Frame?
	if not shadowFrame then
		shadowFrame = Instance.new("Frame")
		shadowFrame.Name = "ShadowFrame"
		shadowFrame.Size = UDim2.new(1, -8, 1, -8)
		shadowFrame.Position = UDim2.new(0, 8, 0, 8)
		shadowFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		shadowFrame.BackgroundTransparency = 0.55
		shadowFrame.BorderSizePixel = 0
		shadowFrame.ZIndex = 58

		local sCorner = Instance.new("UICorner")
		sCorner.CornerRadius = UDim.new(0, 4)
		sCorner.Parent = shadowFrame
		shadowFrame.Parent = rankingsModal
	else
		shadowFrame.ZIndex = 58
	end
	self.ShadowFrame = shadowFrame

	local cardFrame = rankingsModal:FindFirstChild("CardFrame") :: Frame?
	if not cardFrame then
		cardFrame = Instance.new("Frame")
		cardFrame.Name = "CardFrame"
		cardFrame.Size = UDim2.new(1, -8, 1, -8)
		cardFrame.Position = UDim2.new(0, 0, 0, 0)
		cardFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
		cardFrame.BorderSizePixel = 0
		cardFrame.ZIndex = 60

		local cCorner = Instance.new("UICorner")
		cCorner.CornerRadius = UDim.new(0, 4)
		cCorner.Parent = cardFrame

		local cStroke = Instance.new("UIStroke")
		cStroke.Name = "CardStroke"
		cStroke.Color = Color3.fromRGB(0, 0, 0)
		cStroke.Thickness = 2
		cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		cStroke.LineJoinMode = Enum.LineJoinMode.Miter
		cStroke.Parent = cardFrame

		local bgImage = Instance.new("ImageLabel")
		bgImage.Name = "BgImage"
		bgImage.Size = UDim2.new(1, 0, 1, 0)
		bgImage.Position = UDim2.new(0, 0, 0, 0)
		bgImage.BackgroundTransparency = 0
		bgImage.Image = "rbxasset://textures/bid-leaderboard-background.jpg"
		bgImage.ScaleType = Enum.ScaleType.Crop
		bgImage.ZIndex = 61
		bgImage.Visible = true

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(0, 4)
		bgCorner.Parent = bgImage
		bgImage.Parent = cardFrame

		cardFrame.Parent = rankingsModal
	else
		cardFrame.ZIndex = 60
	end
	self.CardFrame = cardFrame

	-- Close Button (Created once in new(), permanent across all states and re-opens)
	local closeRankBtn = cardFrame:FindFirstChild("CloseRankBtn") :: TextButton?
	if not closeRankBtn then
		closeRankBtn = Instance.new("TextButton")
		closeRankBtn.Name = "CloseRankBtn"
		closeRankBtn.Size = UDim2.new(0, 32, 0, 32)
		closeRankBtn.Position = UDim2.new(1, -12, 0, 10)
		closeRankBtn.AnchorPoint = Vector2.new(1, 0)
		closeRankBtn.BackgroundColor3 = Color3.fromRGB(230, 35, 35)

		local crbCorner = Instance.new("UICorner")
		crbCorner.CornerRadius = UDim.new(0, 5)
		crbCorner.Parent = closeRankBtn

		local crbStroke = Instance.new("UIStroke")
		crbStroke.Color = Color3.fromRGB(0, 0, 0)
		crbStroke.Thickness = 2
		crbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		crbStroke.Parent = closeRankBtn

		closeRankBtn.Parent = cardFrame
	end

	-- Always guarantee button text, styling and crisp XLabel overlay
	closeRankBtn.Text = "X"
	closeRankBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeRankBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	closeRankBtn.TextStrokeTransparency = 0
	closeRankBtn.Font = Enum.Font.GothamBlack
	closeRankBtn.TextSize = 18
	closeRankBtn.ZIndex = 65
	closeRankBtn.Active = true
	closeRankBtn.Selectable = true
	closeRankBtn.Visible = true

	closeRankBtn.MouseEnter:Connect(function()
		closeRankBtn.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
	end)
	closeRankBtn.MouseLeave:Connect(function()
		closeRankBtn.BackgroundColor3 = Color3.fromRGB(230, 35, 35)
	end)

	local function handleCloseClick()
		self:Close()
	end
	closeRankBtn.MouseButton1Click:Connect(handleCloseClick)
	closeRankBtn.Activated:Connect(handleCloseClick)

	local xLabel = closeRankBtn:FindFirstChild("XLabel") :: TextLabel?
	if not xLabel then
		xLabel = Instance.new("TextLabel")
		xLabel.Name = "XLabel"
		xLabel.Size = UDim2.fromScale(1, 1)
		xLabel.Position = UDim2.fromScale(0, 0)
		xLabel.BackgroundTransparency = 1
		xLabel.Active = false
		xLabel.Selectable = false
		xLabel.Parent = closeRankBtn
	end
	xLabel.Text = "X"
	xLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	xLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	xLabel.TextStrokeTransparency = 0
	xLabel.Font = Enum.Font.GothamBlack
	xLabel.TextSize = 18
	xLabel.TextXAlignment = Enum.TextXAlignment.Center
	xLabel.TextYAlignment = Enum.TextYAlignment.Center
	xLabel.ZIndex = 66
	xLabel.Active = false
	xLabel.Selectable = false
	xLabel.Visible = true

	self.CloseRankBtn = closeRankBtn

	function self:Populate(data: any, localPlayer: Player, currentRound: number)
		local allBidders = {}
		local safeCount = data.SafeCount or 1
		for _, p in ipairs(data.TopBidders or {}) do table.insert(allBidders, p) end
		for _, p in ipairs(data.BottomBidders or {}) do table.insert(allBidders, p) end

		local rowCount = #allBidders
		local rowHeight = 36
		local rowPadding = 4
		local tableContentHeight = rowCount * (rowHeight + rowPadding)

		local desiredHeight = 110 + tableContentHeight + 12
		local modalHeight = math.clamp(desiredHeight, 260, 560)

		self.ModalFrame.Size = UDim2.new(0, 580, 0, modalHeight)
		self.ModalFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		self.ModalFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

		-- Clean up table content (keep CloseRankBtn and BgImage intact)
		for _, child in ipairs(self.CardFrame:GetChildren()) do
			if child.Name == "HeaderFrame" or child.Name == "LeaderboardScroll" or child.Name == "TitleHeader" or child.Name == "FooterStatement" then
				child:Destroy()
			end
		end

		if self.CloseRankBtn then
			self.CloseRankBtn.Visible = true
			self.CloseRankBtn.ZIndex = 65
			self.CloseRankBtn.Parent = self.CardFrame
		end

		-- Title Header: "BID LEADERBOARD"
		local titleHeader = Instance.new("Frame")
		titleHeader.Name = "TitleHeader"
		titleHeader.Size = UDim2.new(1, -70, 0, 32)
		titleHeader.Position = UDim2.new(0, 16, 0, 12)
		titleHeader.BackgroundTransparency = 1
		titleHeader.ZIndex = 28
		titleHeader.Parent = self.CardFrame

		local titleLabel = Instance.new("TextLabel")
		titleLabel.Size = UDim2.new(1, 0, 1, 0)
		titleLabel.Position = UDim2.new(0, 0, 0, 0)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Text = "BID LEADERBOARD"
		titleLabel.Font = Enum.Font.GothamBlack
		titleLabel.TextSize = 18
		titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		titleLabel.TextXAlignment = Enum.TextXAlignment.Left
		titleLabel.TextYAlignment = Enum.TextYAlignment.Center
		titleLabel.ZIndex = 29
		titleLabel.Parent = titleHeader

		-- Header Frame
		local headerFrame = Instance.new("Frame")
		headerFrame.Name = "HeaderFrame"
		headerFrame.Size = UDim2.new(1, -32, 0, 26)
		headerFrame.Position = UDim2.new(0, 16, 0, 52)
		headerFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
		headerFrame.BorderSizePixel = 0
		headerFrame.ZIndex = 28

		local hCorner = Instance.new("UICorner")
		hCorner.CornerRadius = UDim.new(0, 3)
		hCorner.Parent = headerFrame

		local hStroke = Instance.new("UIStroke")
		hStroke.Color = Color3.fromRGB(42, 42, 54)
		hStroke.Thickness = 1
		hStroke.Parent = headerFrame

		local function makeHeaderCell(text, size, pos, align)
			local hCell = Instance.new("TextLabel")
			hCell.Size = size
			hCell.Position = pos
			hCell.BackgroundTransparency = 1
			hCell.Text = text
			hCell.Font = Enum.Font.GothamBold
			hCell.TextSize = 10
			hCell.TextColor3 = Color3.fromRGB(150, 155, 170)
			hCell.TextXAlignment = align
			hCell.ZIndex = 29
			hCell.Parent = headerFrame
			return hCell
		end

		makeHeaderCell("SI.NO", UDim2.new(0.12, 0, 1, 0), UDim2.new(0, 4, 0, 0), Enum.TextXAlignment.Center)
		makeHeaderCell("PLAYER NAME", UDim2.new(0.46, -10, 1, 0), UDim2.new(0.12, 10, 0, 0), Enum.TextXAlignment.Left)
		makeHeaderCell("BID", UDim2.new(0.21, 0, 1, 0), UDim2.new(0.58, 0, 0, 0), Enum.TextXAlignment.Right)
		makeHeaderCell("TIME", UDim2.new(0.21, -8, 1, 0), UDim2.new(0.79, -8, 0, 0), Enum.TextXAlignment.Right)
		headerFrame.Parent = self.CardFrame

		-- Scrolling Frame
		local isScrollable = (tableContentHeight > (modalHeight - 96))
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "LeaderboardScroll"
		scroll.Size = UDim2.new(1, -32, 1, -90)
		scroll.Position = UDim2.new(0, 16, 0, 82)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = isScrollable and 4 or 0
		scroll.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 85)
		scroll.ScrollingEnabled = isScrollable
		scroll.CanvasSize = UDim2.new(0, 0, 0, tableContentHeight + 4)
		scroll.ZIndex = 28

		local sPadding = Instance.new("UIPadding")
		sPadding.PaddingLeft = UDim.new(0, 2)
		sPadding.PaddingRight = UDim.new(0, isScrollable and 8 or 2)
		sPadding.PaddingTop = UDim.new(0, 2)
		sPadding.PaddingBottom = UDim.new(0, 2)
		sPadding.Parent = scroll

		local uiList = Instance.new("UIListLayout")
		uiList.SortOrder = Enum.SortOrder.LayoutOrder
		uiList.Padding = UDim.new(0, rowPadding)
		uiList.Parent = scroll

		for i, p in ipairs(allBidders) do
			local isSafe = (i <= safeCount)
			local isMe = localPlayer and ((p.UserId == localPlayer.UserId) or (p.Name == localPlayer.Name) or (p.DisplayName == localPlayer.DisplayName))
			local dispName = resolvePlayerDisplayName(p, localPlayer)

			local row = Instance.new("Frame")
			row.Name = "Row_" .. i
			row.Size = UDim2.new(1, 0, 0, rowHeight)
			row.LayoutOrder = i
			row.BorderSizePixel = 0
			row.ZIndex = 28

			local rCorner = Instance.new("UICorner")
			rCorner.CornerRadius = UDim.new(0, 3)
			rCorner.Parent = row

			local rStroke = Instance.new("UIStroke")
			rStroke.LineJoinMode = Enum.LineJoinMode.Miter
			rStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

			if isMe then
				row.BackgroundColor3 = Color3.fromRGB(34, 28, 18)
				rStroke.Color = Color3.fromRGB(245, 158, 11)
				rStroke.Thickness = 1.5
			elseif isSafe then
				row.BackgroundColor3 = Color3.fromRGB(14, 25, 19)
				rStroke.Color = Color3.fromRGB(34, 197, 94)
				rStroke.Thickness = 1
			else
				row.BackgroundColor3 = Color3.fromRGB(26, 15, 17)
				rStroke.Color = Color3.fromRGB(239, 68, 68)
				rStroke.Thickness = 1
			end
			rStroke.Parent = row

			-- Column 1: SI.NO
			local c1 = Instance.new("TextLabel")
			c1.Size = UDim2.new(0.12, 0, 1, 0)
			c1.Position = UDim2.new(0, 4, 0, 0)
			c1.BackgroundTransparency = 1
			c1.Text = "#" .. tostring(i)
			c1.Font = Enum.Font.GothamBold
			c1.TextSize = 12
			c1.TextColor3 = isMe and Color3.fromRGB(245, 195, 65) or (isSafe and Color3.fromRGB(110, 235, 155) or Color3.fromRGB(245, 110, 120))
			c1.TextXAlignment = Enum.TextXAlignment.Center
			c1.ZIndex = 30
			c1.Parent = row

			-- Column 2: PLAYER NAME
			local playerColFrame = Instance.new("Frame")
			playerColFrame.Size = UDim2.new(0.46, -10, 1, 0)
			playerColFrame.Position = UDim2.new(0.12, 10, 0, 0)
			playerColFrame.BackgroundTransparency = 1
			playerColFrame.ZIndex = 29

			local avImg = Instance.new("ImageLabel")
			avImg.Size = UDim2.new(0, 24, 0, 24)
			avImg.Position = UDim2.new(0, 0, 0.5, 0)
			avImg.AnchorPoint = Vector2.new(0, 0.5)
			avImg.BackgroundTransparency = 1
			local thumbId = (p.UserId and p.UserId > 0) and p.UserId or 1
			avImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", thumbId)
			avImg.ScaleType = Enum.ScaleType.Fit
			avImg.ZIndex = 31

			local aviCorner = Instance.new("UICorner")
			aviCorner.CornerRadius = UDim.new(0, 3)
			aviCorner.Parent = avImg
			avImg.Parent = playerColFrame

			local c2 = Instance.new("TextLabel")
			c2.Size = UDim2.new(1, -30, 1, 0)
			c2.Position = UDim2.new(0, 30, 0, 0)
			c2.BackgroundTransparency = 1
			if isMe then
				c2.Text = string.format("%s (YOU)", dispName)
				c2.Font = Enum.Font.GothamBold
				c2.TextSize = 12
				c2.TextColor3 = Color3.fromRGB(255, 230, 110)
			else
				c2.Text = dispName
				c2.Font = Enum.Font.GothamMedium
				c2.TextSize = 12
				c2.TextColor3 = Color3.fromRGB(245, 245, 250)
			end
			c2.TextXAlignment = Enum.TextXAlignment.Left
			c2.TextTruncate = Enum.TextTruncate.AtEnd
			c2.ZIndex = 30
			c2.Parent = playerColFrame
			playerColFrame.Parent = row

			-- Column 3: BID
			local c3 = Instance.new("TextLabel")
			c3.Size = UDim2.new(0.21, 0, 1, 0)
			c3.Position = UDim2.new(0.58, 0, 0, 0)
			c3.BackgroundTransparency = 1
			c3.Text = string.format("$%.2f", p.CurrentBid or 0)
			c3.Font = Enum.Font.GothamBold
			c3.TextSize = 13
			c3.TextColor3 = Color3.fromRGB(245, 195, 65)
			c3.TextXAlignment = Enum.TextXAlignment.Right
			c3.ZIndex = 29
			c3.Parent = row

			-- Column 4: TIME
			local c4 = Instance.new("TextLabel")
			c4.Size = UDim2.new(0.21, -8, 1, 0)
			c4.Position = UDim2.new(0.79, -8, 0, 0)
			c4.BackgroundTransparency = 1
			local elapsed = p.SubmitTime or 10.00
			c4.Text = string.format("%.2fs", elapsed)
			c4.Font = Enum.Font.GothamMedium
			c4.TextSize = 12
			c4.TextColor3 = Color3.fromRGB(180, 185, 200)
			c4.TextXAlignment = Enum.TextXAlignment.Right
			c4.ZIndex = 29
			c4.Parent = row

			row.Parent = scroll
		end

		scroll.Parent = self.CardFrame
		self.ModalFrame.Visible = true
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:Open()
		self.ModalFrame.Visible = true
		if self.CloseRankBtn then
			self.CloseRankBtn.Visible = true
			self.CloseRankBtn.ZIndex = 65
			self.CloseRankBtn.Parent = self.CardFrame
		end
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:Close()
		self.ModalFrame.Visible = false
		if onVisibilityChanged then onVisibilityChanged() end
	end

	function self:IsVisible(): boolean
		return self.ModalFrame.Visible
	end

	function self:SetVisible(visible: boolean)
		self.ModalFrame.Visible = visible
		if onVisibilityChanged then onVisibilityChanged() end
	end

	return self
end

return RankingsModalView
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">GameConfig</string>
        <string name="Source"><![CDATA[local GameConfig = {}

GameConfig.StartingMoney = 20.00
GameConfig.MaxHealth = 100
GameConfig.MinPlayersToStart = 1
GameConfig.MaxPlayers = 10

-- Exact Authoritative Phase Timings
GameConfig.IntermissionTime = 5       -- Lobby Countdown (5 full seconds)
GameConfig.RouletteDuration = 6.0     -- Visible decelerating roulette animation
GameConfig.RouletteHoldTime = 1.5     -- Hold revealed hammer before transition
GameConfig.SpawnPhaseTime = 8.0       -- Total Phase 1 duration (6.0s + 1.5s + 0.5s pause)
GameConfig.VoteTime = 7               -- Anonymous Vote (Round 2+)
GameConfig.BidTime = 10               -- Bidding Phase (Exactly 10 seconds)
GameConfig.RevealRankingsTime = 5     -- Leaderboard reveal (5 full seconds)
GameConfig.ScrambleTime = 9           -- Safe tile scramble (9 seconds)
GameConfig.SmashDelay = 2.5           -- Executioner windup
GameConfig.SettlementTime = 4         -- Round settlement and eliminations

GameConfig.HammerRarities = {
    Common = {
        Name = "Common",
        Chance = 0.35,
        DamagePercent = 30,
        Color = Color3.fromRGB(220, 225, 235),
        GlowColor = Color3.fromRGB(240, 240, 255),
        Neon = false,
        SoundPitch = 1.0,
        CameraShake = 0.5,
        AssetFile = "hammer_common.png",
        AssetId = "rbxassetid://99687163311393",
    },
    Uncommon = {
        Name = "Uncommon",
        Chance = 0.30,
        DamagePercent = 40,
        Color = Color3.fromRGB(80, 220, 100),
        GlowColor = Color3.fromRGB(60, 255, 120),
        Neon = false,
        SoundPitch = 0.95,
        CameraShake = 0.8,
        AssetFile = "hammer_uncommon.png",
        AssetId = "rbxassetid://94906827959757",
    },
    Rare = {
        Name = "Rare",
        Chance = 0.20,
        DamagePercent = 50,
        Color = Color3.fromRGB(70, 160, 255),
        GlowColor = Color3.fromRGB(0, 195, 255),
        Neon = true,
        SoundPitch = 0.9,
        CameraShake = 1.2,
        AssetFile = "hammer_rare.png",
        AssetId = "rbxassetid://99122878797775",
    },
    Legendary = {
        Name = "Legendary",
        Chance = 0.10,
        DamagePercent = 60,
        Color = Color3.fromRGB(255, 170, 0),
        GlowColor = Color3.fromRGB(255, 200, 30),
        Neon = true,
        SoundPitch = 0.85,
        CameraShake = 1.6,
        AssetFile = "hammer_legendary.png",
        AssetId = "rbxassetid://134660087390735",
    },
    Mythical = {
        Name = "Mythical",
        Chance = 0.05,
        DamagePercent = 70,
        Color = Color3.fromRGB(255, 0, 120),
        GlowColor = Color3.fromRGB(255, 40, 180),
        Neon = true,
        SoundPitch = 0.75,
        CameraShake = 2.2,
        AssetFile = "hammer_mythical.png",
        AssetId = "rbxassetid://105142270694831",
    }
}

GameConfig.RarityOrder = {"Common", "Uncommon", "Rare", "Legendary", "Mythical"}

function GameConfig.GetRarityList()
    local list = {}
    for _, name in ipairs(GameConfig.RarityOrder) do
        table.insert(list, GameConfig.HammerRarities[name])
    end
    return list
end

local HammerRarityRoller
pcall(function()
    HammerRarityRoller = require(game:GetService("ReplicatedStorage"):WaitForChild("HammerRarityRoller", 3))
end)
if not HammerRarityRoller then
    HammerRarityRoller = require(script.Parent:WaitForChild("HammerRarityRoller"))
end

GameConfig.HammerRarityRoller = HammerRarityRoller
GameConfig.RollWinningHammer = HammerRarityRoller.RollWinningHammer
GameConfig.BuildRandomSpinnerStrip = HammerRarityRoller.BuildRandomSpinnerStrip

function GameConfig.RollRarity(roundNumber: number?)
    local winning = HammerRarityRoller.RollWinningHammer(roundNumber or 1)
    return GameConfig.HammerRarities[winning.Rarity] or GameConfig.HammerRarities.Common
end

return GameConfig
]]></string>
      </Properties>
    </Item>
