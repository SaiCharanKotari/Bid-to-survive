    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">HammerRarityRoller</string>
        <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/HammerRarityRoller.luau
-- Authoritative module for 5-hammer rarities, round probability weights,
-- and rarity-weighted anti-repeat spinner reel generation.

local HammerRarityRoller = {}

export type HammerRarity = "Common" | "Uncommon" | "Rare" | "Legendary" | "Mythical"

export type HammerData = {
	Rarity: HammerRarity,
	DamagePercent: number,
}

-- Exact 5 Hammers (30% to 70% DMG)
local HAMMERS: { [HammerRarity]: HammerData } = {
	Common    = { Rarity = "Common",    DamagePercent = 30 },
	Uncommon  = { Rarity = "Uncommon",  DamagePercent = 40 },
	Rare      = { Rarity = "Rare",      DamagePercent = 50 },
	Legendary = { Rarity = "Legendary", DamagePercent = 60 },
	Mythical  = { Rarity = "Mythical",  DamagePercent = 70 },
}
HammerRarityRoller.HAMMERS = HAMMERS

local RARITY_ORDER: { HammerRarity } = { "Common", "Uncommon", "Rare", "Legendary", "Mythical" }

-- Round-by-Round Probability Weights (Sums to 100 every round)
-- Rounds 1-2: Common + Uncommon = 70%
-- Round 3:    Common + Uncommon = 50%
-- Round 4:    Common + Uncommon = 40%
-- Round 5:    Common + Uncommon = 25%
-- Round 6+:   Common + Uncommon = 10%
local ROUND_RARITY_WEIGHTS: { [number]: { [HammerRarity]: number } } = {
	[1] = { Common = 40, Uncommon = 30, Rare = 18, Legendary = 9,  Mythical = 3  },
	[2] = { Common = 32, Uncommon = 38, Rare = 16, Legendary = 10, Mythical = 4  },
	[3] = { Common = 25, Uncommon = 25, Rare = 25, Legendary = 16, Mythical = 9  },
	[4] = { Common = 18, Uncommon = 22, Rare = 25, Legendary = 21, Mythical = 14 },
	[5] = { Common = 10, Uncommon = 15, Rare = 25, Legendary = 28, Mythical = 22 },
	[6] = { Common = 4,  Uncommon = 6,  Rare = 20, Legendary = 35, Mythical = 35 },
}

local rng = Random.new()

-- 1. Roll the Winning Hammer for the Round based on Rarity Weights
function HammerRarityRoller.RollWinningHammer(roundNumber: number): HammerData
	local clampedRound = math.clamp(roundNumber or 1, 1, 6)
	local weights = ROUND_RARITY_WEIGHTS[clampedRound]

	local totalWeight = 0
	for _, rarity in ipairs(RARITY_ORDER) do
		totalWeight += weights[rarity]
	end

	local roll = rng:NextNumber(0, totalWeight)
	local cumulative = 0

	for _, rarity in ipairs(RARITY_ORDER) do
		cumulative += weights[rarity]
		if roll <= cumulative then
			return HammerRarityRoller.HAMMERS[rarity]
		end
	end

	return HammerRarityRoller.HAMMERS.Common
end

-- 2. Generate a Rarity-Weighted Random Image Sequence for the Existing Spinner UI
-- (Replaces predictable Common -> Uncommon -> Rare -> Legendary -> Mythical sequence)
function HammerRarityRoller.BuildRandomSpinnerStrip(roundNumber: number, totalSlots: number, winningSlotIndex: number, winningRarity: HammerRarity): { HammerRarity }
	local clampedRound = math.clamp(roundNumber or 1, 1, 6)
	local weights = ROUND_RARITY_WEIGHTS[clampedRound]

	local strip: { HammerRarity } = table.create(totalSlots)
	local previousRarity: HammerRarity? = nil

	for i = 1, totalSlots do
		if i == winningSlotIndex then
			strip[i] = winningRarity
			previousRarity = winningRarity
		else
			-- Roll a random hammer weighted by rarity, ensuring no two adjacent images are the same!
			local candidatePool = {}
			local poolWeight = 0

			for _, rarity in ipairs(RARITY_ORDER) do
				local isAdjacentToWinner = (i == winningSlotIndex - 1 or i == winningSlotIndex + 1) and (rarity == winningRarity)
				if rarity ~= previousRarity and not isAdjacentToWinner then
					-- Keep rarity weighting + minimum visual weight (8) so high-tier hammers still flash by during early spins
					local visualWeight = math.max(weights[rarity], 8)
					poolWeight += visualWeight
					table.insert(candidatePool, { Rarity = rarity, Weight = visualWeight })
				end
			end

			local pickRoll = rng:NextNumber(0, poolWeight)
			local accum = 0
			local chosen: HammerRarity = "Common"

			for _, entry in ipairs(candidatePool) do
				accum += entry.Weight
				if pickRoll <= accum then
					chosen = entry.Rarity
					break
				end
			end

			strip[i] = chosen
			previousRarity = chosen
		end
	end

	return strip
end

return HammerRarityRoller
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">ArenaManager</string>
        <string name="Source"><![CDATA[--!strict
-- src/server/round/ArenaManager.luau
-- Manages arena and lobby teleportation, winner safety glow highlights,
-- and the instant water fall rescue monitor.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ArenaManager = {}
ArenaManager.__index = ArenaManager

local spawnArea: Instance? = nil
local gameplayArea: Instance? = nil
local walkway: BasePart? = nil
local waterRescueConn: RBXScriptConnection? = nil
local lastWaterRescue: {[number]: number} = {}

function ArenaManager.Init(sArea: Instance?, gpArea: Instance?, walkPart: BasePart?)
	spawnArea = sArea
	gameplayArea = gpArea
	walkway = walkPart
end

function ArenaManager.TeleportCharacter(char: Model, targetPos: Vector3)
	if not char or not char.Parent then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 3) :: BasePart?
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		char:PivotTo(CFrame.new(targetPos))
		task.wait(0.05)
		char:PivotTo(CFrame.new(targetPos))
	end
end

function ArenaManager.TeleportToLobby(player: Player)
	local char = player.Character
	if not char then return end
	local lobbySpawn = spawnArea and spawnArea:FindFirstChild("LobbySpawn") :: BasePart?
	local basePos = lobbySpawn and lobbySpawn.Position or Vector3.new(48.11, 85.14, 2.92)
	local offset = Vector3.new(math.random(-3, 3), 3.5, math.random(-3, 3))
	ArenaManager.TeleportCharacter(char, basePos + offset)
end

function ArenaManager.TeleportToArena(player: Player)
	local char = player.Character
	if not char or not walkway then return end
	local wPos = walkway.Position
	local rx = math.random(-45, 45)
	local rz = math.random(-35, 35)
	local targetPos = Vector3.new(wPos.X + rx, wPos.Y + 3.5, wPos.Z + rz)
	ArenaManager.TeleportCharacter(char, targetPos)
end

function ArenaManager.RecoverToPlayArea(char: Model)
	if not char or not char.Parent or not walkway then return end
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		local wPos = walkway.Position
		local rx = math.random(-30, 30)
		local rz = math.random(-30, 30)
		local safePos = Vector3.new(wPos.X + rx, wPos.Y + 3.5, wPos.Z + rz)
		char:PivotTo(CFrame.new(safePos))
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

function ArenaManager.ApplyWinnerGlow(char: Model?)
	if not char then return end
	local old = char:FindFirstChild("SafeBidGlow")
	if old then old:Destroy() end

	local hl = Instance.new("Highlight")
	hl.Name = "SafeBidGlow"
	hl.FillColor = Color3.fromRGB(0, 255, 120)
	hl.OutlineColor = Color3.fromRGB(220, 255, 230)
	hl.FillTransparency = 0.25
	hl.OutlineTransparency = 0
	hl.Parent = char
end

function ArenaManager.ClearWinnerGlow(activeBots: {any}?)
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			local hl = player.Character:FindFirstChild("SafeBidGlow")
			if hl then hl:Destroy() end
		end
	end
	if activeBots then
		for _, bot in ipairs(activeBots) do
			if bot.Character then
				local hl = bot.Character:FindFirstChild("SafeBidGlow")
				if hl then hl:Destroy() end
			end
		end
	end
end

function ArenaManager.StartWaterRescueMonitor(playerDataGetter: () -> {[number]: any})
	if waterRescueConn then
		waterRescueConn:Disconnect()
		waterRescueConn = nil
	end

	waterRescueConn = RunService.Heartbeat:Connect(function()
		if not walkway then return end
		local now = os.clock()
		local playerData = playerDataGetter and playerDataGetter()

		if playerData then
			for userId, data in pairs(playerData) do
				if data.IsAlive and data.ParticipationState == "Active" then
					local char = data.Character
					if not char or not char.Parent then
						if not data.IsBot then
							local p = Players:GetPlayerByUserId(userId)
							char = p and p.Character
							data.Character = char
						end
					end

					if char and char.Parent then
						local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hrp and hum and hum.Health > 0 then
							local inPlayArea = (hrp.Position.X < -50)
							local hitWater = (hrp.Position.Y <= 34.5) or (hum:GetState() == Enum.HumanoidStateType.Swimming)

							if inPlayArea and hitWater then
								if not lastWaterRescue[userId] or (now - lastWaterRescue[userId]) > 0.15 then
									lastWaterRescue[userId] = now
									ArenaManager.RecoverToPlayArea(char)
								end
							end
						end
					end
				end
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local inPlayArea = (hrp.Position.X < -50) or (player:GetAttribute("IsInGame") == true and hrp.Position.X < 0)
				local hitWater = (hrp.Position.Y <= 34.5) or (hum:GetState() == Enum.HumanoidStateType.Swimming)
				if inPlayArea and hitWater then
					if not lastWaterRescue[player.UserId] or (now - lastWaterRescue[player.UserId]) > 0.15 then
						lastWaterRescue[player.UserId] = now
						ArenaManager.RecoverToPlayArea(char)
					end
				end
			end
		end
	end)
end

function ArenaManager.StopWaterRescueMonitor()
	if waterRescueConn then
		waterRescueConn:Disconnect()
		waterRescueConn = nil
	end
end

return ArenaManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">BotManager</string>
        <string name="Source"><![CDATA[--!strict
-- src/server/round/BotManager.luau
-- Manages companion bot dummy creation, appearance, positioning, bidding AI, and cleanup.

local Workspace = game:GetService("Workspace")

local BotManager = {}
BotManager.__index = BotManager

export type BotData = {
	UserId: number,
	Name: string,
	Money: number,
	Wallet: number?,
	Health: number,
	IsAlive: boolean,
	IsAFK: boolean,
	ParticipationState: string,
	CurrentBid: number,
	SubmitTime: number?,
	Votes: number,
	IsBot: boolean,
	Character: Model?,
}

local activeBots: {BotData} = {}
local gameplayArea: Instance? = nil
local walkway: BasePart? = nil
local gameConfig: any = nil

local BOT_NAMES = {
	"ApeSlayer", "ShadowRunner", "LuckyBids", "AlphaTitan", "RiskHunter",
	"ViperStrike", "CyberGhost", "BlazeWarrior", "EchoPhantom", "IronClaw",
}

function BotManager.Init(config: any, gpArea: Instance, walkPart: BasePart)
	gameConfig = config
	gameplayArea = gpArea
	walkway = walkPart
end

function BotManager.CleanupBots()
	for _, botData in ipairs(activeBots) do
		if botData.Character and botData.Character.Parent then
			botData.Character:Destroy()
		end
	end
	table.clear(activeBots)
end

function BotManager.CreateBotDummy(name: string, id: number, startPos: Vector3, playerData: {[number]: any}): BotData
	local animMaker = Workspace:FindFirstChild("animation-maker")
	local botModel: Model
	if animMaker then
		botModel = animMaker:Clone()
	else
		botModel = Instance.new("Model")
		local part = Instance.new("Part")
		part.Name = "HumanoidRootPart"
		part.Size = Vector3.new(2, 2, 1)
		part.Parent = botModel
		local hum = Instance.new("Humanoid")
		hum.Parent = botModel
	end

	botModel.Name = name

	for _, c in ipairs(botModel:GetDescendants()) do
		if c:IsA("LuaSourceContainer") or c:IsA("Tool") or c.Name == "PlayPrompt" then
			c:Destroy()
		end
	end

	local bodyColors = botModel:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.TorsoColor3 = Color3.fromRGB(math.random(50, 200), math.random(50, 200), math.random(50, 200))
	end

	botModel:PivotTo(CFrame.new(startPos))
	if gameplayArea then
		botModel.Parent = gameplayArea
	end

	local startMoney = (gameConfig and gameConfig.StartingMoney) or 20.00
	local maxHealth = (gameConfig and gameConfig.MaxHealth) or 100

	local botData: BotData = {
		UserId = id,
		Name = name,
		Money = startMoney,
		Wallet = startMoney,
		Health = maxHealth,
		IsAlive = true,
		IsAFK = false,
		ParticipationState = "Active",
		CurrentBid = 0,
		Votes = 0,
		IsBot = true,
		Character = botModel,
	}

	table.insert(activeBots, botData)
	if playerData then
		playerData[id] = botData
	end
	return botData
end

function BotManager.SetupCompanionBots(targetTotal: number, realEligibleCount: number, playerData: {[number]: any}): {BotData}
	BotManager.CleanupBots()
	local botsNeeded = math.max(0, targetTotal - realEligibleCount)
	if botsNeeded == 0 or not walkway then
		return activeBots
	end

	local wPos = walkway.Position
	for i = 1, botsNeeded do
		local bName = BOT_NAMES[i] or ("Bot_" .. i)
		local bId = -200 - i
		local angle = (i / math.max(1, botsNeeded)) * math.pi * 2
		local radius = 22 + (i % 3) * 14
		local spawnPos = Vector3.new(wPos.X + math.cos(angle) * radius, wPos.Y + 3.5, wPos.Z + math.sin(angle) * radius)
		BotManager.CreateBotDummy(bName, bId, spawnPos, playerData)
	end

	return activeBots
end

function BotManager.ScatterBots()
	if not walkway then return end
	local wPos = walkway.Position
	for i, b in ipairs(activeBots) do
		if b.IsAlive and b.Character then
			local angle = (i / math.max(1, #activeBots)) * math.pi * 2
			local radius = 22 + (i % 3) * 14
			b.Character:PivotTo(CFrame.new(wPos.X + math.cos(angle) * radius, wPos.Y + 3.5, wPos.Z + math.sin(angle) * radius))
		end
	end
end

function BotManager.GenerateBids(livingPlayers: {any})
	for _, d in ipairs(livingPlayers) do
		if d.IsBot and d.IsAlive then
			local walletCents = math.round((d.Money or 20) * 100)
			local maxBCents = math.min(walletCents, math.random(150, 650))
			d.CurrentBid = maxBCents / 100
			d.SubmitTime = math.random(80, 750) / 100
			d.Money = math.max(0, (walletCents - maxBCents) / 100)
			d.Wallet = d.Money
		end
	end
end

function BotManager.ResetParticipation()
	for _, bot in ipairs(activeBots) do
		if bot.IsAlive then
			bot.ParticipationState = "Active"
		end
	end
end

function BotManager.GetActiveBots(): {BotData}
	return activeBots
end

return BotManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">CashAndWalletManager</string>
        <string name="Source"><![CDATA[--!strict
-- src/server/economy/CashAndWalletManager.luau
-- Authoritative server economy manager for Bid-to-survive.
-- Separates Persistent Lobby Cash (Inventory Money) from In-Game Starting Wallet ($20).
-- Manages survival-time payout formula: Earned Cash = floor(Seconds Survived) * 20.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local CashAndWalletManager = {}

local STARTING_GAME_WALLET = 20 -- $20 given at the start of every game
local CASH_PER_SECOND_SURVIVED = 20 -- Survived Time (s) * 20 = Earned Cash

-- RemoteEvent for Payout Popup Animation in Lobby
local PayoutRemote: RemoteEvent = (ReplicatedStorage:FindFirstChild("CashPayoutEvent") :: any)
if not PayoutRemote then
	PayoutRemote = Instance.new("RemoteEvent")
	PayoutRemote.Name = "CashPayoutEvent"
	PayoutRemote.Parent = ReplicatedStorage
end

-- Persistent DataStore for Inventory/Overall Cash across sessions
local cashStore = nil
pcall(function()
	cashStore = DataStoreService:GetDataStore("BidToSurvive_OverallCash_v1")
end)

-- Active survival start timestamps per player for the current game
local gameStartTimestamps: { [Player]: number } = {}
local deathConnections: { [Player]: RBXScriptConnection } = {}

local function syncLeaderstats(player: Player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end

	local cashStat = ls:FindFirstChild("Cash") :: IntValue?
	if not cashStat then
		cashStat = Instance.new("IntValue")
		cashStat.Name = "Cash"
		cashStat.Parent = ls
	end
	cashStat.Value = player:GetAttribute("OverallCash") or 0

	-- Ensure Wallet is removed from leaderstats (only Cash is visible on leaderboard)
	local oldWallet = ls:FindFirstChild("Wallet")
	if oldWallet then
		oldWallet:Destroy()
	end
end

local function setupPlayerEconomy(player: Player)
	local savedCash = 0
	if cashStore and player.UserId > 0 then
		local ok, result = pcall(function()
			return cashStore:GetAsync("Player_" .. tostring(player.UserId))
		end)
		if ok and typeof(result) == "number" then
			savedCash = result
		end
	end

	player:SetAttribute("OverallCash", savedCash)
	player:SetAttribute("Wallet", STARTING_GAME_WALLET)
	player:SetAttribute("Money", STARTING_GAME_WALLET)
	player:SetAttribute("IsInGame", false)
	syncLeaderstats(player)

	player.AttributeChanged:Connect(function(attr)
		if attr == "OverallCash" or attr == "Wallet" then
			syncLeaderstats(player)
		end
	end)
end

local function savePlayerOverallCash(player: Player)
	if not cashStore or player.UserId <= 0 then return end
	local overall = player:GetAttribute("OverallCash") or 0
	pcall(function()
		cashStore:SetAsync("Player_" .. tostring(player.UserId), overall)
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(setupPlayerEconomy, p)
end
Players.PlayerAdded:Connect(setupPlayerEconomy)

Players.PlayerRemoving:Connect(function(player)
	gameStartTimestamps[player] = nil
	if deathConnections[player] then
		deathConnections[player]:Disconnect()
		deathConnections[player] = nil
	end
	savePlayerOverallCash(player)
end)

-- ============================================================================
-- 1. CALL WHEN A NEW GAME STARTS (Right before Round 1 begins!)
-- Gives every participating player $20 in their Bottom-Right Wallet & starts timer
-- ============================================================================
function CashAndWalletManager.StartGameForPlayers(activePlayers: { Player }?)
	local participants = activePlayers or Players:GetPlayers()
	local now = os.clock()

	for _, player in ipairs(participants) do
		if not player:GetAttribute("IsAFK") then
			-- Set $20 Starting Wallet & switch UI from Lobby (Left) to In-Game (Bottom-Right)
			player:SetAttribute("Wallet", STARTING_GAME_WALLET)
			player:SetAttribute("Money", STARTING_GAME_WALLET) -- Compatibility alias
			player:SetAttribute("CurrentBid", 0)
			player:SetAttribute("IsInGame", true)

			gameStartTimestamps[player] = now

			-- Automatically settle survival cash if the player dies mid-game
			if deathConnections[player] then
				deathConnections[player]:Disconnect()
				deathConnections[player] = nil
			end

			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				deathConnections[player] = hum.Died:Once(function()
					CashAndWalletManager.SettlePlayerGameCash(player, "Eliminated")
				end)
			end

			print(string.format("[Economy] 💵 %s entered Game with Wallet = $%d", player.Name, STARTING_GAME_WALLET))
		end
	end
end

-- Helper functions for exact integer-cent economy operations
local function toCents(dollars: number): number
	return math.round(dollars * 100)
end

local function toDollars(cents: number): number
	return cents / 100
end

-- ============================================================================
-- 2. SPEND FROM THE $20 WALLET DURING BIDDING PHASE
-- Authoritative integer-cent precision preventing floating-point truncation bugs!
-- ============================================================================
function CashAndWalletManager.TrySpendFromWallet(player: Player, bidAmount: number): (boolean, number)
	if typeof(bidAmount) ~= "number" or bidAmount ~= bidAmount or bidAmount <= 0 then
		return false, 0
	end

	local currentWallet = player:GetAttribute("Wallet") or 0
	local walletCents = toCents(currentWallet)
	local bidCents = toCents(bidAmount)

	-- Reject bids exceeding current wallet or non-positive
	if bidCents <= 0 or bidCents > walletCents then
		warn(string.format("[Economy] ❌ Rejected bid $%.2f from %s (Available wallet: $%.2f)", toDollars(bidCents), player.Name, toDollars(walletCents)))
		return false, 0
	end

	local newWalletCents = walletCents - bidCents
	local cleanBid = toDollars(bidCents)
	local newWallet = toDollars(newWalletCents)

	player:SetAttribute("Wallet", newWallet)
	player:SetAttribute("Money", newWallet)
	player:SetAttribute("CurrentBid", cleanBid)
	player:SetAttribute("BetTimestamp", os.clock())

	print(string.format("[Economy] 💵 Accepted bid $%.2f from %s. Deducted $%.2f (Previous wallet: $%.2f -> Remaining: $%.2f)",
		cleanBid, player.Name, cleanBid, toDollars(walletCents), newWallet))

	return true, cleanBid
end

-- ============================================================================
-- 3. SETTLE SURVIVAL PAYOUT WHEN PLAYER DIES OR GAME ENDS
-- Formula: Time Survived (seconds) * 20 = Earned Cash -> Added to Lobby OverallCash
-- ============================================================================
function CashAndWalletManager.SettlePlayerGameCash(player: Player, reason: string?): (number, number)
	local startTime = gameStartTimestamps[player]
	if not startTime then
		-- Already settled this game
		player:SetAttribute("IsInGame", false)
		return 0, 0
	end

	gameStartTimestamps[player] = nil
	if deathConnections[player] then
		deathConnections[player]:Disconnect()
		deathConnections[player] = nil
	end

	local secondsSurvived = math.max(0, math.floor(os.clock() - startTime))
	local earnedCash = secondsSurvived * CASH_PER_SECOND_SURVIVED
	local previousOverall = player:GetAttribute("OverallCash") or 0
	local newOverall = previousOverall + earnedCash

	-- Update Persistent Lifetime Cash & Reset Playable Session Wallet for Next Match
	player:SetAttribute("OverallCash", newOverall)
	player:SetAttribute("Wallet", STARTING_GAME_WALLET)
	player:SetAttribute("Money", STARTING_GAME_WALLET)
	player:SetAttribute("IsInGame", false)

	-- Notify Client UI to show the "+$Earned (Survived Xs * 20)" animation on the Left Side
	PayoutRemote:FireClient(player, earnedCash, secondsSurvived, newOverall, reason or "Game Over")

	task.spawn(savePlayerOverallCash, player)

	print(string.format(
		"[Economy] 🏆 %s (%s) Survived %ds * 20 = +$%d Earned! Total Lobby Cash = $%d",
		player.Name,
		reason or "Finished",
		secondsSurvived,
		earnedCash,
		newOverall
	))

	return earnedCash, secondsSurvived
end

-- ============================================================================
-- 4. CALL WHEN THE ENTIRE GAME ENDS (Settles all remaining survivors!)
-- ============================================================================
function CashAndWalletManager.EndGameAndRewardSurvivors()
	for _, player in ipairs(Players:GetPlayers()) do
		if gameStartTimestamps[player] then
			CashAndWalletManager.SettlePlayerGameCash(player, "Survived Game")
		else
			player:SetAttribute("IsInGame", false)
		end
	end
end

CashAndWalletManager.STARTING_GAME_WALLET = STARTING_GAME_WALLET
CashAndWalletManager.CASH_PER_SECOND_SURVIVED = CASH_PER_SECOND_SURVIVED

return CashAndWalletManager
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="22">
      <Properties>
        <string name="Name">GlobalLeaderboardManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- GlobalLeaderboardManager.server.luau
-- Manages the in-world GLOBOL-LEADERBOARD in SpawnArea displaying the Top 100 Cash Holders

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local RESULTS_BG_ASSET = "rbxassetid://136247699248783"
local DATA_STORE_NAME = "BidToSurvive_GlobalCash_v2"

local orderedStore: OrderedDataStore? = nil
pcall(function()
	orderedStore = DataStoreService:GetOrderedDataStore(DATA_STORE_NAME)
end)

-- Cache for username lookups to stay well within API rate limits
local usernameCache: { [number]: string } = {}

local function getUsernameFromUserId(userId: number): string
	if userId <= 0 then
		return "Contender_" .. math.abs(userId)
	end
	if usernameCache[userId] then
		return usernameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and typeof(name) == "string" and #name > 0 then
		usernameCache[userId] = name
		return name
	end
	return "Player_" .. tostring(userId)
end

local function formatCash(amount: number): string
	local formatted = string.format("$%.2f", amount)
	-- Format commas in thousands: e.g. $12,500.00
	local intPart, decPart = string.match(formatted, "^%$(%d+)(%.%d%d)$")
	if intPart and decPart then
		local k: string
		while true do
			intPart, k = string.gsub(intPart, "^(-?%d+)(%d%d%d)", "%1,%2")
			if k == 0 then break end
		end
		return "$" .. intPart .. decPart
	end
	return formatted
end

-- Find the target part in SpawnArea
local function getLeaderboardPart(): BasePart?
	local sa = Workspace:FindFirstChild("BidToSurviveMap", true) 
		and Workspace.BidToSurviveMap:FindFirstChild("SpawnArea")
	local lbModel = sa and sa:FindFirstChild("Leaderboard")
	if lbModel then
		local part = lbModel:FindFirstChild("LeaderStats(NOT SCRIPTED)") :: BasePart?
			or lbModel:FindFirstChild("LeaderboardDisplayPart") :: BasePart?
			or lbModel:FindFirstChildWhichIsA("BasePart")
		if part then return part end
	end
	-- Fallback search anywhere in Workspace
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") and (desc.Name == "LeaderStats(NOT SCRIPTED)" or desc.Name == "LeaderboardDisplayPart") then
			return desc
		end
	end
	return nil
end

local function setupSurfaceGui(part: BasePart): (SurfaceGui, ScrollingFrame)
	local existing = part:FindFirstChild("GlobalLeaderboardGui") :: SurfaceGui?
	if existing then
		existing:Destroy()
	end

	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "GlobalLeaderboardGui"
	surfaceGui.Face = Enum.NormalId.Back -- Faces spawn area
	surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	surfaceGui.CanvasSize = Vector2.new(800, 1000) -- Clean 18x22 aspect ratio with high legibility
	surfaceGui.LightInfluence = 0
	surfaceGui.AlwaysOnTop = false
	surfaceGui.ToolPunchThroughDistance = 1000
	surfaceGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Outer Container with 3D Pop-Art Border
	local mainCard = Instance.new("Frame")
	mainCard.Name = "MainCard"
	mainCard.Size = UDim2.new(1, 0, 1, 0)
	mainCard.Position = UDim2.new(0, 0, 0, 0)
	mainCard.BackgroundColor3 = Color3.fromRGB(242, 118, 16)
	mainCard.BorderSizePixel = 0
	mainCard.Parent = surfaceGui

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = Color3.fromRGB(0, 0, 0)
	cardStroke.Thickness = 8
	cardStroke.Parent = mainCard

	-- Orange Texture Background
	local bgImg = Instance.new("ImageLabel")
	bgImg.Name = "BgImg"
	bgImg.Size = UDim2.new(1, 0, 1, 0)
	bgImg.BackgroundTransparency = 1
	bgImg.Image = RESULTS_BG_ASSET
	bgImg.ScaleType = Enum.ScaleType.Crop
	bgImg.ZIndex = 1
	bgImg.Parent = mainCard

	-- Header Panel
	local headerPanel = Instance.new("Frame")
	headerPanel.Name = "HeaderPanel"
	headerPanel.Size = UDim2.new(1, -28, 0, 130)
	headerPanel.Position = UDim2.new(0, 14, 0, 14)
	headerPanel.BackgroundColor3 = Color3.fromRGB(18, 14, 12)
	headerPanel.BorderSizePixel = 0
	headerPanel.ZIndex = 2
	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 12)
	hpCorner.Parent = headerPanel
	local hpStroke = Instance.new("UIStroke")
	hpStroke.Color = Color3.fromRGB(255, 185, 35)
	hpStroke.Thickness = 4
	hpStroke.Parent = headerPanel
	headerPanel.Parent = mainCard

	local mainTitle = Instance.new("TextLabel")
	mainTitle.Size = UDim2.new(1, 0, 0, 64)
	mainTitle.Position = UDim2.new(0, 0, 0, 8)
	mainTitle.BackgroundTransparency = 1
	mainTitle.Text = "GLOBAL TOP 100 CASH"
	mainTitle.Font = Enum.Font.FredokaOne
	mainTitle.TextSize = 58
	mainTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	mainTitle.ZIndex = 3
	local mtStroke = Instance.new("UIStroke")
	mtStroke.Color = Color3.fromRGB(0, 0, 0)
	mtStroke.Thickness = 5.5
	mtStroke.Parent = mainTitle
	mainTitle.Parent = headerPanel

	local subTitle = Instance.new("TextLabel")
	subTitle.Size = UDim2.new(1, 0, 0, 36)
	subTitle.Position = UDim2.new(0, 0, 0, 74)
	subTitle.BackgroundTransparency = 1
	subTitle.Text = "★ ALL-TIME RICHEST SURVIVORS • SCROLL DOWN FOR ALL 100 ★"
	subTitle.Font = Enum.Font.GothamBlack
	subTitle.TextSize = 22
	subTitle.TextColor3 = Color3.fromRGB(255, 215, 80)
	subTitle.ZIndex = 3
	subTitle.Parent = headerPanel

	-- Columns Title Bar
	local colBar = Instance.new("Frame")
	colBar.Name = "ColBar"
	colBar.Size = UDim2.new(1, -28, 0, 48)
	colBar.Position = UDim2.new(0, 14, 0, 152)
	colBar.BackgroundColor3 = Color3.fromRGB(25, 20, 18)
	colBar.BorderSizePixel = 0
	colBar.ZIndex = 2
	local cbCorner = Instance.new("UICorner")
	cbCorner.CornerRadius = UDim.new(0, 8)
	cbCorner.Parent = colBar
	local cbStroke = Instance.new("UIStroke")
	cbStroke.Color = Color3.fromRGB(0, 0, 0)
	cbStroke.Thickness = 2
	cbStroke.Parent = colBar

	local function makeColHeader(text: string, size: UDim2, pos: UDim2, align: Enum.TextXAlignment)
		local lbl = Instance.new("TextLabel")
		lbl.Size = size
		lbl.Position = pos
		lbl.BackgroundTransparency = 1
