      <Item class="Script" referent="36">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- StarterCharacterScripts/Health.server.luau
-- Disables Roblox's default passive health regeneration.
-- Health in "Bid to Survive" only resets to 100 at the start of a brand-new match (CurrentRound == 0).
-- Damage sustained in Round 1 carries over into subsequent rounds without passive healing.

-- Do nothing: deliberately omit any Humanoid.Health regeneration loop.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">GlobalButtonAndSVG3UI</string>
          <string name="Source"><![CDATA[-- StarterPlayer/StarterPlayerScripts/GlobalButtonAndSVG3UI.client.luau
-- Universal SVG.3 Styling & Game-Wide Tactile Button Micro-Interactions Engine

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ============================================================================
-- 1. GLOBAL UI SOUND PALETTE (Hover Tick & Click Pop)
-- ============================================================================
local hoverSound = SoundService:FindFirstChild("GlobalUIHoverSound") :: Sound?
if not hoverSound then
	hoverSound = Instance.new("Sound")
	hoverSound.Name = "GlobalUIHoverSound"
	hoverSound.SoundId = "rbxassetid://6895079853" -- Crisp subtle UI hover tick
	hoverSound.Volume = 0.35
	hoverSound.PlaybackSpeed = 1.15
	hoverSound.Parent = SoundService
end

local clickPopSound = SoundService:FindFirstChild("GlobalUIClickPopSound") :: Sound?
if not clickPopSound then
	clickPopSound = Instance.new("Sound")
	clickPopSound.Name = "GlobalUIClickPopSound"
	clickPopSound.SoundId = "rbxassetid://6895079853" -- Tactile pop on click
	clickPopSound.Volume = 0.65
	clickPopSound.PlaybackSpeed = 0.92
	clickPopSound.Parent = SoundService
end

-- ============================================================================
-- 2. UNIVERSAL HOVER & CLICK POP ENGINE (Applies to EVERY Button in the Game!)
-- ============================================================================
local hookedButtons: { [GuiButton]: boolean } = {}

local function attachGlobalHoverAndClickPop(button: GuiButton)
	if hookedButtons[button] then return end
	hookedButtons[button] = true

	button.AutoButtonColor = false

	-- Ensure UIScale exists for smooth Hover & Click Pop
	local uiScale = button:FindFirstChild("InteractionScale") :: UIScale?
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "InteractionScale"
		uiScale.Scale = 1.0
		uiScale.Parent = button
	end

	-- Glossy Flash Overlay for Hover & Click Pop punch
	local flashOverlay = button:FindFirstChild("ClickFlashOverlay") :: Frame?
	if not flashOverlay then
		flashOverlay = Instance.new("Frame")
		flashOverlay.Name = "ClickFlashOverlay"
		flashOverlay.Size = UDim2.fromScale(1, 1)
		flashOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		flashOverlay.BackgroundTransparency = 1
		flashOverlay.BorderSizePixel = 0
		flashOverlay.ZIndex = button.ZIndex + 1
		flashOverlay.Active = false
		flashOverlay.Parent = button

		local existingCorner = button:FindFirstChildOfClass("UICorner")
		if existingCorner then
			existingCorner:Clone().Parent = flashOverlay
		end
	end

	local isHovered = false

	-- HOVER ENTER (0.16s - 1.07x Scale + Sheen Lift + Hover Tick)
	button.MouseEnter:Connect(function()
		isHovered = true
		pcall(function() hoverSound:Play() end)

		TweenService:Create(uiScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1.07
		}):Play()

		TweenService:Create(flashOverlay, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 0.88
		}):Play()

		local grad = button:FindFirstChildOfClass("UIGradient")
		if grad then
			TweenService:Create(grad, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Offset = Vector2.new(0, -0.06)
			}):Play()
		end
	end)

	-- HOVER LEAVE (0.18s - Reset Scale & Gradient Offset)
	button.MouseLeave:Connect(function()
		isHovered = false

		TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 1.0
		}):Play()

		TweenService:Create(flashOverlay, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1.0
		}):Play()

		local grad = button:FindFirstChildOfClass("UIGradient")
		if grad then
			TweenService:Create(grad, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Offset = Vector2.new(0, 0)
			}):Play()
		end
	end)

	-- CLICK PRESS DOWN (0.06s Squash to 0.90x)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(uiScale, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 0.90
		}):Play()
	end)

	-- CLICK RELEASE POP (Overshoot 1.13x -> Settle to 1.07x / 1.00x + Flash Pulse)
	button.MouseButton1Up:Connect(function()
		pcall(function() clickPopSound:Play() end)

		-- Bright white pop flash (0.45 -> settle)
		flashOverlay.BackgroundTransparency = 0.45
		TweenService:Create(flashOverlay, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = isHovered and 0.88 or 1.0
		}):Play()

		-- Overshoot to 1.13x then settle
		local popUp = TweenService:Create(uiScale, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 1.13
		})
		popUp:Play()
		popUp.Completed:Once(function()
			TweenService:Create(uiScale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = isHovered and 1.07 or 1.0
			}):Play()
		end)
	end)
end

-- ============================================================================
-- 3. EXACT SVG.3 STYLE BUILDER (Red-to-Silver Gradient + 5px Black Stroke)
-- ============================================================================
local function applySVG3ButtonStyle(button: TextButton, labelText: string, textSize: number?)
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- White base allows UIGradient 1:1 color fidelity
	button.BackgroundTransparency = 0
	button.BorderSizePixel = 0
	button.Text = "" -- Keep native text blank so UIGradient does NOT tint text red

	-- Sharp rectangular silhouette matching svg.3 (0px - 2px)
	local corner = button:FindFirstChildOfClass("UICorner")
	if not corner then
		corner = Instance.new("UICorner")
		corner.Parent = button
	end
	corner.CornerRadius = UDim.new(0, 1)

	-- Solid Pitch-Black outer border: UIStroke with Thickness = 4, ApplyStrokeMode = Border, LineJoinMode = Miter
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.Parent = button
	end
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Miter

	-- Exact Vertical Red-to-Metallic-Silver Gradient from svg.3
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Parent = button
	end
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromHex("#EC0000")), -- Vivid Crimson Top
		ColorSequenceKeypoint.new(0.54, Color3.fromHex("#F50505")), -- Pure Red Mid-Core
		ColorSequenceKeypoint.new(0.78, Color3.fromHex("#E25A5A")), -- Coral Transition
		ColorSequenceKeypoint.new(1.00, Color3.fromHex("#D6C7C7")), -- Metallic Silver-Blush Bottom
	})
	gradient.Enabled = true

	-- Independent Crisp White TextLabel (Guaranteed unaffected by UIGradient)
	local label = button:FindFirstChild("BtnLabel") :: TextLabel?
	if not label then
		label = Instance.new("TextLabel")
		label.Name = "BtnLabel"
		label.Size = UDim2.fromScale(1, 1)
		label.Position = UDim2.fromScale(0, 0)
		label.BackgroundTransparency = 1
		label.ZIndex = button.ZIndex + 3
		label.Parent = button
	end
	label.Text = labelText
	label.Font = Enum.Font.GothamMedium
	label.TextSize = textSize or 24
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center

	attachGlobalHoverAndClickPop(button)
end

-- ============================================================================
-- 4. STYLE & POSITION "BID" AND "LEADERBOARD" IN MIDDLE & SLIGHTLY UP (0.5, 0.42)
-- ============================================================================
local function upgradeBidAndLeaderboardButtons()
	local centerDock = playerGui:FindFirstChild("CenterActionDock", true) :: Frame?
		or playerGui:FindFirstChild("ReopenContainer", true) :: Frame?

	if centerDock then
		centerDock.Name = "CenterActionDock"
		centerDock.AnchorPoint = Vector2.new(0.5, 0.5)
		centerDock.Position = UDim2.new(0.5, 0, 0.25, 0) -- Middle of upper half (Y = 0.25)
		centerDock.Size = UDim2.new(0, 184, 0, 50)
		centerDock.BackgroundTransparency = 1

		local bidButton = centerDock:FindFirstChild("ReopenBidBtn") :: TextButton?
			or centerDock:FindFirstChild("BidButton") :: TextButton?
		local leaderboardButton = centerDock:FindFirstChild("ReopenRankBtn") :: TextButton?
			or centerDock:FindFirstChild("LeaderboardButton") :: TextButton?

		if bidButton then
			applySVG3ButtonStyle(bidButton, "BID", 24)
			bidButton.AnchorPoint = Vector2.new(0.5, 0.5)
			bidButton.Size = UDim2.new(0, 184, 0, 50)
			bidButton.Position = UDim2.new(0.5, 0, 0.5, 0)
		end

		if leaderboardButton then
			applySVG3ButtonStyle(leaderboardButton, "LEADERBOARD", 18)
			leaderboardButton.AnchorPoint = Vector2.new(0.5, 0.5)
			leaderboardButton.Size = UDim2.new(0, 184, 0, 50)
			leaderboardButton.Position = UDim2.new(0.5, 0, 0.5, 0)
		end
	end

	-- Also style modal SubmitBtn cleanly inside BidBtnContainer
	local modal = playerGui:FindFirstChild("BiddingModal", true)
	local card = modal and modal:FindFirstChild("CardFrame")
	local btnContainer = card and card:FindFirstChild("BidBtnContainer")
	local submitBtn = btnContainer and btnContainer:FindFirstChild("SubmitBtn") :: TextButton?
	if submitBtn then
		applySVG3ButtonStyle(submitBtn, "BID", 24)
		btnContainer.AnchorPoint = Vector2.new(0.5, 0.5)
		btnContainer.Position = UDim2.new(0.5, 0, 0.68, 0)
		btnContainer.Size = UDim2.new(0, 184, 0, 48)

		local shadow = btnContainer:FindFirstChild("BtnShadow")
		if shadow then
			shadow.AnchorPoint = Vector2.new(0.5, 0.5)
			shadow.Position = UDim2.new(0.5, 3, 0.5, 3)
			shadow.Size = UDim2.new(1, 0, 1, 0)
			shadow.ZIndex = 25
		end

		submitBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		submitBtn.Position = UDim2.new(0.5, 0, 0.5, 0)
		submitBtn.Size = UDim2.new(1, 0, 1, 0)
		submitBtn.ZIndex = 26
	end
end

-- ============================================================================
-- 5. HOOK ALL EXISTING & FUTURE BUTTONS ACROSS THE ENTIRE GAME
-- ============================================================================
for _, desc in ipairs(playerGui:GetDescendants()) do
	if desc:IsA("GuiButton") then
		attachGlobalHoverAndClickPop(desc)
	end
end

upgradeBidAndLeaderboardButtons()

playerGui.DescendantAdded:Connect(function(desc)
	if desc:IsA("GuiButton") then
		task.defer(function()
			attachGlobalHoverAndClickPop(desc)
			local nameLower = string.lower(desc.Name)
			if desc:IsA("TextButton") and (string.find(nameLower, "bid") or string.find(nameLower, "rank") or string.find(nameLower, "leaderboard")) then
				upgradeBidAndLeaderboardButtons()
			end
		end)
	end
end)

print("[GlobalButtonAndSVG3UI] Universal Hover & Click Pop Engine & SVG.3 Button System active.")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">GorillaImpactClient</string>
          <string name="Source"><![CDATA[--!strict
-- GorillaImpactClient: Listens for Gorilla boss impact frame. Spawns procedural crater debris,
-- dual shockwave rings, 3D decaying camera trauma, and spatial sub-bass audio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- Locate RemoteEvent
local Network = ReplicatedStorage:WaitForChild("Network", 10)
local ImpactRemote = (Network and Network:WaitForChild("GorillaImpactEvent", 10))
	or ReplicatedStorage:WaitForChild("GorillaImpactEvent", 10)

if not ImpactRemote then
	warn("[GorillaImpactClient] GorillaImpactEvent not found!")
	return
end

-- Lighting ColorCorrection effect for impact flash
local impactColorCorrection = Lighting:FindFirstChild("GorillaImpactCC")
if not impactColorCorrection then
	impactColorCorrection = Instance.new("ColorCorrectionEffect")
	impactColorCorrection.Name = "GorillaImpactCC"
	impactColorCorrection.Parent = Lighting
end

local function playImpactAudio(impactPos: Vector3)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = impactPos
	attachment.Parent = Workspace.Terrain

	local slamSound = Instance.new("Sound")
	slamSound.Name = "EarthSlamSound"
	slamSound.SoundId = "rbxassetid://9120386436" -- Heavy explosion / ground impact thud
	slamSound.Volume = 2.4
	slamSound.PlaybackSpeed = 0.85
	slamSound.RollOffMaxDistance = 300
	slamSound.RollOffMode = Enum.RollOffMode.Linear
	slamSound.Parent = attachment
	slamSound:Play()

	task.delay(4, function()
		attachment:Destroy()
	end)
end

local function spawnShockwaveAndDebris(impactPos: Vector3, floorColor: Color3, floorMaterial: Enum.Material, arenaRadius: number)
	local folder = Instance.new("Folder")
	folder.Name = "GorillaSmashVFX"
	folder.Parent = Workspace

	local maxRadius = math.clamp(arenaRadius or 50, 30, 100)

	-- 1. Inner High-Energy Core Shockwave (#FF8C24, Neon)
	local coreRing = Instance.new("Part")
	coreRing.Name = "CoreShockwave"
	coreRing.Shape = Enum.PartType.Cylinder
	coreRing.Anchored = true
	coreRing.CanCollide = false
	coreRing.CastShadow = false
	coreRing.Material = Enum.Material.Neon
	coreRing.Color = Color3.fromRGB(255, 140, 36)
	coreRing.Size = Vector3.new(0.4, 4, 4)
	coreRing.CFrame = CFrame.new(impactPos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	coreRing.Parent = folder

	TweenService:Create(coreRing, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, maxRadius * 0.95, maxRadius * 0.95),
		Transparency = 1
	}):Play()

	-- 2. Outer Dust Shockwave (#D9D2C5, SmoothPlastic)
	local dustRing = Instance.new("Part")
	dustRing.Name = "DustShockwave"
	dustRing.Shape = Enum.PartType.Cylinder
	dustRing.Anchored = true
	dustRing.CanCollide = false
	dustRing.CastShadow = false
	dustRing.Material = Enum.Material.SmoothPlastic
	dustRing.Color = Color3.fromRGB(217, 210, 197)
	dustRing.Transparency = 0.25
	dustRing.Size = Vector3.new(1.2, 6, 6)
	dustRing.CFrame = CFrame.new(impactPos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	dustRing.Parent = folder

	TweenService:Create(dustRing, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, maxRadius * 1.15, maxRadius * 1.15),
		Transparency = 1
	}):Play()

	-- 3. Procedural Crater Chunks (inherits GameplayArea color & material)
	local numChunks = 14
	for i = 1, numChunks do
		local angle = (i / numChunks) * math.pi * 2 + (math.random(-15, 15) * 0.01)
		local radiusOffset = math.random(8, 16)
		local spawnOffset = Vector3.new(math.cos(angle) * radiusOffset, -1.5, math.sin(angle) * radiusOffset)
		local targetPos = impactPos + Vector3.new(math.cos(angle) * (radiusOffset + 5), 0.8, math.sin(angle) * (radiusOffset + 5))

		local rock = Instance.new("Part")
		rock.Name = "CraterDebris"
		rock.Anchored = true
		rock.CanCollide = false
		rock.CastShadow = true
		rock.Color = floorColor
		rock.Material = floorMaterial
		rock.Size = Vector3.new(math.random(25, 50) / 10, math.random(15, 35) / 10, math.random(25, 50) / 10)
		rock.CFrame = CFrame.lookAt(impactPos + spawnOffset, impactPos)
			* CFrame.Angles(
				math.rad(math.random(-35, 35)),
				math.rad(math.random(-25, 25)),
				math.rad(math.random(-30, 30))
			)
		rock.Parent = folder

		-- Burst up out of the floor
		local popUp = TweenService:Create(rock, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = targetPos
		})
		popUp:Play()

		-- Sink back into floor after 1.1s
		task.delay(1.1 + (math.random() * 0.35), function()
			if rock.Parent then
				local sink = TweenService:Create(rock, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = targetPos - Vector3.new(0, 4.0, 0),
					Transparency = 1
				})
				sink:Play()
			end
		end)
	end

	task.delay(2.5, function()
		folder:Destroy()
	end)
end

local activeShakeConn: RBXScriptConnection? = nil

local function shakeCamera(impactPos: Vector3)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local dist = root and (root.Position - impactPos).Magnitude or 40
	local intensity = math.clamp(1 - (dist / 140), 0.25, 1) * 2.4

	-- Contrast flash and crimson impact punch
	impactColorCorrection.Contrast = 0.38 * intensity
	impactColorCorrection.TintColor = Color3.fromRGB(255, 210, 205)

	TweenService:Create(impactColorCorrection, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Contrast = 0,
		TintColor = Color3.fromRGB(255, 255, 255)
	}):Play()

	if activeShakeConn then
		activeShakeConn:Disconnect()
		activeShakeConn = nil
	end

	local startTime = os.clock()
	local duration = 0.48
	activeShakeConn = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime
		if elapsed >= duration then
			if activeShakeConn then
				activeShakeConn:Disconnect()
				activeShakeConn = nil
			end
			return
		end

		local alpha = 1 - (elapsed / duration)
		local damper = alpha * alpha * intensity
		local offset = Vector3.new(
			(math.random() - 0.5) * damper * 1.2,
			(math.random() - 0.5) * damper * 1.5,
			(math.random() - 0.5) * damper * 1.2
		)
		camera.CFrame = camera.CFrame * CFrame.new(offset) * CFrame.Angles(
			math.rad((math.random() - 0.5) * damper * 2.0),
			0,
			math.rad((math.random() - 0.5) * damper * 2.0)
		)
	end)
end

-- Authoritative 91-frame motion data for Gorilla-gem
local GorillaMotionData = require(ReplicatedStorage:WaitForChild("GorillaMotionData"))
local frames: {{number}} = GorillaMotionData

local function findGorillaModel(): Model?
	return Workspace:FindFirstChild("Gorilla-gem")
		or Workspace:FindFirstChild("Gorilla-gem", true)
		or Workspace:FindFirstChild("MainGorilla", true)
end

local function findBone(parent: Instance, name: string): Bone?
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("Bone") then
			if child.Name == name then return child end
			local f = findBone(child, name)
			if f then return f end
		end
	end
	return nil
end

local function ang(x: number, y: number, z: number): CFrame
	return CFrame.fromEulerAnglesXYZ(x, y, z)
end

local isClientSmashing = false

local function playGorillaSmashAnimation(impactPos: Vector3, floorColor: Color3, floorMaterial: Enum.Material, arenaRadius: number)
	if isClientSmashing then return end
	isClientSmashing = true

	local gorillaModel = findGorillaModel()
	if not gorillaModel then
		warn("[GorillaClient] Gorilla-gem not found for client animation!")
		isClientSmashing = false
		return
	end

	local char1 = gorillaModel:FindFirstChild("char1", true)
	if not char1 then
		warn("[GorillaClient] char1 MeshPart not found in Gorilla-gem!")
		isClientSmashing = false
		return
	end

	local cachedBones = {
		Hips = findBone(char1, "Hips"),
		Spine = findBone(char1, "Spine"),
		Head = findBone(char1, "Head"),
		RightArm = findBone(char1, "RightArm"),
		RightForeArm = findBone(char1, "RightForeArm"),
		RightHand = findBone(char1, "RightHand"),
		LeftArm = findBone(char1, "LeftArm"),
		LeftForeArm = findBone(char1, "LeftForeArm"),
		LeftHand = findBone(char1, "LeftHand"),
		RightUpLeg = findBone(char1, "RightUpLeg"),
		RightLeg = findBone(char1, "RightLeg"),
		RightFoot = findBone(char1, "RightFoot"),
		LeftUpLeg = findBone(char1, "LeftUpLeg"),
		LeftLeg = findBone(char1, "LeftLeg"),
		LeftFoot = findBone(char1, "LeftFoot"),
	}

	-- Play hammer swing audio on handle
	local hammer = gorillaModel:FindFirstChild("Thors Hammer", true) or Workspace:FindFirstChild("Thors Hammer")
	local handle = hammer and hammer:FindFirstChild("Handle")
	if handle then
		local swingSound = handle:FindFirstChild("SwingSound") or handle:FindFirstChild("slash")
		if swingSound and swingSound:IsA("Sound") then
			swingSound:Play()
		end
	end

	task.spawn(function()
		local totalFrames = #frames
		local fps = 30
		local frameDur = 1 / fps
		local IMPACT_FRAME = 40

		print(string.format("[GorillaClient] 🎬 Starting client-side 91-frame bone playback (%d frames @ 30 FPS)...", totalFrames))

		for i = 1, totalFrames do
			local fd = frames[i]
			if not fd then continue end

			local dx, dy, dz = fd[2], fd[3], fd[4]
			local rrx, rry, rrz = fd[5], fd[6], fd[7]

			if cachedBones.Hips then
				cachedBones.Hips.Transform = CFrame.new(dx, dy, dz) * ang(rrx, rry, rrz)
			end
			if cachedBones.Spine then cachedBones.Spine.Transform = ang(fd[8], fd[9], fd[10]) end
			if cachedBones.Head then cachedBones.Head.Transform = ang(fd[11], fd[12], fd[13]) end

			if cachedBones.RightArm then cachedBones.RightArm.Transform = ang(fd[14], fd[15], fd[16]) end
			if cachedBones.RightForeArm then cachedBones.RightForeArm.Transform = ang(fd[17], fd[18], fd[19]) end
			if cachedBones.RightHand then cachedBones.RightHand.Transform = ang(fd[20], fd[21], fd[22]) end

			if cachedBones.LeftArm then cachedBones.LeftArm.Transform = ang(fd[23], fd[24], fd[25]) end
			if cachedBones.LeftForeArm then cachedBones.LeftForeArm.Transform = ang(fd[26], fd[27], fd[28]) end
			if cachedBones.LeftHand then cachedBones.LeftHand.Transform = ang(fd[29], fd[30], fd[31]) end

			if cachedBones.RightUpLeg then cachedBones.RightUpLeg.Transform = ang(fd[32], fd[33], fd[34]) end
			if cachedBones.RightLeg then cachedBones.RightLeg.Transform = ang(fd[35], fd[36], fd[37]) end
			if cachedBones.RightFoot then cachedBones.RightFoot.Transform = ang(fd[38], fd[39], fd[40]) end

			if cachedBones.LeftUpLeg then cachedBones.LeftUpLeg.Transform = ang(fd[41], fd[42], fd[43]) end
			if cachedBones.LeftLeg then cachedBones.LeftLeg.Transform = ang(fd[44], fd[45], fd[46]) end
			if cachedBones.LeftFoot then cachedBones.LeftFoot.Transform = ang(fd[47], fd[48], fd[49]) end

			-- Frame 40: EXACT GROUND SMASH IMPACT!
			if i == IMPACT_FRAME then
				print(string.format("[GorillaClient] 💥💥💥 FRAME %d GROUND SMASH IMPACT! 💥💥💥", i))
				playImpactAudio(impactPos)
				spawnShockwaveAndDebris(impactPos, floorColor, floorMaterial, arenaRadius)
				shakeCamera(impactPos)
				task.wait(0.12) -- 0.12s hit-stop freeze on impact
			else
				task.wait(frameDur)
			end
		end

		print("[GorillaClient] 🎬 Smash motion finished. Blending bones back to rest pose.")

		-- Smoothly blend back to rest pose
		local steps = 8
		for s = 1, steps do
			local alpha = 1 - (s / steps)
			for _, bone in pairs(cachedBones) do
				if bone then
					bone.Transform = bone.Transform:Lerp(CFrame.new(), 1 - alpha)
				end
			end
			task.wait(0.03)
		end

		for _, bone in pairs(cachedBones) do
			if bone then
				bone.Transform = CFrame.new()
			end
		end

		isClientSmashing = false
		print("[GorillaClient] 🎬 Rest pose restored.")
	end)
end

ImpactRemote.OnClientEvent:Connect(function(actionOrPos: any, p2: any, p3: any, p4: any, p5: any)
	if actionOrPos == "SMASH_START" then
		local impactPos: Vector3 = p2 or Vector3.new(0, 0, 0)
		local floorColor: Color3 = p3 or Color3.fromRGB(115, 110, 100)
		local floorMaterial: Enum.Material = p4 or Enum.Material.Slate
		local arenaRadius: number = p5 or 45
		playGorillaSmashAnimation(impactPos, floorColor, floorMaterial, arenaRadius)
	elseif typeof(actionOrPos) == "Vector3" then
		-- Legacy fallback: direct impact trigger
		local impactPos: Vector3 = actionOrPos
		local floorColor: Color3 = p2 or Color3.fromRGB(115, 110, 100)
		local floorMaterial: Enum.Material = p3 or Enum.Material.Slate
		local arenaRadius: number = p4 or 45
		print(string.format("[GorillaClient] 💥 GorillaImpactEvent received! Impact pos: %s | Radius: %.1f", tostring(impactPos), arenaRadius))
		playImpactAudio(impactPos)
		spawnShockwaveAndDebris(impactPos, floorColor, floorMaterial, arenaRadius)
		shakeCamera(impactPos)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="40">
        <Properties>
          <string name="Name">MovementDiveAndHUDClient</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayer/StarterPlayerScripts/MovementDiveAndHUDClient.client.luau
-- Authoritative client movement controller, High-Speed Jetpack Burst, and unified status HUD for Bid-to-survive.
-- Features:
-- 1. Custom Walk (90697464892050) & Run (125757170550820)
-- 2. Spacebar Jetpack Burst (15 studs, blazing speed acceleration, pure white backside & thruster speed trails, upright posture)
-- 3. Unified Stacked HUD (Money, HP, and Pure White Energy Bar)
-- 4. Guaranteed Game-2 HP re-bind lifecycle

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")

local StarterGui = game:GetService("StarterGui")

-- Guarantee default Roblox top-right Health Bar is eliminated
task.spawn(function()
	local maxRetries = 20
	while maxRetries > 0 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then break end
		task.wait(0.2)
		maxRetries -= 1
	end
end)

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local Network = ReplicatedStorage:FindFirstChild("Network")
local ResetHUDRemote: RemoteEvent? = (Network and Network:FindFirstChild("ResetHUDStateEvent") :: RemoteEvent?)
	or (ReplicatedStorage:FindFirstChild("ResetHUDStateEvent") :: RemoteEvent?)

local StatsUpdated: RemoteEvent? = (Network and Network:FindFirstChild("StatsUpdated") :: RemoteEvent?)
	or (ReplicatedStorage:FindFirstChild("StatsUpdated") :: RemoteEvent?)

local ClientLoadReadyEvent: RemoteEvent? = (Network and Network:FindFirstChild("ClientLoadReadyEvent") :: RemoteEvent?)
	or (ReplicatedStorage:FindFirstChild("ClientLoadReadyEvent") :: RemoteEvent?)
if not ClientLoadReadyEvent then
	ClientLoadReadyEvent = Instance.new("RemoteEvent")
	ClientLoadReadyEvent.Name = "ClientLoadReadyEvent"
	ClientLoadReadyEvent.Parent = Network or ReplicatedStorage
end

local JetpackBurstEvent: RemoteEvent? = (Network and Network:FindFirstChild("JetpackBurstEvent") :: RemoteEvent?)
	or (ReplicatedStorage:FindFirstChild("JetpackBurstEvent") :: RemoteEvent?)

local JetpackBurstReplicatedEvent: RemoteEvent? = (Network and Network:FindFirstChild("JetpackBurstReplicatedEvent") :: RemoteEvent?)
	or (ReplicatedStorage:FindFirstChild("JetpackBurstReplicatedEvent") :: RemoteEvent?)

-- ============================================================================
-- 1. ANIMATION IDs & MOVEMENT TUNING
-- ============================================================================
-- R6 Custom Author Animations (Authored by sai_charank)
local R6_WALK_ANIM_ID = "rbxassetid://90697464892050"
local R6_RUN_ANIM_ID  = "rbxassetid://125757170550820"

-- R15 Compatible Animations (Used if avatar spawns as R15)
local R15_WALK_ANIM_ID = "rbxassetid://913402848"
local R15_RUN_ANIM_ID  = "rbxassetid://913376220"

local currentWalkAnimId = R6_WALK_ANIM_ID
local currentRunAnimId  = R6_RUN_ANIM_ID

local BASE_WALK_SPEED           = 14
local SPRINT_WALK_SPEED         = 21

-- High-Speed Jetpack Burst Tuning:
-- Explodes speed forward to 85 studs/sec until exactly 15 studs traveled
local JETPACK_BURST_DISTANCE    = 15.0
local JETPACK_BURST_SPEED       = 85.0 -- High-speed acceleration feeling (4x sprint speed!)
local JETPACK_COOLDOWN          = 1.25
local JETPACK_ENERGY_COST       = 20

-- ============================================================================
-- JETPACK BURST SOUND & TIMING TUNING (Tweak these constants anytime!)
-- ============================================================================
local JETPACK_BURST_SOUND_ID       = "rbxasset://sounds/jetpack-sound.mp3"
local JETPACK_BURST_VOLUME         = 0.90
local JETPACK_PLAYBACK_SPEED       = 1.35 -- Playback speed multiplier (1.35X)
local JETPACK_SOUND_START_OFFSET   = 0.10 -- [CUT FRONT]: Skips first 0.10s of audio (removes slow wind-up/silence)
local JETPACK_SOUND_CUT_LAST       = 0.70 -- [CUT BACK]: Cuts trailing audio at end of sound (0.50s)
local JETPACK_SOUND_FADE_DURATION  = 0.80 -- [FADE DURATION]: Audio time (in seconds) used to smoothly fade out volume from full to 0
local JETPACK_PRE_LAUNCH_DELAY     = 0.02 -- [LAUNCH DELAY]: Delay before movement launches (0.02s = instant launch!)

-- Energy Settings (White / Cyan EP Bar)
local MAX_ENERGY        = 100
local SPRINT_DRAIN_RATE = 18 -- Energy drained per second while running
local ENERGY_REGEN_RATE = 18 -- Energy regenerated per second when walking/idle

local currentEnergy     = MAX_ENERGY
local isHoldingShift    = false
local isSprinting       = false
local isBursting        = false
local lastBurstTime     = 0
local exhaustedLockout  = false
local lastMovementState = "None"

-- Active Character References
local activeChar: Model?        = nil
local activeHum: Humanoid?      = nil
local activeHRP: BasePart?       = nil
local walkTrack: AnimationTrack? = nil
local runTrack: AnimationTrack?  = nil
local healthConn: RBXScriptConnection? = nil

-- ============================================================================
-- 2. UNIFIED HP, ENERGY & DYNAMIC LOBBY/GAME CURRENCY HUD (STATUS HUD VIEW)
-- ============================================================================
local ClientUI = ReplicatedStorage:WaitForChild("ClientUI")
local StatusHUDView = require(ClientUI:WaitForChild("components"):WaitForChild("StatusHUDView")) :: any
local statusHUD = StatusHUDView.new(player)

local function updateHPDisplay(health: number, maxHealth: number)
	statusHUD:UpdateHealth(health, maxHealth)
end

local function updateCurrencyUI()
	local isInGame = (player:GetAttribute("IsInGame") == true)
	local overallCash = player:GetAttribute("OverallCash") or 0
	local matchWallet = player:GetAttribute("Wallet") or 20
	statusHUD:UpdateCurrencyUI(isInGame, overallCash, matchWallet)
end

local function updateMoneyDisplay()
	updateCurrencyUI()
end

updateCurrencyUI()

player.AttributeChanged:Connect(function(attr)
	if attr == "OverallCash" or attr == "Wallet" or attr == "IsInGame" or attr == "Money" then
		updateCurrencyUI()
	elseif attr == "HP" or attr == "Health" then
		local h = player:GetAttribute(attr)
		if typeof(h) == "number" and activeHum then
			updateHPDisplay(h, activeHum.MaxHealth)
		end
	end
end)

local function handlePayout(earnedCash: number, secondsSurvived: number, newOverall: number)
	updateCurrencyUI()
	statusHUD:HandlePayout(earnedCash, secondsSurvived, newOverall)
end

local PayoutRemote: RemoteEvent? = (ReplicatedStorage:FindFirstChild("CashPayoutEvent") :: any)
if PayoutRemote then
	PayoutRemote.OnClientEvent:Connect(handlePayout)
else
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("CashPayoutEvent", 15) :: RemoteEvent?
		if remote then
			PayoutRemote = remote
			remote.OnClientEvent:Connect(handlePayout)
		end
	end)
end

if StatsUpdated then
	StatsUpdated.OnClientEvent:Connect(function(stats)
		if stats then
			updateCurrencyUI()
			if stats.Health ~= nil and activeHum then
				updateHPDisplay(stats.Health, activeHum.MaxHealth)
			end
		end
	end)
end

-- ============================================================================
-- 3. CUSTOM WALK & RUN ANIMATION CONTROLLER
-- ============================================================================
local function isShiftPressed(): boolean
	local keyHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	-- If neither Shift key is physically held on keyboard, auto-clear isHoldingShift
	if not keyHeld and isHoldingShift then
		isHoldingShift = false
	end
	return isHoldingShift or keyHeld
end

local function syncMovementTracks()
	if not activeHum or activeHum.Health <= 0 or isBursting then return end

	-- Check if character is airborne (jumping or in freefall with feet in air)
	local humState = activeHum:GetState()
	local isAirborne = (activeHum.FloorMaterial == Enum.Material.Air) and (
		(humState == Enum.HumanoidStateType.Jumping)
		or (humState == Enum.HumanoidStateType.Freefall)
		or (humState == Enum.HumanoidStateType.FallingDown)
	)

	local isMoving = activeHum.MoveDirection.Magnitude > 0.05
	local hasShift = isShiftPressed()
	local wantSprint = hasShift and isMoving and (not exhaustedLockout) and (currentEnergy > 0)

	isSprinting = wantSprint
	activeHum.WalkSpeed = wantSprint and SPRINT_WALK_SPEED or BASE_WALK_SPEED

	if camera then
		TweenService:Create(camera, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = wantSprint and 77 or 70
		}):Play()
	end

	-- When airborne, smoothly fade out walk & sprint tracks so native jump/fall animations play cleanly!
	if isAirborne then
		if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.15) end
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.15) end
		lastMovementState = "Airborne"
		return
	end

	local newState = "Idle"
	if isMoving then
		newState = wantSprint and "Sprinting" or "Walking"
	end

	if newState == "Idle" then
		-- Smoothly fade out movement tracks; Action priority fading allows default Core Idle to seamlessly show
		if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.2) end
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.2) end
	elseif newState == "Sprinting" then
		if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.15) end
		if runTrack then
			if not runTrack.IsPlaying then
				runTrack:Play(0.15, 1, 1.0)
			end
			local speedRatio = activeHum.WalkSpeed / SPRINT_WALK_SPEED
			runTrack:AdjustSpeed(math.clamp(speedRatio, 0.8, 1.3))
		end
	elseif newState == "Walking" then
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.15) end
		if walkTrack then
			if not walkTrack.IsPlaying then
				walkTrack:Play(0.15, 1, 1.0)
			end
			local speedRatio = activeHum.WalkSpeed / BASE_WALK_SPEED
			walkTrack:AdjustSpeed(math.clamp(speedRatio, 0.8, 1.3))
		end
	end

	if newState ~= lastMovementState then
		lastMovementState = newState
	end
end

-- ============================================================================
-- 4. POLISHED PURE-WHITE JETPACK BACKSIDE SPEED TRAILS, SOUNDS & VISUAL EFFECTS
-- ============================================================================
local function playJetpackBurstSound(character: Model?, isLocal: boolean): Sound?
	if not character then return nil end
	local jetpack = character:FindFirstChild("Jetpack")
	local handle = jetpack and jetpack:FindFirstChild("Handle") :: BasePart?
	local parentPart = handle or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character.PrimaryPart or character

	local sound = Instance.new("Sound")
	sound.Name = "JetpackBurstSound"
	sound.SoundId = JETPACK_BURST_SOUND_ID
	sound.Volume = isLocal and JETPACK_BURST_VOLUME or (JETPACK_BURST_VOLUME * 0.70)
	sound.PlaybackSpeed = JETPACK_PLAYBACK_SPEED
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = isLocal and 15 or 10
	sound.RollOffMaxDistance = isLocal and 160 or 120
	sound.Parent = parentPart

	-- Exact timing configuration using top-level constants
	pcall(function()
		local timeLength = (sound.TimeLength > 0) and sound.TimeLength or 2.736
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(
			JETPACK_SOUND_START_OFFSET,
			math.max(JETPACK_SOUND_START_OFFSET + 0.05, timeLength - JETPACK_SOUND_CUT_LAST)
		)
	end)

	pcall(function()
		sound:Play()
		sound.TimePosition = JETPACK_SOUND_START_OFFSET
	end)

	-- Accurate cleanup: play at full volume until the final 1.0s of audio, then smoothly fade volume to 0
	task.spawn(function()
		local t0 = os.clock()
		while sound and sound.Parent and sound.TimeLength <= 0 and (os.clock() - t0) < 0.5 do
			task.wait(0.02)
		end
		local totalLength = (sound and sound.TimeLength > 0) and sound.TimeLength or 2.736
		local activeAudio = math.max(0.1, totalLength - JETPACK_SOUND_START_OFFSET - JETPACK_SOUND_CUT_LAST)
		local realPlayDuration = activeAudio / sound.PlaybackSpeed

		-- User-configured fade duration controlled by top-level JETPACK_SOUND_FADE_DURATION
		local fadeAudioDuration = math.clamp(JETPACK_SOUND_FADE_DURATION, 0.05, activeAudio)
		local fadeRealDuration = math.min(realPlayDuration, fadeAudioDuration / sound.PlaybackSpeed)
		local fullVolumeDuration = math.max(0, realPlayDuration - fadeRealDuration)

		if fullVolumeDuration > 0 then
			task.wait(fullVolumeDuration)
		end

		if sound and sound.Parent then
			local fadeTween = TweenService:Create(sound, TweenInfo.new(fadeRealDuration, Enum.EasingStyle.Linear), {
				Volume = 0,
			})
			fadeTween:Play()
			task.wait(fadeRealDuration)
		end

		if sound and sound.Parent then
			sound:Stop()
			sound:Destroy()
		end
	end)

	return sound
end

local function emitJetpackVisuals(character: Model, duration: number, isLocal: boolean)
	local jetpack = character:FindFirstChild("Jetpack")
	if not jetpack then return end

	local handle = jetpack:FindFirstChild("Handle") :: BasePart?
	local nozzles: { Attachment } = {}

	for _, desc in ipairs(jetpack:GetDescendants()) do
		if desc:IsA("Attachment") and (desc.Name == "LeftNozzle" or desc.Name == "RightNozzle" or string.find(desc.Name, "Nozzle")) then
			table.insert(nozzles, desc)
		end
	end

	if #nozzles == 0 then
		for _, child in ipairs(jetpack:GetChildren()) do
			if child:IsA("MeshPart") then
				local att = Instance.new("Attachment")
				att.Name = "DynamicNozzle"
				att.Position = Vector3.new(0, -child.Size.Y / 2, 0)
				att.Parent = child
				table.insert(nozzles, att)
			end
		end
	end

	local cleanups: { Instance } = {}

	-- 1. GLORIOUS PURE-WHITE BACKSIDE SPEED TRAIL (Centered on Jetpack Handle)
	-- Attached with 1.8 studs of vertical height so it is 100% visible from behind in 3rd person!
	if handle then
		local attTop = Instance.new("Attachment")
		attTop.Name = "BackTrailTop"
		attTop.Position = Vector3.new(0, 0.85, 0.45)
		attTop.Parent = handle

		local attBottom = Instance.new("Attachment")
		attBottom.Name = "BackTrailBottom"
		attBottom.Position = Vector3.new(0, -0.85, 0.45)
		attBottom.Parent = handle

		local backTrail = Instance.new("Trail")
		backTrail.Name = "JetpackBackSpeedTrail"
		backTrail.Attachment0 = attTop
		backTrail.Attachment1 = attBottom
		backTrail.FaceCamera = true
		backTrail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		backTrail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.65, 0.35),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		backTrail.Lifetime = 0.32
		backTrail.LightEmission = 1.0
		backTrail.LightInfluence = 0
		backTrail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.0),
			NumberSequenceKeypoint.new(1, 0.15),
		})
		backTrail.Parent = handle
		table.insert(cleanups, backTrail)
		table.insert(cleanups, attTop)
		table.insert(cleanups, attBottom)
	end

	-- 2. DUAL THRUSTER NOZZLE PARTICLES & STREAMING ENGINE TRAILS
	for _, nozzle in ipairs(nozzles) do
		-- Dense pure-white exhaust burst
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "ThrusterExhaust"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		emitter.LightEmission = 1.0
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.60),
			NumberSequenceKeypoint.new(1, 0.10),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.5, 0.3),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		emitter.Lifetime = NumberRange.new(0.15, 0.22)
		emitter.Speed = NumberRange.new(14, 22)
		emitter.SpreadAngle = Vector2.new(8, 8)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Rate = 120
		emitter.Parent = nozzle
		table.insert(cleanups, emitter)

		-- Individual engine ribbons streaming backwards
		if nozzle.Parent and nozzle.Parent:IsA("BasePart") then
			local nAtt0 = Instance.new("Attachment")
			nAtt0.Name = "NozzleTrail0"
			nAtt0.Position = Vector3.new(0, 0.3, 0)
			nAtt0.Parent = nozzle.Parent

			local nAtt1 = Instance.new("Attachment")
			nAtt1.Name = "NozzleTrail1"
			nAtt1.Position = Vector3.new(0, -0.3, 0)
			nAtt1.Parent = nozzle.Parent

			local nTrail = Instance.new("Trail")
			nTrail.Name = "NozzleStreamTrail"
			nTrail.Attachment0 = nAtt0
			nTrail.Attachment1 = nAtt1
			nTrail.FaceCamera = true
			nTrail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
			nTrail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.10),
				NumberSequenceKeypoint.new(0.7, 0.40),
				NumberSequenceKeypoint.new(1, 1.0),
			})
			nTrail.Lifetime = 0.25
			nTrail.LightEmission = 1.0
			nTrail.LightInfluence = 0
			nTrail.WidthScale = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.8),
				NumberSequenceKeypoint.new(1, 0.1),
			})
			nTrail.Parent = nozzle.Parent
			table.insert(cleanups, nTrail)
			table.insert(cleanups, nAtt0)
			table.insert(cleanups, nAtt1)
		end
	end

	-- 3. Local Camera FOV Punch (+6 degrees)
	if isLocal and camera then
		local curFOV = camera.FieldOfView
		local burstFOV = math.min(100, curFOV + 6)
		TweenService:Create(camera, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = burstFOV
		}):Play()
	end

	-- Safe cleanup after burst duration
	task.delay(duration, function()
		for _, inst in ipairs(cleanups) do
			if inst:IsA("ParticleEmitter") then
				inst.Enabled = false
				Debris:AddItem(inst, 0.3)
			elseif inst:IsA("Trail") then
				inst.Enabled = false
				Debris:AddItem(inst, 0.3)
			else
				Debris:AddItem(inst, 0.3)
			end
		end

		if isLocal and camera then
			local targetBaselineFOV = isSprinting and 77 or 70
			TweenService:Create(camera, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				FieldOfView = targetBaselineFOV
			}):Play()
		end
	end)
end

-- ============================================================================
-- JETPACK WARNING NOTIFICATION (Pure red text at top, smooth fade out, zero UI overlap)
-- ============================================================================
local warningToastFrame: Frame? = nil
local warningToastLabel: TextLabel? = nil
local warningSessionToken = 0

local function getOrCreateWarningToast(): (Frame, TextLabel)
	if warningToastFrame and warningToastFrame.Parent and warningToastLabel then
		return warningToastFrame, warningToastLabel
	end

	local playerGui = player:WaitForChild("PlayerGui")
	local targetGui: ScreenGui = (playerGui:FindFirstChild("BidToSurviveUI") :: ScreenGui?)
		or statusHUD.ScreenGui

	local yOffset = targetGui.IgnoreGuiInset and 108 or 72

	local toastFrame = Instance.new("Frame")
	toastFrame.Name = "JetpackWarningToast"
	toastFrame.AnchorPoint = Vector2.new(0.5, 0)
	toastFrame.Position = UDim2.new(0.5, 0, 0, yOffset)
	toastFrame.Size = UDim2.new(0, 320, 0, 28)
	toastFrame.BackgroundTransparency = 1
	toastFrame.BorderSizePixel = 0
	toastFrame.ZIndex = 45
	toastFrame.Visible = false

	local label = Instance.new("TextLabel")
	label.Name = "WarningLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.Position = UDim2.fromScale(0, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(255, 60, 60)
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 1
	label.TextTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 46
	label.Parent = toastFrame

	toastFrame.Parent = targetGui
	warningToastFrame = toastFrame
	warningToastLabel = label

	return toastFrame, label
end

local function showJetpackWarning(message: string)
	local frame, label = getOrCreateWarningToast()
	warningSessionToken = warningSessionToken + 1
	local myToken = warningSessionToken

	label.Text = message
	frame.Visible = true

	local targetGui = frame:FindFirstAncestorWhichIsA("ScreenGui")
	local baseY = (targetGui and targetGui.IgnoreGuiInset) and 108 or 72

	frame.Position = UDim2.new(0.5, 0, 0, baseY - 6)

	-- Smooth fade-in (pure text)
	TweenService:Create(frame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, baseY),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 0,
		TextStrokeTransparency = 0.25,
	}):Play()

	-- Subtle error feedback audio
	pcall(function()
		local errorTick = Instance.new("Sound")
		errorTick.SoundId = "rbxassetid://6895079853"
		errorTick.PlaybackSpeed = 0.65
		errorTick.Volume = 0.35
		errorTick.Parent = frame
		errorTick:Play()
		Debris:AddItem(errorTick, 0.4)
	end)

	-- Hold for 1.25s then smooth fade-out
	task.delay(1.25, function()
		if myToken ~= warningSessionToken then return end
		local fadeOutInfo = TweenInfo.new(0.40, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tFrame = TweenService:Create(frame, fadeOutInfo, {
			Position = UDim2.new(0.5, 0, 0, baseY - 6),
		})
		local tLabel = TweenService:Create(label, fadeOutInfo, {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		tFrame:Play()
		tLabel:Play()

		tFrame.Completed:Once(function()
			if myToken == warningSessionToken then
				frame.Visible = false
			end
		end)
	end)
end

-- Ultra-Responsive Check: whether Shift + Movement + Space conditions are satisfied
local function canPerformBurst(): boolean
	if isBursting then return false end
	if not activeChar or not activeHum or not activeHRP then return false end
	if activeHum.Health <= 0 then return false end
	if player:GetAttribute("IsAFK") == true and player:GetAttribute("IsInGame") ~= true then return false end
	if exhaustedLockout or currentEnergy < JETPACK_ENERGY_COST then return false end
	if (os.clock() - lastBurstTime) < JETPACK_COOLDOWN then return false end

	-- Check if player is holding Shift (or sprinting) AND moving
	local hasShift = isShiftPressed()

	local isMoving = (activeHum.MoveDirection.Magnitude > 0.05)
		or UserInputService:IsKeyDown(Enum.KeyCode.W)
		or UserInputService:IsKeyDown(Enum.KeyCode.A)
		or UserInputService:IsKeyDown(Enum.KeyCode.S)
		or UserInputService:IsKeyDown(Enum.KeyCode.D)
		or UserInputService:IsKeyDown(Enum.KeyCode.Up)
		or UserInputService:IsKeyDown(Enum.KeyCode.Down)

	if not (hasShift and isMoving) then
		return false
	end

	return true
end

-- ============================================================================
-- 5. EXPLOSIVE 15-STUD HIGH-SPEED JETPACK BURST
-- ============================================================================
local function performJetpackBurst()
	if not canPerformBurst() or not activeChar or not activeHum or not activeHRP then return end

	-- Determine burst direction along horizontal movement direction (or character facing direction)
	local moveDir = activeHum.MoveDirection
	local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z)
	if flatDir.Magnitude < 0.05 then
		local look = activeHRP.CFrame.LookVector
		flatDir = Vector3.new(look.X, 0, look.Z)
	end
	if flatDir.Magnitude < 0.05 then return end
	flatDir = flatDir.Unit

	isBursting = true
	lastBurstTime = os.clock()
	currentEnergy = math.max(0, currentEnergy - JETPACK_ENERGY_COST)

	print(string.format("[Movement][Jetpack] 🚀 Explosive Jetpack Burst! Dir: (%.2f, 0, %.2f), Energy: %d%%",
		flatDir.X, flatDir.Z, math.floor(currentEnergy)))

	-- Turn character forward along burst direction (keeping upright)
	pcall(function()
		activeHRP.CFrame = CFrame.lookAt(activeHRP.Position, activeHRP.Position + flatDir)
	end)

	-- 1. PLAY SOUND BEFORE ANIMATION / MOVEMENT STARTS
	pcall(function()
		playJetpackBurstSound(activeChar, true)
	end)
	if JETPACK_PRE_LAUNCH_DELAY > 0 then
		task.wait(JETPACK_PRE_LAUNCH_DELAY)
	end

	if not activeHRP or not activeHum or activeHum.Health <= 0 then
		isBursting = false
		return
	end

	local burstAtt: Attachment? = nil
	local burstVel: LinearVelocity? = nil

	local ok, burstErr = pcall(function()
		-- Wall / Obstacle Collision Pre-check: prevent passing through walls
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = { activeChar }
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local maxDistance = JETPACK_BURST_DISTANCE
		local wallRay = Workspace:Raycast(activeHRP.Position, flatDir * (JETPACK_BURST_DISTANCE + 1.2), rayParams)
		if wallRay then
			maxDistance = math.max(0, wallRay.Distance - 1.2)
		end

		local estimatedDuration = math.clamp(maxDistance / JETPACK_BURST_SPEED, 0.12, 0.25)

		-- Emit visuals (White Backside Trail + Dual Engine Trails + Exhaust) & notify server
		pcall(function()
			emitJetpackVisuals(activeChar, estimatedDuration, true)
		end)
		if JetpackBurstEvent then
			JetpackBurstEvent:FireServer(flatDir)
		end

		if maxDistance >= 0.5 and activeHRP and activeHum and activeHum.Health > 0 then
			-- BOOST WalkSpeed and apply high-force LinearVelocity so character accelerates massively!
			activeHum.WalkSpeed = JETPACK_BURST_SPEED

			burstAtt = Instance.new("Attachment")
			burstAtt.Name = "JetpackBurstAttachment"
			burstAtt.Position = Vector3.zero
			burstAtt.Parent = activeHRP

			burstVel = Instance.new("LinearVelocity")
			burstVel.Name = "JetpackBurstVelocity"
			burstVel.Attachment0 = burstAtt
			burstVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			burstVel.RelativeTo = Enum.ActuatorRelativeTo.World
			burstVel.ForceLimitsEnabled = true
			burstVel.MaxAxesForce = Vector3.new(2000000, 0, 2000000)
			burstVel.VectorVelocity = flatDir * JETPACK_BURST_SPEED
			burstVel.Parent = activeHRP

			-- Initial kick
			activeHRP.AssemblyLinearVelocity = Vector3.new(flatDir.X * JETPACK_BURST_SPEED, activeHRP.AssemblyLinearVelocity.Y, flatDir.Z * JETPACK_BURST_SPEED)

			local burstStart = os.clock()
			local startPos = activeHRP.Position
			local maxTimeout = 0.30 -- Hard safety timeout

			while true do
				RunService.Heartbeat:Wait()
				if not activeHRP or not activeHum or activeHum.Health <= 0 then break end

				local currentPos = activeHRP.Position
				local horizontalDist = ((currentPos - startPos) * Vector3.new(1, 0, 1)).Magnitude
				if horizontalDist >= maxDistance then
					break
				end

				if (os.clock() - burstStart) >= maxTimeout then
					break
				end

				local aheadRay = Workspace:Raycast(currentPos, flatDir * 1.5, rayParams)
				if aheadRay and aheadRay.Distance < 1.0 then
					break
				end
			end
		end
	end)

	if not ok then
		warn("[Movement][Jetpack] Error executing burst:", burstErr)
	end

	-- GUARANTEED CLEANUP: Physics controller removal
	if burstVel then pcall(function() burstVel:Destroy() end) end
	if burstAtt then pcall(function() burstAtt:Destroy() end) end

	-- Seamlessly restore normal movement / sprint speed
	if activeHRP and activeHum and activeHum.Health > 0 then
		local hasShift = isShiftPressed()
		local normalSpeed = hasShift and SPRINT_WALK_SPEED or BASE_WALK_SPEED
		activeHum.WalkSpeed = normalSpeed

		local yVel = activeHRP.AssemblyLinearVelocity.Y
		activeHRP.AssemblyLinearVelocity = Vector3.new(flatDir.X * normalSpeed, yVel, flatDir.Z * normalSpeed)
	end

	isBursting = false
	syncMovementTracks()
end

-- ============================================================================
-- 6. CHARACTER SETUP & GAME-2 HP RESET FIX
-- ============================================================================
local function bindCameraToHumanoid(hum: Humanoid)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	cam.CameraType = Enum.CameraType.Custom
	cam.CameraSubject = hum
	print(string.format("[Movement][Camera] 🎥 CameraSubject bound to %s (Parent: %s)", hum.Name, hum.Parent and hum.Parent.Name or "nil"))
end

local function setupCharacter(character: Model)
	activeChar = character
	activeHum = character:WaitForChild("Humanoid") :: Humanoid
	activeHRP = character:WaitForChild("HumanoidRootPart") :: BasePart

	isBursting = false
	currentEnergy = MAX_ENERGY
	lastMovementState = "None"

	bindCameraToHumanoid(activeHum)

	task.spawn(function()
		for _ = 1, 15 do
			local cam = Workspace.CurrentCamera
			if cam and activeHum and activeHum.Parent then
				if cam.CameraSubject ~= activeHum or cam.CameraType ~= Enum.CameraType.Custom then
					cam.CameraType = Enum.CameraType.Custom
					cam.CameraSubject = activeHum
				end
			end
			task.wait(0.08)
		end
	end)

	local rigType = activeHum.RigType
	print(string.format("[Movement][Init] 👤 Setting up character: %s | RigType: %s", character.Name, rigType.Name))

	if rigType == Enum.HumanoidRigType.R6 then
		currentWalkAnimId = R6_WALK_ANIM_ID
		currentRunAnimId  = R6_RUN_ANIM_ID
		print(string.format("[Movement][Init] ✅ R6 Avatar detected! Loading custom animations:\n  • Walk: %s\n  • Run: %s", currentWalkAnimId, currentRunAnimId))
	else
		currentWalkAnimId = R15_WALK_ANIM_ID
		currentRunAnimId  = R15_RUN_ANIM_ID
		warn(string.format("[Movement][Init] ⚠️ R15 Avatar detected! Loaded R15-compatible animations:\n  • Walk: %s\n  • Run: %s", currentWalkAnimId, currentRunAnimId))
	end

	-- In R6, Roblox default Animate uses "run" for all ground locomotion.
	-- Setting both "walk" and "run" in Animate to currentWalkAnimId guarantees default movement
	-- is ALWAYS the clean walk animation without playing the sprint animation during regular walking.
	-- Custom Sprint is cleanly driven with Action priority on top!
	local animateScript = character:WaitForChild("Animate", 3)
	if animateScript and animateScript:IsA("LocalScript") then
		for _, folderName in ipairs({ "walk", "run" }) do
			local folder = animateScript:FindFirstChild(folderName)
			if folder then
				for _, anim in ipairs(folder:GetChildren()) do
					if anim:IsA("Animation") then
						anim.AnimationId = currentWalkAnimId
					end
				end
			end
		end
	end

	local animator = activeHum:WaitForChild("Animator", 5) :: Animator
	if animator then
		-- Cleanly release any stale tracks from previous character spawn
		if walkTrack then
			pcall(function()
				walkTrack:Stop(0)
				walkTrack:Destroy()
			end)
			walkTrack = nil
		end
		if runTrack then
			pcall(function()
				runTrack:Stop(0)
				runTrack:Destroy()
			end)
			runTrack = nil
		end

		local walkAnim = Instance.new("Animation")
		walkAnim.AnimationId = currentWalkAnimId

		local runAnim = Instance.new("Animation")
		runAnim.AnimationId = currentRunAnimId

		pcall(function()
			ContentProvider:PreloadAsync({ walkAnim, runAnim })
		end)

		-- Action priority ensures walk/run cleanly overrides core/movement without killing default Idle
		walkTrack = animator:LoadAnimation(walkAnim)
		walkTrack.Priority = Enum.AnimationPriority.Action
		walkTrack.Looped = true

		runTrack = animator:LoadAnimation(runAnim)
		runTrack.Priority = Enum.AnimationPriority.Action
		runTrack.Looped = true

		local loadStart = os.clock()
		while (walkTrack.Length <= 0 or runTrack.Length <= 0) and (os.clock() - loadStart < 5.0) do
			task.wait(0.05)
		end

		print(string.format("[Movement][Init] 🎬 Tracks loaded on Animator:\n  • WalkTrack: Length=%.2fs, Priority=%s, Looped=%s\n  • RunTrack:  Length=%.2fs, Priority=%s, Looped=%s",
			walkTrack and walkTrack.Length or 0, walkTrack and walkTrack.Priority.Name or "nil", tostring(walkTrack and walkTrack.Looped),
			runTrack and runTrack.Length or 0, runTrack and runTrack.Priority.Name or "nil", tostring(runTrack and runTrack.Looped)))

		-- Step 2 Completion Check: Verify Workspace Map and Ruins Door are ready on client
		task.spawn(function()
			local map = Workspace:FindFirstChild("BidToSurviveMap") or Workspace
			if map then
				local _ = map:FindFirstChild("Ruins door") or Workspace:WaitForChild("Ruins door", 5)
				local _ = map:FindFirstChild("GameplayArea") or Workspace:WaitForChild("GameplayArea", 5)
			end

			print(string.format("[BOOT HIERARCHY] 🎬 Step 2: Animations verified (Walk: %.2fs, Run: %.2fs) & map assets ready. Firing ClientLoadReadyEvent.",
				walkTrack.Length, runTrack.Length))

			if ClientLoadReadyEvent then
				ClientLoadReadyEvent:FireServer()
			end
		end)
	end

	-- Re-bind HP listener on EVERY new character/game
	if healthConn then healthConn:Disconnect() end
	updateHPDisplay(activeHum.Health, activeHum.MaxHealth)
	updateMoneyDisplay()

	healthConn = activeHum.HealthChanged:Connect(function(newHealth)
		updateHPDisplay(newHealth, activeHum.MaxHealth)
	end)

	activeHum.Running:Connect(function(speed)
		syncMovementTracks()
	end)

	activeHum.StateChanged:Connect(function(oldState, newState)
		syncMovementTracks()
	end)
end

if player.Character then
	task.spawn(setupCharacter, player.Character)
end
player.CharacterAdded:Connect(setupCharacter)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = Workspace.CurrentCamera
	if activeHum and activeHum.Parent then
		bindCameraToHumanoid(activeHum)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.25)
		local currentCam = Workspace.CurrentCamera
		if currentCam and activeHum and activeHum.Parent then
			if currentCam.CameraSubject ~= activeHum then
				bindCameraToHumanoid(activeHum)
			end
		end
	end
end)

local function handleHUDReset()
	currentEnergy = MAX_ENERGY
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			updateHPDisplay(hum.Health, hum.MaxHealth)
		end
	end
	updateMoneyDisplay()
end

if ResetHUDRemote then
	ResetHUDRemote.OnClientEvent:Connect(handleHUDReset)
else
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("ResetHUDStateEvent", 15) :: RemoteEvent?
		if remote then
			remote.OnClientEvent:Connect(handleHUDReset)
		end
	end)
end

-- ============================================================================
-- 7. INPUT HANDLING & MULTIPLAYER REPLICATION
-- ============================================================================
-- ContextActionService binding for Space:
-- Sinks Space when sprinting to perform Jetpack Burst (blocking normal jump).
-- Passes Space to Roblox default controls for normal jumping when not sprinting.
local function handleSpaceAction(actionName: string, inputState: Enum.UserInputState, inputObject: InputObject)
	if inputState == Enum.UserInputState.Begin then
		local hasShift = isShiftPressed()
		if hasShift or isSprinting then
			if canPerformBurst() then
				print("[Movement][Input] ⌨️ Shift + Move + Space -> Triggering High-Speed Jetpack Burst!")
				task.spawn(performJetpackBurst)
				return Enum.ContextActionResult.Sink
			else
				if exhaustedLockout or currentEnergy < JETPACK_ENERGY_COST then
					showJetpackWarning("Out of energy!")
					return Enum.ContextActionResult.Sink
				elseif (os.clock() - lastBurstTime) < JETPACK_COOLDOWN then
					showJetpackWarning("Too frequent!")
					return Enum.ContextActionResult.Sink
				end
			end
		end
	end
	return Enum.ContextActionResult.Pass
end

ContextActionService:BindActionAtPriority(
	"JetpackBurstContextAction",
	handleSpaceAction,
	false,
	Enum.ContextActionPriority.High.Value,
	Enum.KeyCode.Space
)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		isHoldingShift = true
		print(string.format("[Movement][Input] ⌨️ Shift pressed (isHoldingShift=true, Energy=%d%%, ExhaustedLockout=%s)", math.floor(currentEnergy), tostring(exhaustedLockout)))
		syncMovementTracks()
	elseif input.KeyCode == Enum.KeyCode.Space then
		-- Fallback check in case ContextActionService was bypassed
		local hasShift = isShiftPressed()
		if hasShift or isSprinting then
			if canPerformBurst() then
				print("[Movement][Input] ⌨️ Spacebar fallback detected -> Triggering Jetpack Burst!")
				task.spawn(performJetpackBurst)
			else
				if exhaustedLockout or currentEnergy < JETPACK_ENERGY_COST then
					showJetpackWarning("Out of energy!")
				elseif (os.clock() - lastBurstTime) < JETPACK_COOLDOWN then
					showJetpackWarning("Too frequent!")
				end
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		isHoldingShift = false
		print("[Movement][Input] ⌨️ Shift released (isHoldingShift=false)")
		syncMovementTracks()
	end
end)

-- Replicate other players' jetpack bursts in multiplayer
if JetpackBurstReplicatedEvent then
	JetpackBurstReplicatedEvent.OnClientEvent:Connect(function(burstingPlayer: Player, flatDir: Vector3)
		if burstingPlayer ~= player and burstingPlayer.Character then
			playJetpackBurstSound(burstingPlayer.Character, false)
			emitJetpackVisuals(burstingPlayer.Character, 0.22, false)
		end
	end)
end

RunService.RenderStepped:Connect(function(dt)
	if not activeHum or activeHum.Health <= 0 then return end

	syncMovementTracks()

	-- Drain White Energy while sprinting; regenerate when walking or standing still
	if isSprinting and not isBursting then
		currentEnergy = math.max(0, currentEnergy - (SPRINT_DRAIN_RATE * dt))
		if currentEnergy <= 0 and not exhaustedLockout then
			exhaustedLockout = true
			print("[Movement][Energy] ⚠️ ENERGY EXHAUSTED (0%) -> Sprint lockout engaged until energy reaches 20%")
			syncMovementTracks()
		end
	elseif not isBursting then
		currentEnergy = math.min(MAX_ENERGY, currentEnergy + (ENERGY_REGEN_RATE * dt))
		if exhaustedLockout and currentEnergy >= 20 then
			exhaustedLockout = false
			print(string.format("[Movement][Energy] 🔋 ENERGY RECOVERED (%d%%) -> Sprint lockout cleared", math.floor(currentEnergy)))
		end
	end

	-- Update Comic EP Bar UI
	statusHUD:UpdateEnergy(currentEnergy, MAX_ENERGY)

	-- Instant Water Fall Recovery (Play Area -> Walkway)
	if activeHRP and activeHum and activeHum.Health > 0 then
		local inPlayArea = (activeHRP.Position.X < -50) or (player:GetAttribute("IsInGame") == true)
		if inPlayArea and (activeHRP.Position.Y <= 34.5 or activeHum:GetState() == Enum.HumanoidStateType.Swimming) then
			local map = Workspace:FindFirstChild("BidToSurviveMap")
			local gameArea = map and map:FindFirstChild("GameplayArea")
			local walkway = gameArea and gameArea:FindFirstChild("Walkway")
			local targetPos = walkway and Vector3.new(walkway.Position.X, walkway.Position.Y + 3.5, walkway.Position.Z)
				or Vector3.new(-161.5, 72.5, -24.9)

			activeHRP.AssemblyLinearVelocity = Vector3.zero
			activeHRP.AssemblyAngularVelocity = Vector3.zero
			if player.Character then
				player.Character:PivotTo(CFrame.new(targetPos))
			end
			activeHum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end)

print("[MovementDiveAndHUDClient] Initialized: Walk (90697464892050), Run (125757170550820), High-Speed Jetpack Burst (15-stud) & Unified Stacked HUD.")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="41">
        <Properties>
          <string name="Name">RuinsImpactClient</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayer/StarterPlayerScripts/RuinsImpactClient.client.luau
-- Authoritative client-side cinematic audio, telegraph, suction, and impact VFX system.
-- Synchronizes the 4 author-provided Workspace sound objects:
-- 1. "Heavy stone door slide" (rbxassetid://83419164428609)
-- 2. "Blackhole Loop" (rbxassetid://1160209243)
-- 3. "Skeleton_Emerge" (rbxassetid://102911549900922)
-- 4. "Skeleton_SlamImpact" (rbxassetid://74149238738530)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- Locate RemoteEvents
local Network = ReplicatedStorage:WaitForChild("Network", 8)

local ImpactRemote: RemoteEvent = (Network and Network:WaitForChild("RuinsHandImpactEvent", 8))
	or ReplicatedStorage:WaitForChild("RuinsHandImpactEvent", 8) :: any
if not ImpactRemote then
	local fallback = Instance.new("RemoteEvent")
	fallback.Name = "RuinsHandImpactEvent"
	fallback.Parent = Network or ReplicatedStorage
	ImpactRemote = fallback :: RemoteEvent
end

local PortalRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsPortalEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsPortalEvent") :: any
if not PortalRemote then
	local fallback = Instance.new("RemoteEvent")
	fallback.Name = "RuinsPortalEvent"
	fallback.Parent = Network or ReplicatedStorage
	PortalRemote = fallback :: RemoteEvent
end

local TelegraphRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsTelegraphEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsTelegraphEvent") :: any
if not TelegraphRemote then
	local fallback = Instance.new("RemoteEvent")
	fallback.Name = "RuinsTelegraphEvent"
	fallback.Parent = Network or ReplicatedStorage
	TelegraphRemote = fallback :: RemoteEvent
end

local EmergeRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsHandEmergeEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsHandEmergeEvent") :: any
if not EmergeRemote then
	local fallback = Instance.new("RemoteEvent")
	fallback.Name = "RuinsHandEmergeEvent"
	fallback.Parent = Network or ReplicatedStorage
	EmergeRemote = fallback :: RemoteEvent
end

-- Lighting ColorCorrection for high-energy impact flash
local impactCC = Lighting:FindFirstChild("RuinsImpactCC") :: ColorCorrectionEffect?
if not impactCC then
	impactCC = Instance.new("ColorCorrectionEffect")
	impactCC.Name = "RuinsImpactCC"
	impactCC.Parent = Lighting
end

-- ============================================================================
-- 1. SOUND TEMPLATES & CLEAN 3D POSITIONAL AUDIO MIX
-- ============================================================================
local SOUND_NAMES = {
	DoorSlide = "Heavy stone door slide",
	BlackholeLoop = "Blackhole Loop",
	HandEmerge = "Skeleton_Emerge",
	SlamImpact = "Skeleton_SlamImpact",
}

-- ============================================================================
-- [USER VOLUME CONTROLS] Modify any of the 4 sound volume values below:
-- ============================================================================
local AUDIO_VOLUMES = {
	DoorSlide     = 1.37,  -- Heavy stone door slide (Opening & Closing)
	BlackholeLoop = 0.20,  -- Blackhole atmospheric loop
	HandEmerge    = 1.69,  -- Skeleton hand emergence
	SlamImpact    = 2.97,  -- Skeleton ground slam impact
}

local function getSoundTemplate(soundName: string): Sound?
	local template = Workspace:FindFirstChild(soundName)
	if not template or not template:IsA("Sound") then
		template = Workspace:FindFirstChild(soundName, true) :: any
	end
	if not template or not template:IsA("Sound") then
		template = Workspace:WaitForChild(soundName, 3) :: any
	end
	if template and template:IsA("Sound") then
		return template
	end
	warn(string.format("[RuinsAudio] Sound template '%s' not found in Workspace!", soundName))
	return nil
end

local activeBlackholeSound: Sound? = nil
local activeBlackholeFadeTween: Tween? = nil
local activeDoorSound: Sound? = nil
local activeEmergeSound: Sound? = nil
local sequenceStartTime: number = 0

local function cleanupActiveAudio()
	if activeBlackholeFadeTween then
		activeBlackholeFadeTween:Cancel()
		activeBlackholeFadeTween = nil
	end
	if activeBlackholeSound then
		pcall(function()
			activeBlackholeSound:Stop()
			activeBlackholeSound:Destroy()
		end)
		activeBlackholeSound = nil
	end
	if activeDoorSound then
		pcall(function()
			activeDoorSound:Stop()
			activeDoorSound:Destroy()
		end)
		activeDoorSound = nil
	end
	if activeEmergeSound then
		pcall(function()
			activeEmergeSound:Stop()
			activeEmergeSound:Destroy()
		end)
		activeEmergeSound = nil
	end
end

local function resolveRuinsInstances(): (BasePart?, Model?, BasePart?)
	local map = Workspace:FindFirstChild("BidToSurviveMap")
	local ruinsDoor = (map and (map:FindFirstChild("Ruins door") or map:FindFirstChild("RuinsDoor")))
		or Workspace:FindFirstChild("Ruins door")
		or Workspace:FindFirstChild("RuinsDoor")
		or Workspace:FindFirstChild("Ruins door", true)

	local doorSlide: BasePart? = nil
	local blackHole: Model? = nil
	local mainPart: BasePart? = nil

	if ruinsDoor then
		doorSlide = (ruinsDoor:FindFirstChild("doorSlide", true) or ruinsDoor:FindFirstChild("DoorSlide", true)) :: BasePart?
		local bh = ruinsDoor:FindFirstChild("Blackhole", true) or ruinsDoor:FindFirstChild("BlackHole", true)
		if bh and bh:IsA("Model") then
			blackHole = bh
			mainPart = (bh:FindFirstChild("Main") or bh.PrimaryPart or bh:FindFirstChildWhichIsA("BasePart", true)) :: BasePart?
		end
	end

	return doorSlide, blackHole, mainPart
end

local function playDoorSlideAudio(doorSlide: BasePart?, isOpening: boolean)
	local template = getSoundTemplate(SOUND_NAMES.DoorSlide)
	if not template then return end

	if activeDoorSound then
		pcall(function()
			activeDoorSound:Stop()
			activeDoorSound:Destroy()
		end)
		activeDoorSound = nil
	end

	local s = template:Clone()
	s.Name = isOpening and "RuinsDoorSlide_Open" or "RuinsDoorSlide_Close"
	s.Volume = AUDIO_VOLUMES.DoorSlide
	s.PlaybackSpeed = isOpening and 1.0 or 0.96
	s.Looped = false
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 25
	s.RollOffMaxDistance = 450

	if doorSlide then
		s.Parent = doorSlide
	else
		local att = Instance.new("Attachment")
		att.WorldPosition = Vector3.new(-258.08, 112.78, -30.45)
		att.Parent = Workspace.Terrain
		s.Parent = att
	end

	activeDoorSound = s
	s:Play()

	s.Ended:Once(function()
		if activeDoorSound == s then
			activeDoorSound = nil
		end
		s:Destroy()
	end)
end

local function startBlackholeLoopAudio(mainPart: BasePart?)
	local template = getSoundTemplate(SOUND_NAMES.BlackholeLoop)
	if not template then return end

	if activeBlackholeFadeTween then
		activeBlackholeFadeTween:Cancel()
		activeBlackholeFadeTween = nil
	end

	if activeBlackholeSound then
		pcall(function()
			activeBlackholeSound:Stop()
			activeBlackholeSound:Destroy()
		end)
		activeBlackholeSound = nil
	end

	local s = template:Clone()
	s.Name = "RuinsBlackholeLoop_Active"
	s.Volume = AUDIO_VOLUMES.BlackholeLoop
	s.PlaybackSpeed = 1.0
	s.Looped = false -- Play black hole sound exactly 1 time
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 20
	s.RollOffMaxDistance = 350

	if mainPart then
		s.Parent = mainPart
	else
		local att = Instance.new("Attachment")
		att.WorldPosition = Vector3.new(-266.31, 112.78, -30.45)
		att.Parent = Workspace.Terrain
		s.Parent = att
	end

	activeBlackholeSound = s
	s:Play()
	s.Ended:Once(function()
		if activeBlackholeSound == s then
			activeBlackholeSound = nil
		end
		s:Destroy()
	end)
end

local function stopBlackholeLoopAudio(fadeDuration: number?)
	local s = activeBlackholeSound
	if not s or not s.IsPlaying then
		if s then
			pcall(function() s:Destroy() end)
			activeBlackholeSound = nil
		end
		return
	end

	local duration = math.clamp(fadeDuration or 0.28, 0.20, 0.35)
	if activeBlackholeFadeTween then
		activeBlackholeFadeTween:Cancel()
		activeBlackholeFadeTween = nil
	end

	local tween = TweenService:Create(s, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Volume = 0
	})
	activeBlackholeFadeTween = tween

	tween.Completed:Once(function()
		if activeBlackholeSound == s then
			activeBlackholeSound = nil
		end
		pcall(function()
			s:Stop()
			s:Destroy()
		end)
		if activeBlackholeFadeTween == tween then
			activeBlackholeFadeTween = nil
		end
	end)
	tween:Play()
end

local function playHandEmergeAudio(emergencePos: Vector3)
	local template = getSoundTemplate(SOUND_NAMES.HandEmerge)
	if not template then return end

	if activeEmergeSound then
		pcall(function()
			activeEmergeSound:Stop()
			activeEmergeSound:Destroy()
		end)
		activeEmergeSound = nil
	end

	local att = Instance.new("Attachment")
	att.Name = "RuinsEmergeAudioAttachment"
	att.WorldPosition = emergencePos
	att.Parent = Workspace.Terrain

	local s = template:Clone()
	s.Name = "RuinsHandEmerge_Active"
	s.Volume = AUDIO_VOLUMES.HandEmerge
	s.PlaybackSpeed = 1.0
	s.Looped = false
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 25
	s.RollOffMaxDistance = 450
	s.Parent = att

	activeEmergeSound = s
	s:Play()

	s.Ended:Once(function()
		if activeEmergeSound == s then
			activeEmergeSound = nil
		end
		s:Destroy()
		att:Destroy()
	end)

	task.delay(s.TimeLength + 0.5, function()
		if att.Parent then
			att:Destroy()
		end
	end)
end

local function playSlamImpactAudio(impactPos: Vector3)
	local template = getSoundTemplate(SOUND_NAMES.SlamImpact)
	if not template then return end

	local att = Instance.new("Attachment")
	att.Name = "RuinsImpactAudioAttachment"
	att.WorldPosition = impactPos
	att.Parent = Workspace.Terrain

	local s = template:Clone()
	s.Name = "RuinsSlamImpact_Active"
	s.Volume = AUDIO_VOLUMES.SlamImpact
	s.PlaybackSpeed = 1.0
	s.Looped = false
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 35
	s.RollOffMaxDistance = 550
	s.Parent = att

	s:Play()

	s.Ended:Once(function()
		s:Destroy()
		att:Destroy()
	end)

	task.delay(s.TimeLength + 0.5, function()
		if att.Parent then
			att:Destroy()
		end
	end)
end

-- ============================================================================
-- 2. TELEGRAPH RED WARNING CIRCLE & BLACK HOLE SUCTION
-- ============================================================================
local activeSuctionConn: RBXScriptConnection? = nil

local function showRedDangerTelegraph(centerPos: Vector3, radius: number, duration: number, targetedPlayer: Player?)
	local folder = Instance.new("Folder")
	folder.Name = "RedDangerTelegraph"
	folder.Parent = Workspace

	local diameter = radius * 2

	-- A) Translucent Pulsing Red Danger Disc
	local dangerDisc = Instance.new("Part")
	dangerDisc.Name = "DangerFillDisc"
	dangerDisc.Shape = Enum.PartType.Cylinder
	dangerDisc.Anchored = true
	dangerDisc.CanCollide = false
	dangerDisc.CanQuery = false
	dangerDisc.Material = Enum.Material.Neon
	dangerDisc.Color = Color3.fromRGB(255, 30, 45)
	dangerDisc.Transparency = 0.72
	dangerDisc.Size = Vector3.new(0.15, 2, 2)
	dangerDisc.CFrame = CFrame.new(centerPos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	dangerDisc.Parent = folder

	TweenService:Create(dangerDisc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.15, diameter, diameter)
	}):Play()

	-- Urgent transparency pulse until slam
	local pulseCount = math.max(1, math.floor(duration / 0.35))
	TweenService:Create(dangerDisc, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, pulseCount, true), {
		Transparency = 0.45
	}):Play()

	-- B) Outer High-Contrast Glowing Boundary Ring
	local boundaryRing = Instance.new("Part")
	boundaryRing.Name = "DangerBoundaryRing"
	boundaryRing.Shape = Enum.PartType.Cylinder
	boundaryRing.Anchored = true
	boundaryRing.CanCollide = false
	boundaryRing.CanQuery = false
	boundaryRing.Material = Enum.Material.Neon
	boundaryRing.Color = Color3.fromRGB(255, 45, 55)
	boundaryRing.Transparency = 0.15
	boundaryRing.Size = Vector3.new(0.20, diameter, diameter)
	boundaryRing.CFrame = CFrame.new(centerPos + Vector3.new(0, 0.10, 0)) * CFrame.Angles(0, 0, math.rad(90))
	boundaryRing.Parent = folder

	-- C) Inner Countdown Timing Ring (Expands from center to edge right as Hand hits!)
	local timingRing = dangerDisc:Clone()
	timingRing.Name = "CountdownFillRing"
	timingRing.Color = Color3.fromRGB(255, 95, 70)
	timingRing.Transparency = 0.35
	timingRing.Size = Vector3.new(0.22, 1, 1)
	timingRing.Parent = folder

	TweenService:Create(timingRing, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = Vector3.new(0.22, diameter, diameter),
		Color = Color3.fromRGB(255, 15, 15),
		Transparency = 0.15
	}):Play()

	-- D) Extra: Black Hole Radial Inward Suction (4.5 studs/sec)
	if activeSuctionConn then
		activeSuctionConn:Disconnect()
		activeSuctionConn = nil
	end

	local PULL_STRENGTH = 4.5
	activeSuctionConn = RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return end

		local flatOffset = Vector3.new(centerPos.X - root.Position.X, 0, centerPos.Z - root.Position.Z)
		local dist = flatOffset.Magnitude

		if dist > 1.5 and dist <= (radius * 1.15) then
			local pullDir = flatOffset.Unit
			local edgeFactor = math.clamp(dist / radius, 0.55, 1.15)
			root.CFrame = root.CFrame + (pullDir * (PULL_STRENGTH * edgeFactor * dt))
		end
	end)

	task.delay(duration + 0.05, function()
		if activeSuctionConn then
			activeSuctionConn:Disconnect()
			activeSuctionConn = nil
		end
		if folder.Parent then
			folder:Destroy()
		end
	end)
end

-- ============================================================================
-- 3. GROUND SMASH CRATER & CAMERA SHAKE
-- ============================================================================
local function spawnGroundDestruction(impactPos: Vector3, circleRadius: number, floorColor: Color3, floorMaterial: Enum.Material)
	local folder = Instance.new("Folder")
	folder.Name = "HandGroundSmashVFX"
	folder.Parent = Workspace

	local diameter = circleRadius * 2

	-- 1. Crimson & Amber Flash Ring
	local coreRing = Instance.new("Part")
	coreRing.Name = "ImpactCoreRing"
	coreRing.Shape = Enum.PartType.Cylinder
	coreRing.Anchored = true
	coreRing.CanCollide = false
	coreRing.Material = Enum.Material.Neon
	coreRing.Color = Color3.fromRGB(255, 70, 35)
	coreRing.Transparency = 0.1
	coreRing.Size = Vector3.new(0.8, diameter * 0.85, diameter * 0.85)
	coreRing.CFrame = CFrame.new(impactPos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	coreRing.Parent = folder

	TweenService:Create(coreRing, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.08, diameter * 1.15, diameter * 1.15),
		Transparency = 1
	}):Play()

	-- 2. Outer Dust Wave
	local dustRing = coreRing:Clone()
	dustRing.Name = "ImpactDustWave"
	dustRing.Material = Enum.Material.SmoothPlastic
	dustRing.Color = Color3.fromRGB(217, 210, 197)
	dustRing.Transparency = 0.25
	dustRing.Size = Vector3.new(1.8, diameter * 0.90, diameter * 0.90)
	dustRing.Parent = folder

	TweenService:Create(dustRing, TweenInfo.new(0.70, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.25, diameter * 1.35, diameter * 1.35),
		Transparency = 1
	}):Play()

	-- 3. Crater Rim Rock Slabs Along the Perimeter
	local numChunks = 20
	local chunkScale = math.clamp(circleRadius / 16, 1.2, 3.2)

	for i = 1, numChunks do
		local angle = (i / numChunks) * math.pi * 2 + (math.random(-10, 10) * 0.01)
		local rimDist = circleRadius * 0.92
		local spawnOffset = Vector3.new(math.cos(angle) * rimDist, -1.8 * chunkScale, math.sin(angle) * rimDist)
		local targetPos = impactPos + Vector3.new(math.cos(angle) * circleRadius, 0.9 * chunkScale, math.sin(angle) * circleRadius)

		local rock = Instance.new("Part")
		rock.Name = "CraterRimSlab"
		rock.Anchored = true
		rock.CanCollide = false
		rock.Color = floorColor
		rock.Material = floorMaterial
		rock.Size = Vector3.new(
			(math.random(30, 52) / 10) * chunkScale,
			(math.random(16, 30) / 10) * chunkScale,
			(math.random(30, 52) / 10) * chunkScale
		)
		rock.CFrame = CFrame.lookAt(impactPos + spawnOffset, impactPos)
			* CFrame.Angles(math.rad(math.random(-35, 35)), math.rad(math.random(-20, 20)), math.rad(math.random(-25, 25)))
		rock.Parent = folder

		TweenService:Create(rock, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = targetPos
		}):Play()

		task.delay(1.15 + (math.random() * 0.35), function()
			if rock.Parent then
				TweenService:Create(rock, TweenInfo.new(0.50, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = targetPos - Vector3.new(0, 4.5 * chunkScale, 0),
					Transparency = 1
				}):Play()
			end
		end)
	end

	task.delay(2.5, function()
		if folder.Parent then folder:Destroy() end
	end)
end

local function shakeCamera(impactPos: Vector3, circleRadius: number)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local flatDist = root and Vector2.new(root.Position.X - impactPos.X, root.Position.Z - impactPos.Z).Magnitude or 40
	local wasHit = flatDist <= circleRadius

	local intensity = wasHit and 2.8 or 1.1

	if impactCC then
		impactCC.Contrast = wasHit and 0.45 or 0.15
		impactCC.TintColor = wasHit and Color3.fromRGB(255, 165, 165) or Color3.fromRGB(255, 235, 230)
		TweenService:Create(impactCC, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Contrast = 0,
			TintColor = Color3.fromRGB(255, 255, 255)
		}):Play()
	end

	local defaultFOV = 70
	camera.FieldOfView = math.max(45, defaultFOV - (wasHit and 6.0 or 2.5))
	TweenService:Create(camera, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		FieldOfView = defaultFOV
	}):Play()

	local startTime = os.clock()
	local duration = 0.50
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime
		if elapsed >= duration then
			if conn then conn:Disconnect() conn = nil end
			return
		end

		local alpha = 1 - (elapsed / duration)
		local damper = alpha * alpha * intensity
		local offset = Vector3.new(
			(math.random() - 0.5) * damper * 0.9,
			(math.random() - 0.5) * damper * 1.1,
			(math.random() - 0.5) * damper * 0.9
		)
		camera.CFrame = camera.CFrame * CFrame.new(offset) * CFrame.Angles(
			math.rad((math.random() - 0.5) * damper * 2.0),
			math.rad((math.random() - 0.5) * damper * 1.2),
			math.rad((math.random() - 0.5) * damper * 2.0)
		)
	end)
end

-- ============================================================================
-- 4. PORTAL & BLACK HOLE CLIENT ANIMATION (Synchronized Visuals)
-- ============================================================================
local portalConn: RBXScriptConnection? = nil

local function animateClientPortal(isOpen: boolean, duration: number, targetScale: number)
	local doorSlide, bh, mainPart = resolveRuinsInstances()
	if not bh or not bh:IsA("Model") then return end

	for _, d in ipairs(bh:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end

	-- Center black hole only on opening using fixed doorway coordinates so it never snaps to the open door position on close!
	if isOpen then
		local FIXED_DOORWAY_Y = 112.776
		local FIXED_DOORWAY_Z = -30.455
		local doorwayCenter = Vector3.new(bh:GetPivot().Position.X, FIXED_DOORWAY_Y, FIXED_DOORWAY_Z)
		bh:PivotTo(CFrame.new(doorwayCenter) * bh:GetPivot().Rotation)
	end

	if portalConn then
		portalConn:Disconnect()
		portalConn = nil
	end

	local startScale = bh:GetScale()
	local endScale = isOpen and targetScale or 0.001
	local easingStyle = isOpen and Enum.EasingStyle.Back or Enum.EasingStyle.Quad
	local easingDir = isOpen and Enum.EasingDirection.Out or Enum.EasingDirection.InOut

	if isOpen then
		for _, d in ipairs(bh:GetDescendants()) do
			if d:IsA("ParticleEmitter") then
				d.Enabled = true
				d:Clear()
			end
		end
	end

	local startTime = os.clock()
	local lastEmit = 0

	portalConn = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startTime
		local progress = math.clamp(elapsed / duration, 0, 1)
		local alpha = TweenService:GetValue(progress, easingStyle, easingDir)
		local currentScale = math.max(startScale + (endScale - startScale) * alpha, 0.001)

		bh:ScaleTo(currentScale)

		if isOpen and (elapsed - lastEmit >= 0.15) then
			lastEmit = elapsed
			for _, d in ipairs(bh:GetDescendants()) do
				if d:IsA("ParticleEmitter") then
					d:Emit(1)
				end
			end
		end

		if progress >= 1 then
			if portalConn then
				portalConn:Disconnect()
				portalConn = nil
			end

			if isOpen then
				bh:ScaleTo(targetScale)
				for _, d in ipairs(bh:GetDescendants()) do
					if d:IsA("ParticleEmitter") then
						d:Emit(3)
					end
				end
			else
				bh:ScaleTo(0.001)
				for _, d in ipairs(bh:GetDescendants()) do
					if d:IsA("ParticleEmitter") then
						d.Enabled = false
						d:Clear()
					end
				end
			end
		end
	end)
end

-- ============================================================================
-- 5. REMOTE EVENT LISTENERS (Authoritative Synchronization)
-- ============================================================================
TelegraphRemote.OnClientEvent:Connect(showRedDangerTelegraph)

PortalRemote.OnClientEvent:Connect(function(isOpen: boolean, duration: number, targetScale: number)
	local doorSlide, bh, mainPart = resolveRuinsInstances()
	local animDuration = duration or (isOpen and 1.35 or 1.0)
	local finalScale = targetScale or (isOpen and 5.0 or 0.001)

	if isOpen then
		-- Phase 1 & 2: Clean up any previous round audio and start synchronized opening
		cleanupActiveAudio()
		sequenceStartTime = os.clock()

		print(string.format("[RuinsAudio] [T+0.00s] Door opening: Heavy stone door slide & Blackhole Loop started (duration=%.2fs, scale=%.1f)", animDuration, finalScale))
		playDoorSlideAudio(doorSlide, true)
		startBlackholeLoopAudio(mainPart)
		animateClientPortal(true, animDuration, finalScale)
	else
		-- Phase 3: Portal closing, loop audio fades out over ~0.28s, door closing replay
		local elapsed = (sequenceStartTime > 0) and (os.clock() - sequenceStartTime) or 0
		print(string.format("[RuinsAudio] [T+%.2fs] Portal closing: Blackhole Loop fading out, Heavy stone door slide replay (duration=%.2fs)", elapsed, animDuration))
		stopBlackholeLoopAudio(0.28)
		playDoorSlideAudio(doorSlide, false)
		animateClientPortal(false, animDuration, 0.001)
	end
end)

EmergeRemote.OnClientEvent:Connect(function(emergencePos: Vector3, duration: number)
	local elapsed = (sequenceStartTime > 0) and (os.clock() - sequenceStartTime) or 0
	print(string.format("[RuinsAudio] [T+%.2fs] Hand emergence: Skeleton_Emerge triggered at %s", elapsed, tostring(emergencePos)))
	playHandEmergeAudio(emergencePos)
end)

ImpactRemote.OnClientEvent:Connect(function(impactPos, handSize, floorColor, floorMaterial, circleRadius)
	local elapsed = (sequenceStartTime > 0) and (os.clock() - sequenceStartTime) or 0
	local radius = circleRadius or (math.max(handSize.X, handSize.Z) * 0.5)

	print(string.format("[RuinsAudio] [T+%.2fs] Ground impact: Skeleton_SlamImpact triggered at %s (radius=%.1f)", elapsed, tostring(impactPos), radius))
	playSlamImpactAudio(impactPos)
	spawnGroundDestruction(impactPos, radius, floorColor or Color3.fromRGB(58, 125, 21), floorMaterial or Enum.Material.Plastic)
	shakeCamera(impactPos, radius)
end)

print("[RuinsImpactClient] Professional 3D Audio System loaded with 4 Workspace sound templates.")
]]></string>
