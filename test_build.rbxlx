	scroll.ScrollingEnabled = true
	scroll.CanvasSize = UDim2.new(0, 0, 0, 100 * 78)
	scroll.ZIndex = 2

	local sPadding = Instance.new("UIPadding")
	sPadding.PaddingLeft = UDim.new(0, 4)
	sPadding.PaddingRight = UDim.new(0, 16)
	sPadding.PaddingTop = UDim.new(0, 4)
	sPadding.PaddingBottom = UDim.new(0, 8)
	sPadding.Parent = scroll

	local uiList = Instance.new("UIListLayout")
	uiList.SortOrder = Enum.SortOrder.LayoutOrder
	uiList.Padding = UDim.new(0, 6)
	uiList.Parent = scroll

	scroll.Parent = mainCard
	surfaceGui.Parent = part

	return surfaceGui, scroll
end

local function populateLeaderboardRows(scroll: ScrollingFrame, entries: { { Rank: number, UserId: number, Username: string, Cash: number } })
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for _, entry in ipairs(entries) do
		local rank = entry.Rank
		local row = Instance.new("Frame")
		row.Name = "Row_" .. rank
		row.Size = UDim2.new(1, 0, 0, 72)
		row.LayoutOrder = rank
		row.BorderSizePixel = 0
		row.ZIndex = 3

		-- Rank styling: Gold for #1, Silver for #2, Bronze for #3
		local rStroke = Instance.new("UIStroke")
		local rCorner = Instance.new("UICorner")
		rCorner.CornerRadius = UDim.new(0, 10)
		rCorner.Parent = row

		if rank == 1 then
			row.BackgroundColor3 = Color3.fromRGB(48, 38, 12)
			rStroke.Color = Color3.fromRGB(255, 215, 0)
			rStroke.Thickness = 3.5
		elseif rank == 2 then
			row.BackgroundColor3 = Color3.fromRGB(36, 40, 48)
			rStroke.Color = Color3.fromRGB(210, 225, 240)
			rStroke.Thickness = 3
		elseif rank == 3 then
			row.BackgroundColor3 = Color3.fromRGB(42, 28, 16)
			rStroke.Color = Color3.fromRGB(220, 140, 60)
			rStroke.Thickness = 3
		else
			row.BackgroundColor3 = (rank % 2 == 0) and Color3.fromRGB(22, 18, 16) or Color3.fromRGB(28, 22, 18)
			rStroke.Color = Color3.fromRGB(0, 0, 0)
			rStroke.Thickness = 2
		end
		rStroke.Parent = row

		-- 1. Rank Label (1.5X font)
		local rankPill = Instance.new("TextLabel")
		rankPill.Size = UDim2.new(0, 105, 0, 46)
		rankPill.Position = UDim2.new(0, 10, 0.5, 0)
		rankPill.AnchorPoint = Vector2.new(0, 0.5)
		rankPill.BackgroundTransparency = 1
		rankPill.Text = "#" .. tostring(rank)
		rankPill.Font = Enum.Font.GothamBlack
		rankPill.TextSize = (rank <= 3) and 34 or 28
		if rank == 1 then
			rankPill.TextColor3 = Color3.fromRGB(255, 225, 60)
		elseif rank == 2 then
			rankPill.TextColor3 = Color3.fromRGB(225, 235, 255)
		elseif rank == 3 then
			rankPill.TextColor3 = Color3.fromRGB(255, 175, 90)
		else
			rankPill.TextColor3 = Color3.fromRGB(220, 225, 235)
		end
		rankPill.TextXAlignment = Enum.TextXAlignment.Center
		rankPill.ZIndex = 4
		rankPill.Parent = row

		-- 2. Avatar Thumbnail
		local avFrame = Instance.new("Frame")
		avFrame.Size = UDim2.new(0, 56, 0, 56)
		avFrame.Position = UDim2.new(0, 135, 0.5, 0)
		avFrame.AnchorPoint = Vector2.new(0, 0.5)
		avFrame.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
		avFrame.BorderSizePixel = 0
		avFrame.ZIndex = 4
		local avCorner = Instance.new("UICorner")
		avCorner.CornerRadius = UDim.new(0, 8)
		avCorner.Parent = avFrame
		local avStroke = Instance.new("UIStroke")
		avStroke.Color = Color3.fromRGB(0, 0, 0)
		avStroke.Thickness = 2
		avStroke.Parent = avFrame

		local avImg = Instance.new("ImageLabel")
		avImg.Size = UDim2.new(1, -2, 1, -2)
		avImg.Position = UDim2.new(0.5, 0, 0.5, 0)
		avImg.AnchorPoint = Vector2.new(0.5, 0.5)
		avImg.BackgroundTransparency = 1
		avImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", entry.UserId > 0 and entry.UserId or 1)
		avImg.ScaleType = Enum.ScaleType.Fit
		avImg.ZIndex = 5
		local aviCorner = Instance.new("UICorner")
		aviCorner.CornerRadius = UDim.new(0, 7)
		aviCorner.Parent = avImg
		avImg.Parent = avFrame
		avFrame.Parent = row

		-- 3. Username (1.5X font)
		local userLbl = Instance.new("TextLabel")
		userLbl.Size = UDim2.new(0, 310, 1, 0)
		userLbl.Position = UDim2.new(0, 210, 0, 0)
		userLbl.BackgroundTransparency = 1
		userLbl.Text = entry.Username
		userLbl.Font = Enum.Font.GothamBold
		userLbl.TextSize = 28
		userLbl.TextColor3 = (rank == 1) and Color3.fromRGB(255, 235, 120) or Color3.fromRGB(255, 255, 255)
		userLbl.TextXAlignment = Enum.TextXAlignment.Left
		userLbl.TextTruncate = Enum.TextTruncate.AtEnd
		userLbl.ZIndex = 4
		userLbl.Parent = row

		-- 4. Total Cash (1.5X font)
		local cashLbl = Instance.new("TextLabel")
		cashLbl.Size = UDim2.new(0, 240, 1, 0)
		cashLbl.Position = UDim2.new(1, -250, 0, 0)
		cashLbl.BackgroundTransparency = 1
		cashLbl.Text = formatCash(entry.Cash)
		cashLbl.Font = Enum.Font.GothamBlack
		cashLbl.TextSize = 30
		cashLbl.TextColor3 = Color3.fromRGB(255, 215, 60)
		cashLbl.TextXAlignment = Enum.TextXAlignment.Right
		cashLbl.ZIndex = 4
		cashLbl.Parent = row

		row.Parent = scroll
	end
end

-- Generate fallback / mock top 100 entries so the board is always populated
local function generateFallbackTop100(): { { Rank: number, UserId: number, Username: string, Cash: number } }
	local list = {}
	local famous = {
		{ id = 1, name = "Roblox", cash = 1000000 },
		{ id = 156, name = "Builderman", cash = 750000 },
		{ id = 261, name = "Shedletsky", cash = 520000 },
		{ id = 80425, name = "Stickmasterluke", cash = 410000 },
		{ id = 68061, name = "Telamon", cash = 330000 },
		{ id = 1686, name = "Clockwork", cash = 280000 },
	}

	-- Add active real players currently in game at top tiers
	local rankIdx = 1
	for _, p in ipairs(Players:GetPlayers()) do
		local pCash = p:GetAttribute("OverallCash") or 50000
		table.insert(list, {
			Rank = rankIdx,
			UserId = p.UserId,
			Username = p.Name, -- Real username
			Cash = math.max(120000, pCash),
		})
		rankIdx = rankIdx + 1
	end

	for _, f in ipairs(famous) do
		if rankIdx <= 100 then
			table.insert(list, {
				Rank = rankIdx,
				UserId = f.id,
				Username = f.name,
				Cash = f.cash,
			})
			rankIdx = rankIdx + 1
		end
	end

	local mockNames = {
		"ApexBidder", "ShadowStrike", "HammerLord", "RuinsKing", "RiskTaker",
		"VaultMaster", "GoldHunter", "CyberBidder", "Fortress", "BlazeSurv",
		"NeonBids", "SilentWinner", "TitanShield", "OmegaCash", "EchoHunter",
		"ViperCash", "LuckyBids", "GhostSurv", "KrakenBid", "StormCash"
	}

	while rankIdx <= 100 do
		local namePattern = mockNames[((rankIdx - 1) % #mockNames) + 1] .. tostring(math.floor(rankIdx * 7))
		local baseCash = math.max(100, math.floor(250000 * math.exp(-rankIdx / 25)))
		table.insert(list, {
			Rank = rankIdx,
			UserId = 1,
			Username = namePattern,
			Cash = baseCash,
		})
		rankIdx = rankIdx + 1
	end

	return list
end

local function refreshGlobalLeaderboard(scroll: ScrollingFrame)
	local entries = {}
	local success = false

	if orderedStore then
		local ok, pages = pcall(function()
			return orderedStore:GetSortedAsync(false, 100)
		end)
		if ok and pages then
			local rawData = pages:GetCurrentPage()
			if rawData and #rawData >= 5 then
				success = true
				for rank, item in ipairs(rawData) do
					local uId = tonumber(item.key) or 1
					local cashVal = item.value or 0
					local realUsername = getUsernameFromUserId(uId)
					table.insert(entries, {
						Rank = rank,
						UserId = uId,
						Username = realUsername,
						Cash = cashVal,
					})
				end
			end
		end
	end

	if not success or #entries < 20 then
		entries = generateFallbackTop100()
	end

	populateLeaderboardRows(scroll, entries)
end

-- Save player cash to OrderedDataStore on stat change or leave
local function registerPlayerSave(player: Player)
	local function saveCash()
		if not orderedStore or player.UserId <= 0 then return end
		local cash = player:GetAttribute("OverallCash")
		if typeof(cash) == "number" and cash > 0 then
			pcall(function()
				orderedStore:SetAsync(tostring(player.UserId), math.floor(cash))
			end)
		end
	end

	player:GetAttributeChangedSignal("OverallCash"):Connect(saveCash)
end

-- Initialize Leaderboard
task.spawn(function()
	task.wait(2)
	local part = getLeaderboardPart()
	if not part then
		warn("[GlobalLeaderboard] Leaderboard part not found in Workspace.")
		return
	end

	part.Name = "LeaderboardDisplayPart"
	part.CanCollide = false
	part.Anchored = true
	local _, scroll = setupSurfaceGui(part)

	refreshGlobalLeaderboard(scroll)

	-- Periodically refresh every 60 seconds
	while true do
		task.wait(60)
		pcall(function()
			refreshGlobalLeaderboard(scroll)
		end)
	end
end)

for _, p in ipairs(Players:GetPlayers()) do
	registerPlayerSave(p)
end
Players.PlayerAdded:Connect(registerPlayerSave)

print("[GlobalLeaderboardManager] Initialized Global Top 100 Cash Leaderboard successfully.")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="23">
      <Properties>
        <string name="Name">GorillaSmashManager</string>
        <string name="Source"><![CDATA[--!strict
--for now we are not using this code for agents are any one dont read this 
-- GorillaSmashManager: Drives Gorilla-gem's authoritative 91-frame bone transform animation,
-- synchronizes frame-accurate impact timing at Frame 40 (t=1.33s), executes hit-stop weight,
-- triggers procedural VFX broadcast, and applies player damage.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local GorillaSmashManager = {}

-- Load 91-frame authoritative motion data
local ServerScriptService = game:GetService("ServerScriptService")
local motionDataModule = ReplicatedStorage:FindFirstChild("GorillaMotionData") or ServerScriptService:WaitForChild("GorillaMotionData", 10)
local frames: {{number}} = if motionDataModule then require(motionDataModule) else {}

-- RemoteEvent setup for Client VFX, Shockwave, & Camera Shake
local Network = ReplicatedStorage:FindFirstChild("Network")
local ImpactRemote = (Network and Network:FindFirstChild("GorillaImpactEvent"))
	or ReplicatedStorage:FindFirstChild("GorillaImpactEvent")

if not ImpactRemote then
	ImpactRemote = Instance.new("RemoteEvent")
	ImpactRemote.Name = "GorillaImpactEvent"
	ImpactRemote.Parent = Network or ReplicatedStorage
end

local function findGorillaModel(): Model?
	return Workspace:FindFirstChild("Gorilla-gem")
		or Workspace:FindFirstChild("Gorilla-gem", true)
		or Workspace:FindFirstChild("MainGorilla", true)
end

local function findGameplayArea(): Instance?
	local map = Workspace:FindFirstChild("BidToSurviveMap")
	if map and map:FindFirstChild("GameplayArea") then
		return map.GameplayArea
	end
	return Workspace:FindFirstChild("GameplayArea", true)
end

-- Retrieve surface center, color, material, and radius from GameplayArea / Walkway
local function getGameplaySurfaceData(): (Vector3, Color3, Enum.Material, number)
	local gameplayArea = findGameplayArea()
	if not gameplayArea then
		warn("[GorillaSmash] GameplayArea not found in Workspace!")
		return Vector3.new(0, 0, 0), Color3.fromRGB(115, 110, 100), Enum.Material.Slate, 45
	end

	local walkway = gameplayArea:FindFirstChild("Walkway", true)
	if walkway and walkway:IsA("BasePart") then
		local topPos = walkway.Position + Vector3.new(0, walkway.Size.Y * 0.5, 0)
		local radius = math.max(walkway.Size.X, walkway.Size.Z) * 0.5
		return topPos, walkway.Color, walkway.Material, radius
	end

	if gameplayArea:IsA("BasePart") then
		local topPos = gameplayArea.Position + Vector3.new(0, gameplayArea.Size.Y * 0.5, 0)
		return topPos, gameplayArea.Color, gameplayArea.Material, math.max(gameplayArea.Size.X, gameplayArea.Size.Z) * 0.5
	elseif gameplayArea:IsA("Model") then
		local cf, size = gameplayArea:GetBoundingBox()
		local basePart = gameplayArea.PrimaryPart or gameplayArea:FindFirstChildWhichIsA("BasePart", true)
		local topPos = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
		local color = basePart and basePart.Color or Color3.fromRGB(115, 110, 100)
		local mat = basePart and basePart.Material or Enum.Material.Slate
		return topPos, color, mat, math.max(size.X, size.Z) * 0.5
	end

	return Vector3.new(0, 0, 0), Color3.fromRGB(115, 110, 100), Enum.Material.Slate, 45
end

local function findBone(parent: Instance, name: string): Bone?
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("Bone") then
			if child.Name == name then return child end
			local f = findBone(child, name)
			if f then return f end
		end
	end
	return nil
end

local function ang(x: number, y: number, z: number): CFrame
	return CFrame.fromEulerAnglesXYZ(x, y, z)
end

-- Rig state cache
local gorillaModel: Model? = nil
local char1Mesh: MeshPart? = nil
local cachedBones: {[string]: Bone} = {}
local isPlaying = false

local function prepareRig()
	gorillaModel = findGorillaModel()
	if not gorillaModel then
		warn("[GorillaSmash] FATAL: Gorilla-gem model not found in Workspace!")
		return false
	end

	char1Mesh = gorillaModel:FindFirstChild("char1", true) :: MeshPart?
	if not char1Mesh then
		warn("[GorillaSmash] FATAL: char1 MeshPart not found in Gorilla-gem!")
		return false
	end

	gorillaModel.PrimaryPart = char1Mesh
	char1Mesh.Anchored = true

	-- Unanchor hammer parts so RigidConstraint can move hammer with hand bone
	local hammer = gorillaModel:FindFirstChild("Thors Hammer", true) or Workspace:FindFirstChild("Thors Hammer")
	if hammer and hammer.Parent ~= gorillaModel then
		hammer.Parent = gorillaModel
	end

	local unanchoredCount = 0
	for _, desc in ipairs(gorillaModel:GetDescendants()) do
		if desc:IsA("BasePart") and desc ~= char1Mesh then
			desc.Anchored = false
			desc.CanCollide = false
			if hammer and desc:IsDescendantOf(hammer) then
				desc.Massless = true
			end
			unanchoredCount += 1
		end
	end

	-- Cache all 15 active bones
	cachedBones = {
		Hips = findBone(char1Mesh, "Hips") :: Bone,
		Spine = findBone(char1Mesh, "Spine") :: Bone,
		Head = findBone(char1Mesh, "Head") :: Bone,
		RightArm = findBone(char1Mesh, "RightArm") :: Bone,
		RightForeArm = findBone(char1Mesh, "RightForeArm") :: Bone,
		RightHand = findBone(char1Mesh, "RightHand") :: Bone,
		LeftArm = findBone(char1Mesh, "LeftArm") :: Bone,
		LeftForeArm = findBone(char1Mesh, "LeftForeArm") :: Bone,
		LeftHand = findBone(char1Mesh, "LeftHand") :: Bone,
		RightUpLeg = findBone(char1Mesh, "RightUpLeg") :: Bone,
		RightLeg = findBone(char1Mesh, "RightLeg") :: Bone,
		RightFoot = findBone(char1Mesh, "RightFoot") :: Bone,
		LeftUpLeg = findBone(char1Mesh, "LeftUpLeg") :: Bone,
		LeftLeg = findBone(char1Mesh, "LeftLeg") :: Bone,
		LeftFoot = findBone(char1Mesh, "LeftFoot") :: Bone,
	}

	print(string.format("[GorillaSmash] [RIG] Rig ready! 1 Anchored (char1), %d unanchored (hammer). 15/15 Bones mapped.", unanchoredCount))
	return true
end

-- Public: Execute 91-frame hammer smash with frame-accurate impact at frame 40
function GorillaSmashManager.ExecuteSmashAndDamage(onImpactDamageCallback: (() -> ())?)
	if isPlaying then
		warn("[GorillaSmash] Smash already in progress, ignoring duplicate call.")
		return
	end

	if not prepareRig() or not gorillaModel then
		warn("[GorillaSmash] Rig could not be prepared, firing callback immediately.")
		if onImpactDamageCallback then task.spawn(onImpactDamageCallback) end
		return
	end

	isPlaying = true

	local impactPos, floorColor, floorMaterial, arenaRadius = getGameplaySurfaceData()
	print(string.format("[GorillaSmash] [EXECUTE] Target arena: pos=%s, radius=%.1f", tostring(impactPos), arenaRadius))

	-- Orient Gorilla-gem horizontally towards impact center
	local rootCFrame = gorillaModel:GetPivot()
	local lookTarget = Vector3.new(impactPos.X, rootCFrame.Position.Y, impactPos.Z)
	if (lookTarget - rootCFrame.Position).Magnitude > 0.5 then
		gorillaModel:PivotTo(CFrame.lookAt(rootCFrame.Position, lookTarget))
		print("[GorillaSmash] [EXECUTE] Gorilla pivoted to face arena center.")
	end

	-- Trigger swing audio on hammer handle
	local hammer = gorillaModel:FindFirstChild("Thors Hammer", true) or Workspace:FindFirstChild("Thors Hammer")
	local handle = hammer and hammer:FindFirstChild("Handle")
	if handle then
		local swingSound = handle:FindFirstChild("SwingSound") or handle:FindFirstChild("slash")
		if not swingSound then
			swingSound = Instance.new("Sound")
			swingSound.Name = "SwingSound"
			swingSound.SoundId = "rbxassetid://12222216"
			swingSound.Volume = 2.0
			swingSound.PlaybackSpeed = 0.95
			swingSound.Parent = handle
		end
		swingSound:Play()
		print("[GorillaSmash] [AUDIO] Swing sound triggered.")
	end

	-- Broadcast SMASH_START to all clients so they run the 91-frame bone playback locally
	ImpactRemote:FireAllClients("SMASH_START", impactPos, floorColor, floorMaterial, arenaRadius)
	print("[GorillaSmash] [NETWORK] Broadcast 'SMASH_START' to all clients.")

	-- Execute the 91-frame bone motion playback on server as well
	task.spawn(function()
		local totalFrames = #frames
		local fps = 30
		local frameDur = 1 / fps
		local impactTriggered = false
		local IMPACT_FRAME = 40 -- Authoritative ground strike frame (40 / 30fps = 1.33s)

		print(string.format("[GorillaSmash] [ANIMATION] Starting 91-frame motion playback (%d frames @ 30 FPS)...", totalFrames))

		for i = 1, totalFrames do
			local fd = frames[i]
			if not fd then continue end

			local dx, dy, dz = fd[2], fd[3], fd[4]
			local rrx, rry, rrz = fd[5], fd[6], fd[7]

			-- Hips root translation and rotation
			if cachedBones.Hips then
				cachedBones.Hips.Transform = CFrame.new(dx, dy, dz) * ang(rrx, rry, rrz)
			end

			-- Torso pitch & head
			if cachedBones.Spine then cachedBones.Spine.Transform = ang(fd[8], fd[9], fd[10]) end
			if cachedBones.Head then cachedBones.Head.Transform = ang(fd[11], fd[12], fd[13]) end

			-- Right Arm (holding Thor's Hammer via RigidConstraint)
			if cachedBones.RightArm then cachedBones.RightArm.Transform = ang(fd[14], fd[15], fd[16]) end
			if cachedBones.RightForeArm then cachedBones.RightForeArm.Transform = ang(fd[17], fd[18], fd[19]) end
			if cachedBones.RightHand then cachedBones.RightHand.Transform = ang(fd[20], fd[21], fd[22]) end

			-- Left Arm (two-handed grip on hammer handle)
			if cachedBones.LeftArm then cachedBones.LeftArm.Transform = ang(fd[23], fd[24], fd[25]) end
			if cachedBones.LeftForeArm then cachedBones.LeftForeArm.Transform = ang(fd[26], fd[27], fd[28]) end
			if cachedBones.LeftHand then cachedBones.LeftHand.Transform = ang(fd[29], fd[30], fd[31]) end

			-- Legs & feet
			if cachedBones.RightUpLeg then cachedBones.RightUpLeg.Transform = ang(fd[32], fd[33], fd[34]) end
			if cachedBones.RightLeg then cachedBones.RightLeg.Transform = ang(fd[35], fd[36], fd[37]) end
			if cachedBones.RightFoot then cachedBones.RightFoot.Transform = ang(fd[38], fd[39], fd[40]) end

			if cachedBones.LeftUpLeg then cachedBones.LeftUpLeg.Transform = ang(fd[41], fd[42], fd[43]) end
			if cachedBones.LeftLeg then cachedBones.LeftLeg.Transform = ang(fd[44], fd[45], fd[46]) end
			if cachedBones.LeftFoot then cachedBones.LeftFoot.Transform = ang(fd[47], fd[48], fd[49]) end

			-- Frame 40: EXACT GROUND SMASH IMPACT!
			if i == IMPACT_FRAME and not impactTriggered then
				impactTriggered = true
				print(string.format("[GorillaSmash] [IMPACT] 💥💥💥 FRAME %d IMPACT FIRED! 💥💥💥", i))

				-- 1. Broadcast Client VFX, Shockwave Rings, Camera Trauma & Sub-Bass Audio
				ImpactRemote:FireAllClients(impactPos, floorColor, floorMaterial, arenaRadius)

				-- 2. Execute server player damage on exact impact frame
				if onImpactDamageCallback then
					task.spawn(onImpactDamageCallback)
				end

				-- 3. Heavy hit-stop pause on impact (0.12s)
				print("[GorillaSmash] [HIT-STOP] Applying 0.12s hit-stop freeze...")
				task.wait(0.12)
				print("[GorillaSmash] [HIT-STOP] Hit-stop ended. Continuing follow-through.")
			else
				task.wait(frameDur)
			end
		end

		print("[GorillaSmash] [ANIMATION] Smash animation finished. Blending bones back to rest pose.")

		-- Smoothly reset bone transforms back to identity rest pose over 0.25s
		local steps = 8
		for s = 1, steps do
			local alpha = 1 - (s / steps)
			for _, bone in pairs(cachedBones) do
				bone.Transform = bone.Transform:Lerp(CFrame.new(), 1 - alpha)
			end
			task.wait(0.03)
		end

		for _, bone in pairs(cachedBones) do
			bone.Transform = CFrame.new()
		end

		isPlaying = false
		print("[GorillaSmash] [ANIMATION] Rest pose restored. Ready for next smash.")
	end)
end

-- Manual trigger listener (e.g. from pressing 'E' key)
ImpactRemote.OnServerEvent:Connect(function(player: Player, action: any)
	if action == "TRIGGER_SMASH" or action == "TEST_SMASH" then
		print(string.format("[GorillaSmash] 🕹️ Manual smash triggered by player: %s (Key 'E')", player.Name))
		GorillaSmashManager.ExecuteSmashAndDamage(function()
			print("[GorillaSmash] 💥 Manual impact executed successfully!")
		end)
	end
end)

-- Initialize on server startup
task.spawn(function()
	task.wait(1)
	prepareRig()
end)

return GorillaSmashManager
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">JetpackManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/JetpackManager.server.luau
-- Authoritative server-side Jetpack Attachment Manager for Bid-to-survive.
-- Guarantees every player automatically receives their own visible Jetpack model
-- securely attached to their back on spawn and every respawn.
-- Also manages server-side validation and multiplayer visual replication for the Jetpack Burst.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Network = ReplicatedStorage:FindFirstChild("Network")
if not Network then
	Network = Instance.new("Folder")
	Network.Name = "Network"
	Network.Parent = ReplicatedStorage
end

local JetpackBurstEvent: RemoteEvent = (Network:FindFirstChild("JetpackBurstEvent") :: RemoteEvent?)
	or Instance.new("RemoteEvent")
JetpackBurstEvent.Name = "JetpackBurstEvent"
JetpackBurstEvent.Parent = Network

local JetpackBurstReplicatedEvent: RemoteEvent = (Network:FindFirstChild("JetpackBurstReplicatedEvent") :: RemoteEvent?)
	or Instance.new("RemoteEvent")
JetpackBurstReplicatedEvent.Name = "JetpackBurstReplicatedEvent"
JetpackBurstReplicatedEvent.Parent = Network

-- 1. JETPACK TEMPLATE RETRIEVAL & INITIALIZATION
local function getOrCreateJetpackTemplate(): Model?
	local template = ServerStorage:FindFirstChild("JetpackTemplate") :: Model?
	if template then return template end

	-- Fallback if template is still in Workspace
	local wsJetpack = Workspace:FindFirstChild("Jetpack") :: Model?
	if wsJetpack then
		local newTemplate = wsJetpack:Clone()
		newTemplate.Name = "JetpackTemplate"
		local handle = newTemplate:FindFirstChild("Handle") :: BasePart?
		if handle then
			newTemplate.PrimaryPart = handle
			for _, child in ipairs(newTemplate:GetChildren()) do
				if child:IsA("BasePart") then
					child.Anchored = false
					child.CanCollide = false
					child.Massless = true
					if child ~= handle then
						local wc = Instance.new("WeldConstraint")
						wc.Name = child.Name .. "Weld"
						wc.Part0 = handle
						wc.Part1 = child
						wc.Parent = handle
					end
				end
			end
		end
		newTemplate.Parent = ServerStorage
		wsJetpack:Destroy()
		return newTemplate
	end

	warn("[JetpackManager] ⚠️ JetpackTemplate not found in ServerStorage or Workspace!")
	return nil
end

-- 2. JETPACK ATTACHMENT PIPELINE
local function attachJetpackToCharacter(player: Player, character: Model)
	if not character or not character.Parent then return end
	if character:FindFirstChild("Jetpack") then return end

	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid or humanoid.Health <= 0 then return end

	local template = getOrCreateJetpackTemplate()
	if not template then return end

	-- Support both R6 and R15 rigs
	local torso: BasePart? = nil
	local offset: CFrame = CFrame.identity

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		torso = character:WaitForChild("Torso", 5) :: BasePart?
		-- R6 Torso size is (2, 2, 1). Offset Z = 0.85 places Handle flush against back
		offset = CFrame.new(0, 0.10, 0.85)
	else
		torso = (character:WaitForChild("UpperTorso", 5) :: BasePart?)
			or (character:FindFirstChild("Torso") :: BasePart?)
		-- R15 UpperTorso size is (1.94, 1.70, 1.00). Offset Z = 0.85 aligns with BodyBackAttachment
		offset = CFrame.new(0, -0.10, 0.85)
	end

	if not torso or not character.Parent then return end

	-- Double-check after yields to avoid race conditions
	if character:FindFirstChild("Jetpack") then return end

	local jetpack = template:Clone()
	jetpack.Name = "Jetpack"
	local handle = jetpack:FindFirstChild("Handle") :: BasePart?
	if not handle then
		jetpack:Destroy()
		return
	end
	jetpack.PrimaryPart = handle

	-- Ensure all parts are unanchored, non-colliding, and massless
	for _, part in ipairs(jetpack:GetChildren()) do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.Massless = true
		end
	end

	-- Position jetpack flush to torso and weld
	jetpack:PivotTo(torso.CFrame * offset)
	jetpack.Parent = character

	local weld = Instance.new("WeldConstraint")
	weld.Name = "TorsoAttachmentWeld"
	weld.Part0 = torso
	weld.Part1 = handle
	weld.Parent = handle

	print(string.format("[JetpackManager] 🎒 Attached Jetpack to %s (%s rig)", player.Name, humanoid.RigType.Name))
end

-- 3. PLAYER & CHARACTER LIFECYCLE MANAGEMENT
local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		task.defer(attachJetpackToCharacter, player, character)
	end)

	-- Handle R15-to-R6 model swap or delayed rig ready state
	player:GetAttributeChangedSignal("R6RigReady"):Connect(function()
		if player:GetAttribute("R6RigReady") == true and player.Character then
			task.defer(attachJetpackToCharacter, player, player.Character)
		end
	end)

	if player.Character then
		task.defer(attachJetpackToCharacter, player, player.Character)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)

-- 4. BURST VALIDATION & MULTIPLAYER REPLICATION
local lastPlayerBurstTimes: { [Player]: number } = {}

JetpackBurstEvent.OnServerEvent:Connect(function(player: Player, flatDir: any)
	local now = os.clock()
	local lastTime = lastPlayerBurstTimes[player] or 0
	if (now - lastTime) < 1.05 then
		-- Cooldown throttle
		return
	end

	local char = player.Character
	if not char or not char.Parent then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	if player:GetAttribute("IsAFK") == true and player:GetAttribute("IsInGame") ~= true then return end

	lastPlayerBurstTimes[player] = now

	-- Replicate burst visuals to all clients (including direction)
	if typeof(flatDir) ~= "Vector3" or flatDir.Magnitude < 0.1 then
		local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			flatDir = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
		else
			flatDir = Vector3.new(0, 0, -1)
		end
	else
		flatDir = flatDir.Unit
	end

	JetpackBurstReplicatedEvent:FireAllClients(player, flatDir)
end)

Players.PlayerRemoving:Connect(function(player: Player)
	lastPlayerBurstTimes[player] = nil
end)

print("[JetpackManager] Initialized: Server Jetpack Attachment & Burst Replication active.")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="25">
      <Properties>
        <string name="Name">R6AvatarManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/R6AvatarManager.server.luau
-- Authoritative server-side R6 avatar pipeline for Bid-to-survive.
-- Guarantees that every player spawns as an authentic Roblox R6 character wearing their
-- exact live Roblox avatar appearance (skin tone, shirt, pants, face, hair & accessories)
-- so custom R6 animations (Walk: 90697464892050, Run: 125757170550820, Dive: 137603926461078)
-- articulate every joint natively with zero blank/black dummy issues.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local StarterPlayer = game:GetService("StarterPlayer")

-- 1. SAFETY CLEANUP: Destroy any blank StarterCharacter dummy that causes the "Black Mamba" bug!
local badStarterChar = StarterPlayer:FindFirstChild("StarterCharacter")
if badStarterChar then
	warn("[R6AvatarManager] Removed blank StarterCharacter from StarterPlayer so real avatars load!")
	badStarterChar:Destroy()
end

-- Fallback UserId for Studio Local Server test players (UserId <= 0)
local FALLBACK_USER_ID = (game.CreatorType == Enum.CreatorType.User and game.CreatorId > 0) and game.CreatorId or 4883714528

local convertingPlayers: { [Player]: boolean } = {}

local function getCleanR6Description(player: Player): HumanoidDescription
	local targetUserId = (player.UserId > 0) and player.UserId or FALLBACK_USER_ID

	local ok, desc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(targetUserId)
	end)

	if not ok or not desc then
		desc = Instance.new("HumanoidDescription")
		-- Warm natural skin tone fallback instead of pitch black (0,0,0)
		local defaultSkin = Color3.fromRGB(234, 184, 146)
		desc.HeadColor = defaultSkin
		desc.TorsoColor = Color3.fromRGB(45, 110, 210)
		desc.LeftArmColor = defaultSkin
		desc.RightArmColor = defaultSkin
		desc.LeftLegColor = Color3.fromRGB(40, 45, 55)
		desc.RightLegColor = Color3.fromRGB(40, 45, 55)
	end

	-- Clear R15 body package mesh overrides so R6 limbs remain classic blocky R6
	-- while preserving ALL clothing, skin colors, face, t-shirt, and accessories!
	desc.Torso = 0
	desc.LeftArm = 0
	desc.RightArm = 0
	desc.LeftLeg = 0
	desc.RightLeg = 0

	return desc
end

local function ensureAuthenticR6Avatar(player: Player, character: Model)
	if convertingPlayers[player] then return end

	local hum = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not hum then return end

	local function stripDefaultRobloxHealth(char: Model)
		local defaultHealth = char:FindFirstChild("Health")
		if defaultHealth and defaultHealth:IsA("Script") then
			defaultHealth.Disabled = true
			defaultHealth:Destroy()
		end
	end

	-- If already R6, verify BodyColors is not pitch black from an empty template
	if hum.RigType == Enum.HumanoidRigType.R6 then
		stripDefaultRobloxHealth(character)
		local bodyColors = character:FindFirstChildOfClass("BodyColors")
		if bodyColors and bodyColors.HeadColor3 == Color3.new(0, 0, 0) and not character:FindFirstChildOfClass("Shirt") then
			convertingPlayers[player] = true
			local desc = getCleanR6Description(player)
			pcall(function()
				hum:ApplyDescription(desc)
			end)
			convertingPlayers[player] = false
		end
		print(string.format("[R6AvatarManager] ✅ %s is authentic R6 with full avatar appearance.", player.Name))
		player:SetAttribute("R6RigReady", true)
		print(string.format("[BOOT HIERARCHY] 👤 Step 1: %s verified authentic R6 character. R6RigReady=true.", player.Name))
		return
	end

	-- Convert R15 -> Official Roblox R6 Model with full avatar clothing, skin, face & accessories!
	convertingPlayers[player] = true

	local spawnCF = character:GetPivot()
	local desc = getCleanR6Description(player)

	local ok, r6Model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)

	if ok and r6Model then
		r6Model.Name = player.Name
		stripDefaultRobloxHealth(r6Model)

		-- Copy StarterCharacterScripts into the new R6 character
		local scs = StarterPlayer:FindFirstChild("StarterCharacterScripts")
		if scs then
			for _, item in ipairs(scs:GetChildren()) do
				if not r6Model:FindFirstChild(item.Name) then
					item:Clone().Parent = r6Model
				end
			end
		end

		r6Model:PivotTo(spawnCF)
		r6Model.Parent = Workspace
		player.Character = r6Model
		task.defer(function()
			if character and character.Parent then
				character:Destroy()
			end
		end)

		player:SetAttribute("R6RigReady", true)
		print(string.format("[R6AvatarManager] 🔄 Converted %s from R15 to authentic R6 with full avatar appearance!", player.Name))
		print(string.format("[BOOT HIERARCHY] 👤 Step 1: %s converted to authentic R6 character. R6RigReady=true.", player.Name))
	else
		warn(string.format("[R6AvatarManager] Failed to build R6 model for %s: %s", player.Name, tostring(r6Model)))
	end

	task.delay(0.1, function()
		convertingPlayers[player] = false
	end)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		task.defer(ensureAuthenticR6Avatar, player, character)
	end)
	if player.Character then
		task.defer(ensureAuthenticR6Avatar, player, player.Character)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)

print("[R6AvatarManager] Initialized: Authentic Roblox R6 Avatar Pipeline active.")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">RoundManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- BID TO SURVIVE - Master Round Manager
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local RuinsDoorHandManager = require(ServerScriptService:WaitForChild("RuinsDoorHandManager"))
local CashAndWalletManager = require(ServerScriptService:WaitForChild("CashAndWalletManager"))
local TestPlayerSpawner = require(ServerScriptService:WaitForChild("TestPlayerSpawner"))
local ArenaManager = require(ServerScriptService:WaitForChild("ArenaManager"))
local Network = ReplicatedStorage:WaitForChild("Network")

local StateChanged = Network:WaitForChild("StateChanged")
local PromptBid = Network:WaitForChild("PromptBid")
local BidSubmitted = Network:WaitForChild("BidSubmitted")
local RankingsRevealed = Network:WaitForChild("RankingsRevealed")
local PromptVote = Network:WaitForChild("PromptVote")
local VoteSubmitted = Network:WaitForChild("VoteSubmitted")
local HammerSmash = Network:WaitForChild("HammerSmash")
local RoundOver = Network:WaitForChild("RoundOver")
local MatchOver = Network:WaitForChild("MatchOver")
local StatsUpdated = Network:WaitForChild("StatsUpdated")
local GetGameState = Network:WaitForChild("GetGameState")

-- Ensure SetAFK RemoteEvent exists
local SetAFK = Network:FindFirstChild("SetAFK")
if not SetAFK then
    SetAFK = Instance.new("RemoteEvent")
    SetAFK.Name = "SetAFK"
    SetAFK.Parent = Network
end

-- Ensure ParticipationChanged RemoteEvent exists
local ParticipationChanged = Network:FindFirstChild("ParticipationChanged")
if not ParticipationChanged then
    ParticipationChanged = Instance.new("RemoteEvent")
    ParticipationChanged.Name = "ParticipationChanged"
    ParticipationChanged.Parent = Network
end

-- Ensure ClientLoadReadyEvent RemoteEvent exists
local ClientLoadReadyEvent = Network:FindFirstChild("ClientLoadReadyEvent")
if not ClientLoadReadyEvent then
    ClientLoadReadyEvent = Instance.new("RemoteEvent")
    ClientLoadReadyEvent.Name = "ClientLoadReadyEvent"
    ClientLoadReadyEvent.Parent = Network
end

ClientLoadReadyEvent.OnServerEvent:Connect(function(player)
    player:SetAttribute("ClientReady", true)
    print(string.format("[BOOT HIERARCHY] 📥 Received ClientLoadReadyEvent from %s. ClientReady=true", player.Name))
end)

local Map = workspace:FindFirstChild("BidToSurviveMap") or workspace
local SpawnArea = workspace:FindFirstChild("SpawnArea") or (Map:FindFirstChild("SpawnArea") or workspace:WaitForChild("SpawnArea", 5))
local GameplayArea = workspace:FindFirstChild("GameplayArea") or (Map:FindFirstChild("GameplayArea") or workspace:WaitForChild("GameplayArea", 5))
local Walkway = GameplayArea:WaitForChild("Walkway", 5) or GameplayArea:FindFirstChild("Walkway")
local Executioner = GameplayArea:FindFirstChild("Executioner")

-- Initialize Domain Managers
TestPlayerSpawner.Init(GameConfig, GameplayArea, Walkway)
ArenaManager.Init(SpawnArea, GameplayArea, Walkway)

-- State Variables
local CurrentRound = 0
local CurrentRoundSession = 0
local CurrentPhase = "Intermission"
local PhaseTimer = 0
local CurrentRarity = GameConfig.HammerRarities.Common
local MatchActive = false
local PhaseStartTime = 0

-- Player Data Store { [UserId] = { Money, Health, IsAlive, IsAFK, CurrentBid, Votes, IsBot, Name, UserId, Character, SubmitTime } }
local PlayerData = {}
local ExposedPlayerId = nil
local ActiveBots = {}

--------------------------------------------------------------------------------
-- UTILITY & STATS
--------------------------------------------------------------------------------

local function toCents(dollars: number): number
    return math.round((dollars or 0) * 100)
end

local function toDollars(cents: number): number
    return cents / 100
end

local function GetActivePlayers()
    local active = {}
    for id, data in pairs(PlayerData) do
        if data.IsAlive and data.ParticipationState == "Active" then
            table.insert(active, data)
        end
    end
    return active
end

local function GetActiveRealPlayers()
    local active = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local data = PlayerData[player.UserId]
        if data and data.IsAlive and data.ParticipationState == "Active" then
            table.insert(active, player)
        end
    end
    return active
end

local function GetLivingPlayers()
    return GetActivePlayers()
end

local function GetLivingRealPlayers()
    return GetActiveRealPlayers()
end

local function GetSpectatorPlayers()
    local spectators = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local data = PlayerData[player.UserId]
        if data and not data.IsAlive and data.ParticipationState == "Eliminated" then
            table.insert(spectators, player)
        end
    end
    return spectators
end

local function GetReadyEligiblePlayers()
    local ready = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local isAfk = (player:GetAttribute("IsAFK") == true)
        local isClientReady = (player:GetAttribute("ClientReady") == true)
        local isR6Ready = (player:GetAttribute("R6RigReady") == true)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local isLiving = (hum ~= nil and hum.Health > 0)
        local isR6 = (hum ~= nil and hum.RigType == Enum.HumanoidRigType.R6)
        local isReady = isLiving and (hrp ~= nil) and (isClientReady or isR6Ready or isR6)

        if not isAfk and isReady then
            table.insert(ready, player)
        end
    end
    return ready
end

local function BroadcastState(phaseName, duration, extra)
    CurrentPhase = phaseName
    PhaseTimer = duration or 0
    local livingCount = #GetActivePlayers()
    local deadline = os.clock() + (duration or 0)
    
    print(string.format("[ROUND MANAGER] Phase: %s | Round: %d | Duration: %ds | Active Living: %d", phaseName, CurrentRound, PhaseTimer, livingCount))
    StateChanged:FireAllClients({
        Phase = CurrentPhase,
        Duration = PhaseTimer,
        Deadline = deadline,
        Round = CurrentRound,
        Rarity = CurrentRarity,
        LivingCount = livingCount,
        ExposedPlayer = ExposedPlayerId and PlayerData[ExposedPlayerId] and PlayerData[ExposedPlayerId].Name or nil,
        Extra = extra,
        SpinnerReel = extra and extra.SpinnerReel or nil,
    })
end

local function SyncStats(player)
    local data = PlayerData[player.UserId]
    if data then
        local pState = data.ParticipationState or (data.IsAFK and "AFK" or "WaitingInLobby")
        player:SetAttribute("Money", data.Money)
        player:SetAttribute("Wallet", data.Money)
        player:SetAttribute("Health", data.Health)
        player:SetAttribute("HP", data.Health)
        StatsUpdated:FireClient(player, {
            Money = data.Money,
            Health = data.Health,
            IsAlive = data.IsAlive,
            IsAFK = data.IsAFK,
            ParticipationState = pState,
            Round = CurrentRound
        })
        if ParticipationChanged then
            ParticipationChanged:FireClient(player, pState)
        end
    end
end

local function SyncAllStats()
    for _, player in ipairs(Players:GetPlayers()) do
        SyncStats(player)
    end
end

--------------------------------------------------------------------------------
-- TELEPORTATION & ARENA MANAGEMENT (DELEGATED TO ArenaManager)
--------------------------------------------------------------------------------

local function TeleportCharacter(char, targetPos)
    ArenaManager.TeleportCharacter(char, targetPos)
end

local function TeleportToLobby(player)
    ArenaManager.TeleportToLobby(player)
end

local function TeleportToArena(player)
    ArenaManager.TeleportToArena(player)
end

local function RecoverToPlayArea(char)
    ArenaManager.RecoverToPlayArea(char)
end

--------------------------------------------------------------------------------
-- TEST PLAYERS / BOTS (DELEGATED TO TestPlayerSpawner)
--------------------------------------------------------------------------------

local function CleanupBots()
    TestPlayerSpawner.CleanupTestPlayers()
    ActiveBots = TestPlayerSpawner.GetActiveTestPlayers()
end

local function SetupCompanionBots(targetTotal)
    local realEligibleCount = #GetReadyEligiblePlayers()
    if realEligibleCount == 0 then realEligibleCount = #GetLivingRealPlayers() end
    if realEligibleCount == 0 then realEligibleCount = #Players:GetPlayers() end
    TestPlayerSpawner.SpawnTestPlayers(targetTotal, realEligibleCount, PlayerData)
    ActiveBots = TestPlayerSpawner.GetActiveTestPlayers()
end

--------------------------------------------------------------------------------
-- NEON GREEN BID WINNER GLOW SHIELD (DELEGATED TO ArenaManager)
--------------------------------------------------------------------------------

local function ClearWinnerGlow()
    ArenaManager.ClearWinnerGlow(ActiveBots)
end

local function ApplyWinnerGlow(char)
    ArenaManager.ApplyWinnerGlow(char)
end

--------------------------------------------------------------------------------
-- HAMMER SMASH EXECUTION
--------------------------------------------------------------------------------

local function TriggerHammerSmash(rarity, onImpactCallback, customPlayerData)
    HammerSmash:FireAllClients({
        Rarity = rarity,
        ImpactDelay = 3.27
    })
    
    RuinsDoorHandManager.ExecuteSequenceAndDamage(
        onImpactCallback,
        customPlayerData,
        function(isOpen)
            local map = workspace:FindFirstChild("BidToSurviveMap")
            local ruinsDoor = (map and (map:FindFirstChild("Ruins door") or map:FindFirstChild("RuinsDoor")))
                or workspace:FindFirstChild("Ruins door")
                or workspace:FindFirstChild("RuinsDoor")
            if ruinsDoor then
                for _, desc in ipairs(ruinsDoor:GetDescendants()) do
                    local nameLower = desc.Name:lower()
                    if nameLower:find("partinvinciblewhenopening") or nameLower:find("partinvisiblewhenopening") then
                        if desc:IsA("BasePart") then
                            desc.Transparency = isOpen and 1 or 0
                            desc.CanCollide = not isOpen
                        end
                    end
                end
            end
        end
    )
end

--------------------------------------------------------------------------------
-- MATCH LIFECYCLE
--------------------------------------------------------------------------------

local function InitMatch()
    CurrentRound = 0
    MatchActive = true
    ExposedPlayerId = nil
    
    -- Cleanly respawn any dead players, restore 100 HP, reset attributes, and fire ResetHUDStateEvent
    RuinsDoorHandManager.ResetAllPlayersForNewGame()
    
    local startingWallet = CashAndWalletManager.STARTING_GAME_WALLET or 20
    local eligibleToEnter = {}

    for _, player in ipairs(Players:GetPlayers()) do
        -- AFK IS EVALUATED ONLY HERE: AT GAME START BEFORE TAKING PLAYERS TO THE GAME AREA!
        local isAfk = (player:GetAttribute("IsAFK") == true)
        local isClientReady = (player:GetAttribute("ClientReady") == true)
        local isR6Ready = (player:GetAttribute("R6RigReady") == true)
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local isLiving = (hum ~= nil and hum.Health > 0)
        local isR6 = (hum ~= nil and hum.RigType == Enum.HumanoidRigType.R6)
        local isReady = isLiving and (hrp ~= nil) and (isClientReady or isR6Ready or isR6)

        local admittedToGame = (not isAfk) and isReady
        local partState
        if isAfk then
            partState = "AFK"
        elseif admittedToGame then
            partState = "Active"
            table.insert(eligibleToEnter, player)
        else
            partState = "WaitingInLobby"
        end

        PlayerData[player.UserId] = {
            UserId = player.UserId,
            Name = player.DisplayName,
            Money = startingWallet,
            Wallet = startingWallet,
            Health = GameConfig.MaxHealth,
            IsAlive = true,
            IsAFK = isAfk,
            ParticipationState = partState,
            CurrentBid = 0,
            Votes = 0,
            IsBot = false,
            Character = player.Character
        }
        player:SetAttribute("Money", startingWallet)
        player:SetAttribute("Wallet", startingWallet)
        player:SetAttribute("Health", GameConfig.MaxHealth)
        player:SetAttribute("HP", GameConfig.MaxHealth)
        player:SetAttribute("IsInGame", partState == "Active")

        if partState ~= "Active" then
            TeleportToLobby(player)
        end
    end
    
    SetupCompanionBots(10)
    CashAndWalletManager.StartGameForPlayers(eligibleToEnter)
    SyncAllStats()
    ClearWinnerGlow()
end

local function RunMatch(session)
    InitMatch()
    local matchStartTime = os.clock()
    local matchEliminations = {}
    
    while MatchActive do
        if session ~= CurrentRoundSession then
            print("[ROUND] Obsolete session cancelled.")
            break
        end
        
        CurrentRound = CurrentRound + 1
        
        -- Test players remain active if alive
        TestPlayerSpawner.ResetParticipation()
        
        -- Sync stats for current round
        SyncAllStats()
        
        local living = GetActivePlayers()
        
        -- Check Sole Survivor / Win condition
        if #living <= 1 then
            local winner = living[1]
            local winRealName = winner and winner.Name or "No One"
            local winDisplayName = winRealName
            if winner then
                if winner.DisplayName then
                    winDisplayName = winner.DisplayName
                elseif not winner.IsBot and winner.UserId and winner.UserId > 0 then
                    local pObj = Players:GetPlayerByUserId(winner.UserId)
                    if pObj then
                        winDisplayName = pObj.DisplayName
                        winRealName = pObj.Name
                    end
                end
            end
            local totalDuration = math.max(1, math.floor(os.clock() - matchStartTime))
            print("[ROUND MANAGER] Match Ended! Sole Survivor: " .. winDisplayName .. " (" .. winRealName .. ")")
            CashAndWalletManager.EndGameAndRewardSurvivors()
            BroadcastState("MatchOver", 8, { Winner = winDisplayName, WinnerRealName = winRealName })

            local podium = {}
            if winner then
                table.insert(podium, {
                    Rank = 1,
                    UserId = winner.UserId or 1,
                    Name = winRealName,
                    DisplayName = winDisplayName,
                    SurvivalTime = totalDuration,
                    IsBot = winner.IsBot == true,
                })
            else
                table.insert(podium, {
                    Rank = 1,
                    UserId = 1,
                    Name = winRealName,
                    DisplayName = winDisplayName,
                    SurvivalTime = totalDuration,
                    IsBot = false,
                })
            end

            -- Rank 2 (last eliminated before winner)
            if #matchEliminations >= 1 then
                local p2 = matchEliminations[#matchEliminations]
                local p2Disp = p2.DisplayName or p2.Name or "RunnerUp"
                if not p2.IsBot and p2.UserId and p2.UserId > 0 then
                    local pObj = Players:GetPlayerByUserId(p2.UserId)
                    if pObj then p2Disp = pObj.DisplayName end
                end
                table.insert(podium, {
                    Rank = 2,
                    UserId = p2.UserId or 1,
                    Name = p2.Name or "RunnerUp",
                    DisplayName = p2Disp,
                    SurvivalTime = p2.SurvivalTime or math.max(1, totalDuration - 12),
                    IsBot = p2.IsBot == true,
                })
            else
                table.insert(podium, {
                    Rank = 2,
                    UserId = 1,
                    Name = "RunnerUp",
                    DisplayName = "RunnerUp",
                    SurvivalTime = math.max(1, totalDuration - 12),
                    IsBot = true,
                })
            end

            -- Rank 3 (second-to-last eliminated)
            if #matchEliminations >= 2 then
                local p3 = matchEliminations[#matchEliminations - 1]
                local p3Disp = p3.DisplayName or p3.Name or "Contender"
                if not p3.IsBot and p3.UserId and p3.UserId > 0 then
                    local pObj = Players:GetPlayerByUserId(p3.UserId)
                    if pObj then p3Disp = pObj.DisplayName end
                end
                table.insert(podium, {
                    Rank = 3,
                    UserId = p3.UserId or 2,
                    Name = p3.Name or "Contender",
                    DisplayName = p3Disp,
                    SurvivalTime = p3.SurvivalTime or math.max(1, totalDuration - 25),
                    IsBot = p3.IsBot == true,
                })
            else
                table.insert(podium, {
                    Rank = 3,
                    UserId = 2,
                    Name = "Contender",
                    DisplayName = "Contender",
                    SurvivalTime = math.max(1, totalDuration - 25),
                    IsBot = true,
                })
            end

            MatchOver:FireAllClients({
                Winner = winDisplayName,
                WinnerRealName = winRealName,
                RoundsSurvived = CurrentRound - 1,
                TotalDuration = totalDuration,
                Podium = podium,
            })
            task.wait(8)
            for _, p in ipairs(Players:GetPlayers()) do
                TeleportToLobby(p)
                p:SetAttribute("IsInGame", false)
                local pData = PlayerData[p.UserId]
                if pData then
                    local isAfk = (p:GetAttribute("IsAFK") == true)
                    pData.IsAFK = isAfk
                    pData.ParticipationState = isAfk and "AFK" or "WaitingInLobby"
                    SyncStats(p)
                end
            end
            CleanupBots()
            ClearWinnerGlow()
            MatchActive = false
            break
        end
        
        -- Roll Server-Authoritative Rarity using Round-by-Round Probability Weights
        CurrentRarity = GameConfig.RollRarity(CurrentRound)
        local spinnerReel = GameConfig.BuildRandomSpinnerStrip(CurrentRound, 19, 19, CurrentRarity.Name)
        print(string.format("[ROUND] Rolled Hammer for Round %d: %s (%d%% DMG)", CurrentRound, CurrentRarity.Name, CurrentRarity.DamagePercent))
        
        ------------------------------------------------------------------------
        -- PHASE 1: SPAWN / HAMMER ROULETTE REVEAL
        ------------------------------------------------------------------------
        local spawnDuration = GameConfig.SpawnPhaseTime or 8.0
        print(string.format("[ROUND] HammerReveal START duration=%.1f", spawnDuration))
        local p1Start = os.clock()
        
        -- Only teleport active real players to the arena!
        for _, p in ipairs(GetActiveRealPlayers()) do
            TeleportToArena(p)
        end
        
        -- Reset test players to arena in natural circular scatter
        TestPlayerSpawner.ScatterTestPlayers()
        
        BroadcastState("Phase1_Spawn", spawnDuration, {
            Round = CurrentRound,
            Rarity = CurrentRarity,
            SpinnerReel = spinnerReel,
            RouletteDuration = GameConfig.RouletteDuration or 6.0,
            HoldDuration = GameConfig.RouletteHoldTime or 1.5,
        })
        task.wait(spawnDuration)
        print(string.format("[ROUND] HammerReveal END elapsed=%.2f", os.clock() - p1Start))
        task.wait(1.5) -- 1.5s delay before bidding phase begins
        
        ------------------------------------------------------------------------
        -- PHASE 3: BID FOR SURVIVAL (Exactly 10 Seconds)
        ------------------------------------------------------------------------
        local bidDuration = GameConfig.BidTime or 10.0
        print(string.format("[ROUND] Bidding START duration=%.1f", bidDuration))
        PhaseStartTime = os.clock()
        
        for _, d in ipairs(living) do
            d.CurrentBid = 0
            d.SubmitTime = nil
        end
        TestPlayerSpawner.GenerateBids(living)
        
        BroadcastState("Phase3_Bid", bidDuration, { ExposedPlayerId = ExposedPlayerId })
        PromptBid:FireAllClients({
            Duration = bidDuration,
            ExposedPlayer = ExposedPlayerId and PlayerData[ExposedPlayerId] and PlayerData[ExposedPlayerId].Name or nil
        })
        
        -- Strictly enforce the full 10-second duration even if all players bid early!
        task.wait(bidDuration)
        print(string.format("[ROUND] Bidding END elapsed=%.2f", os.clock() - PhaseStartTime))
        task.wait(1.5) -- 1.5s delay between phases
        
        ------------------------------------------------------------------------
        -- PHASE 4: REVEAL THE RANKINGS & APPLY NEON GREEN SHIELD GLOW
        ------------------------------------------------------------------------
        local revealDuration = GameConfig.RevealRankingsTime or 5.0
        print(string.format("[ROUND] Rankings START duration=%.1f", revealDuration))
        local p4Start = os.clock()
        
        -- Re-filter active players to guarantee anyone who toggled AFK mid-round is excluded from rankings and safe count
        living = GetActivePlayers()
        
        -- Exact integer-cent tie-breaker sort: Bid DESC, earliest SubmitTime ASC
        table.sort(living, function(a, b)
            local aCents = math.round((a.CurrentBid or 0) * 100)
            local bCents = math.round((b.CurrentBid or 0) * 100)
            if aCents ~= bCents then
                return aCents > bCents
            end
            return (a.SubmitTime or 999) < (b.SubmitTime or 999)
        end)
        
        local safeCount = math.max(1, math.ceil(#living * 0.5))
        local topBidders = {}
        local bottomBidders = {}
        
        for i, d in ipairs(living) do
            local pName = d.Name
            local pDisp = d.DisplayName or d.Name
            if not d.IsBot and d.UserId and d.UserId > 0 then
                local realP = Players:GetPlayerByUserId(d.UserId)
                if realP then
                    pName = realP.Name
                    pDisp = realP.DisplayName
                end
            end
            local bidderInfo = {
                UserId = d.UserId,
                Name = pName,
                DisplayName = pDisp,
                CurrentBid = d.CurrentBid,
                SubmitTime = d.SubmitTime or 10.00,
                IsBot = d.IsBot,
                Money = d.Money,
                Health = d.Health
            }
            if i <= safeCount then
                table.insert(topBidders, bidderInfo)
            else
                table.insert(bottomBidders, bidderInfo)
            end
        end
        
        -- Apply vibrant neon green glow to all winning bid characters!
        ClearWinnerGlow()
        for _, bidder in ipairs(topBidders) do
            if bidder.IsBot and bidder.Character then
                ApplyWinnerGlow(bidder.Character)
            else
                local p = Players:GetPlayerByUserId(bidder.UserId)
                if p and p.Character then
                    ApplyWinnerGlow(p.Character)
                end
            end
        end
        
        RankingsRevealed:FireAllClients({
            Duration = revealDuration,
            TopBidders = topBidders,
            BottomBidders = bottomBidders,
            SafeCount = safeCount
        })
        BroadcastState("Phase4_Reveal", revealDuration, {
            TopBidders = topBidders,
            BottomBidders = bottomBidders
        })
        task.wait(revealDuration)
        print(string.format("[ROUND] Rankings END elapsed=%.2f", os.clock() - p4Start))
        task.wait(1.5) -- 1.5s delay between phases
        
        ------------------------------------------------------------------------
        -- PHASE 5: THE SURVIVAL STANCE & RUINS DOOR HAZARD SMASH (9s)
        ------------------------------------------------------------------------
        local scrambleDuration = GameConfig.ScrambleTime or 9.0
        print(string.format("[ROUND] SurvivalStance START duration=%.1f", scrambleDuration))
        local p5Start = os.clock()
        
        BroadcastState("Phase5_Scramble", scrambleDuration, { SafeCount = safeCount })
        
        -- Autonomous Scramble: Unprotected test players sprint away from danger circle!
        task.spawn(function()
            local circleCenter, circleRadius = RuinsDoorHandManager.CalculateTargetDangerCircle(PlayerData)
            TestPlayerSpawner.ScrambleTestPlayers(circleCenter, circleRadius)
        end)
        
        local dmg = math.floor((GameConfig.MaxHealth * CurrentRarity.DamagePercent) / 100)
        
        -- Trigger Phase 6 Hammer Smash notification as the arm apex raise/slam approaches
        task.delay(1.5, function()
            BroadcastState("Phase6_Smash", 4.0, { Rarity = CurrentRarity })
        end)
        
        TriggerHammerSmash(CurrentRarity, function(escapedPlayers, hitPlayers)
            -- Impact damage applied ONLY to players caught inside the 80% Red Circle and unprotected!
            local hitSet = {}
            if hitPlayers then
                for _, p in ipairs(hitPlayers) do
                    hitSet[p] = true
                    if typeof(p) == "Instance" and p:IsA("Player") then
                        hitSet[p.UserId] = true
                    end
                end
            end

            for _, player in ipairs(GetLivingRealPlayers()) do
                local pData = PlayerData[player.UserId]
                local isProtected = (player.Character and player.Character:FindFirstChild("SafeBidGlow") ~= nil)
                local wasCaught = (hitPlayers == nil) or (hitSet[player] or hitSet[player.UserId])
                if not isProtected and wasCaught and pData then
                    pData.Health = math.max(0, pData.Health - dmg)
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.Health = pData.Health
                    end
                end
            end
            
            for _, bData in ipairs(living) do
                if bData.IsBot and bData.Character then
                    local isProtected = (bData.Character:FindFirstChild("SafeBidGlow") ~= nil)
                    local wasCaught = (hitPlayers == nil) or (hitSet[bData.Character] or hitSet[bData.Character.Name] or hitSet[bData.UserId])
                    if not isProtected and wasCaught then
                        bData.Health = math.max(0, bData.Health - dmg)
                        local hum = bData.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum.Health = bData.Health end
                        bData.Character:SetAttribute("Health", bData.Health)
                        bData.Character:SetAttribute("HP", bData.Health)
                    end
                end
            end
        end, PlayerData)
        
        ClearWinnerGlow()
        print(string.format("[ROUND] SurvivalStance & Smash END elapsed=%.2f", os.clock() - p5Start))
        task.wait(1.5) -- 1.5s delay between phases
        
        ------------------------------------------------------------------------
        -- PHASE 7: SETTLEMENT & ELIMINATIONS (4 Seconds)
        ------------------------------------------------------------------------
        local settlementDuration = GameConfig.SettlementTime or 4.0
        print(string.format("[ROUND] Settlement START duration=%.1f", settlementDuration))
        local p7Start = os.clock()
        
        local elims = {}
        for _, d in ipairs(living) do
            if d.Health <= 0 and d.IsAlive then
                d.IsAlive = false
                d.ParticipationState = "Eliminated"
                local survTime = math.max(1, math.floor(os.clock() - matchStartTime))
                table.insert(matchEliminations, {
                    UserId = d.UserId or 1,
                    Name = d.Name or "Player",
                    DisplayName = d.DisplayName or d.Name or "Player",
                    SurvivalTime = survTime,
                    IsBot = d.IsBot == true,
                })
                table.insert(elims, d.Name .. " (Eliminated)")
                if not d.IsBot then
                    local p = Players:GetPlayerByUserId(d.UserId)
                    if p then
                        p:SetAttribute("IsInGame", false)
                        CashAndWalletManager.SettlePlayerGameCash(p, "Eliminated")
                        TeleportToLobby(p)
                    end
                elseif d.Character then
                    d.Character:Destroy()
                end
            end
        end
        
        SyncAllStats()
        
        RoundOver:FireAllClients({
            Duration = settlementDuration,
            Eliminations = elims,
            Round = CurrentRound
        })
        BroadcastState("Phase7_Settlement", settlementDuration, { Eliminations = elims })
        task.wait(settlementDuration)
        print(string.format("[ROUND] Settlement END elapsed=%.2f", os.clock() - p7Start))
        task.wait(1.5) -- 1.5s delay before next round begins
    end
end

--------------------------------------------------------------------------------
-- EVENT LISTENERS
--------------------------------------------------------------------------------

BidSubmitted.OnServerEvent:Connect(function(player, amount)
    local data = PlayerData[player.UserId]
    if data and data.IsAlive and data.ParticipationState == "Active" and CurrentPhase == "Phase3_Bid" then
        if data.SubmitTime ~= nil then
            return -- Only first valid bid is accepted
        end
        local bid = tonumber(amount)
        if not bid or bid ~= bid or bid <= 0 then
            warn(string.format("[SECURITY] Rejected non-positive/invalid bid %s from %s", tostring(amount), player.Name))
            return
        end
        local ok, actualBid = CashAndWalletManager.TrySpendFromWallet(player, bid)
        if not ok then return end
        data.CurrentBid = actualBid
        data.Money = player:GetAttribute("Wallet") or (data.Money - actualBid)
        data.Wallet = data.Money
        local elapsed = math.max(0.01, os.clock() - PhaseStartTime)
        data.SubmitTime = math.floor(elapsed * 100) / 100
        SyncStats(player)
        print(string.format("[ROUND MANAGER] %s placed bid: $%.2f in %.2fs (Wallet remaining: $%.2f)", player.Name, data.CurrentBid, data.SubmitTime, player:GetAttribute("Wallet") or 0))
    else
        warn(string.format("[SECURITY] Rejected bid from inactive/eliminated player %s", player.Name))
    end
end)

-- Dead player vote sabotage removed per requirements

-- AFK toggle listener (Stores preference; evaluated ONLY when next game starts before taking players to game area)
SetAFK.OnServerEvent:Connect(function(player, isAfk)
    local data = PlayerData[player.UserId]
    if not data then
        InitPlayer(player)
        data = PlayerData[player.UserId]
    end
    if not data then return end
    
    local wantAfk = (isAfk == true)
    data.IsAFK = wantAfk
    player:SetAttribute("IsAFK", wantAfk)
    
    -- ONLY update participation state if player is NOT in an active game
    if data.ParticipationState ~= "Active" then
        data.ParticipationState = wantAfk and "AFK" or "WaitingInLobby"
        SyncStats(player)
        print(string.format("[ROUND MANAGER] %s updated lobby AFK state to %s", player.Name, tostring(wantAfk)))
    else
        -- Player is actively playing in the game area.
        -- Specifications: Just store the value and consider only when next game starts!
        print(string.format("[ROUND MANAGER] %s toggled AFK = %s in game area (stored for next game; current active gameplay unaffected)", player.Name, tostring(wantAfk)))
    end
end)

GetGameState.OnServerInvoke = function(player)
    local pData = PlayerData[player.UserId]
    return {
        Round = CurrentRound,
        Phase = CurrentPhase,
        Timer = PhaseTimer,
        Rarity = CurrentRarity,
        PlayerData = pData,
        ParticipationState = pData and pData.ParticipationState or "WaitingInLobby"
    }
end

local function InitPlayer(player)
    if not PlayerData[player.UserId] then
        local isAfk = (player:GetAttribute("IsAFK") == true)
        PlayerData[player.UserId] = {
            UserId = player.UserId,
            Name = player.DisplayName,
            Money = CashAndWalletManager.STARTING_GAME_WALLET or 20,
            Wallet = CashAndWalletManager.STARTING_GAME_WALLET or 20,
            Health = GameConfig.MaxHealth,
            IsAlive = true,
            IsAFK = isAfk,
            ParticipationState = isAfk and "AFK" or "WaitingInLobby",
            CurrentBid = 0,
            Votes = 0,
            IsBot = false,
            Character = player.Character
        }
        player:SetAttribute("IsInGame", false)
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        local data = PlayerData[player.UserId]
        if not data or data.ParticipationState ~= "Active" then
            TeleportToLobby(player)
        else
            -- Active player respawned after death
            data.Health = 0
            data.IsAlive = false
            data.ParticipationState = "Eliminated"
            player:SetAttribute("IsInGame", false)
            CashAndWalletManager.SettlePlayerGameCash(player, "Eliminated")
            SyncStats(player)
            TeleportToLobby(player)
        end
    end)
    if player.Character then
        task.spawn(function()
            task.wait(0.5)
            local data = PlayerData[player.UserId]
            if not data or data.ParticipationState ~= "Active" then
                TeleportToLobby(player)
            end
        end)
    end
    SyncStats(player)
end

for _, p in ipairs(Players:GetPlayers()) do
    InitPlayer(p)
end
Players.PlayerAdded:Connect(InitPlayer)

Players.PlayerRemoving:Connect(function(player)
    PlayerData[player.UserId] = nil
end)

-- Main Server Lifecycle Loop
task.spawn(function()
    while true do
        local readyPlayers = GetReadyEligiblePlayers()
        if #readyPlayers < GameConfig.MinPlayersToStart then
            BroadcastState("WaitingForPlayers", 0, { Needed = GameConfig.MinPlayersToStart, Reason = "Waiting for R6 avatar, animations and map to load" })
            task.wait(0.5)
        else
            print("[BOOT HIERARCHY] ✅ Step 1 (R6 Rig) -> Step 2 (Walk/Run/Dive Anims) -> Step 3 (Ruins Door Ready) complete! Starting LobbyCountdown.")
            CurrentRoundSession = CurrentRoundSession + 1
            local session = CurrentRoundSession
            
            local duration = GameConfig.IntermissionTime or 5
            print(string.format("[ROUND] LobbyCountdown START duration=%d", duration))
            local countdownStart = os.clock()
            
            local cancelled = false
            for sec = duration, 1, -1 do
                local curReady = GetReadyEligiblePlayers()
                if #curReady < GameConfig.MinPlayersToStart or session ~= CurrentRoundSession then
                    print("[ROUND] LobbyCountdown CANCELLED (players left or unready)")
                    cancelled = true
                    break
                end
                BroadcastState("Intermission", sec)
                task.wait(1)
            end
            
            if not cancelled and session == CurrentRoundSession and #GetReadyEligiblePlayers() >= GameConfig.MinPlayersToStart then
                print(string.format("[ROUND] LobbyCountdown END elapsed=%.2f", os.clock() - countdownStart))
                RunMatch(session)
            end
        end
    end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">RuinsDoorHandManager</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/RuinsDoorHandManager.luau
-- Authoritative server hazard manager for Workspace["Ruins door"]
-- Features 80% Red Danger Circle telegraph, greedy loser targeting,
-- razor-thin bottleneck timing, dynamic slam trajectory, and edge-grazing dive tumble.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local RuinsDoorHandManager = {}

-- Ensure RemoteEvents exist in ReplicatedStorage & Network
local Network = ReplicatedStorage:FindFirstChild("Network")

local ImpactRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsHandImpactEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsHandImpactEvent") :: any
if not ImpactRemote then
	ImpactRemote = Instance.new("RemoteEvent")
	ImpactRemote.Name = "RuinsHandImpactEvent"
	ImpactRemote.Parent = Network or ReplicatedStorage
end

local PortalRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsPortalEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsPortalEvent") :: any
if not PortalRemote then
	PortalRemote = Instance.new("RemoteEvent")
	PortalRemote.Name = "RuinsPortalEvent"
	PortalRemote.Parent = Network or ReplicatedStorage
end

local TelegraphRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsTelegraphEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsTelegraphEvent") :: any
if not TelegraphRemote then
	TelegraphRemote = Instance.new("RemoteEvent")
	TelegraphRemote.Name = "RuinsTelegraphEvent"
	TelegraphRemote.Parent = Network or ReplicatedStorage
end

local ResetHUDRemote: RemoteEvent = (Network and Network:FindFirstChild("ResetHUDStateEvent"))
	or ReplicatedStorage:FindFirstChild("ResetHUDStateEvent") :: any
if not ResetHUDRemote then
	ResetHUDRemote = Instance.new("RemoteEvent")
	ResetHUDRemote.Name = "ResetHUDStateEvent"
	ResetHUDRemote.Parent = Network or ReplicatedStorage
end

local EmergeRemote: RemoteEvent = (Network and Network:FindFirstChild("RuinsHandEmergeEvent"))
	or ReplicatedStorage:FindFirstChild("RuinsHandEmergeEvent") :: any
if not EmergeRemote then
	EmergeRemote = Instance.new("RemoteEvent")
	EmergeRemote.Name = "RuinsHandEmergeEvent"
	EmergeRemote.Parent = Network or ReplicatedStorage
end

-- Helper: Converts Studio Position + Studio Orientation (YXZ degrees) to exact CFrame
local function toStudioCFrame(pos: Vector3, rotDeg: Vector3): CFrame
	return CFrame.new(pos) * CFrame.fromOrientation(
		math.rad(rotDeg.X),
		math.rad(rotDeg.Y),
		math.rad(rotDeg.Z)
	)
end

-- ============================================================================
-- EXACT STUDIO COORDINATES & ANATOMICAL WRIST JOINTS
-- ============================================================================
-- Visual anatomical wrist joint locations:
-- LowerArm: size (17.52, 91.09, 24.47), shoulder at +Y, wrist socket at -Y
-- SubHand:  size (25.07, 55.82, 32.11), wrist socket at +Y, palm/fingers at -Y
local ARM_SHOULDER_LOCAL = Vector3.new(2.36035, 44.54465, 0)
local ARM_WRIST_LOCAL    = Vector3.new(-2.36035, -44.54465, 0)
local HAND_WRIST_LOCAL   = Vector3.new(-7.92460, 27.82055, 1.308)

local BASE_HIT_ARM = toStudioCFrame(Vector3.new(-220.23, 86.704, -23.81), Vector3.new(18.125, -166.564, -62.174))
local BASE_HIT_HAND = toStudioCFrame(Vector3.new(-151.714, 61.17, -30.17), Vector3.new(18.125, -166.564, -88.626))

local BASE_RAISE_ARM = toStudioCFrame(Vector3.new(-229.323, 133.593, -37.418), Vector3.new(18.125, -166.564, -139.682))
local BASE_RAISE_REL_ROT = BASE_RAISE_ARM.Rotation:Inverse() * toStudioCFrame(Vector3.new(-193.164, 191.594, -64.161), Vector3.new(18.125, -166.564, -166.133)).Rotation
local BASE_RAISE_WRIST = BASE_RAISE_ARM:PointToWorldSpace(ARM_WRIST_LOCAL)
local BASE_RAISE_HAND = CFrame.new(BASE_RAISE_WRIST) * (BASE_RAISE_ARM.Rotation * BASE_RAISE_REL_ROT) * CFrame.new(-HAND_WRIST_LOCAL)

local BASE_EMERGE_ARM = toStudioCFrame(Vector3.new(-229.323, 133.593, -37.418), Vector3.new(18.125, -166.564, -139.682))
local BASE_EMERGE_REL_ROT = CFrame.Angles(0, 0, math.rad(63.549))
local BASE_EMERGE_WRIST = BASE_EMERGE_ARM:PointToWorldSpace(ARM_WRIST_LOCAL)
local BASE_EMERGE_HAND = CFrame.new(BASE_EMERGE_WRIST) * (BASE_EMERGE_ARM.Rotation * BASE_EMERGE_REL_ROT) * CFrame.new(-HAND_WRIST_LOCAL)

local POSES = {
	DoorOrigin = toStudioCFrame(Vector3.new(-258.076, 112.776, -30.455), Vector3.new(-90, -90, 0)),
	DoorOpen   = toStudioCFrame(Vector3.new(-258.076, 112.776, -77.145), Vector3.new(-90, -90, 0)),

	BlackHoleTargetScale = 5.0,
	PortalShoulderPivot  = Vector3.new(-258.0, 104.0, -25.0),

	-- 1) Emerge Out of Portal
	Emerge = {
		SubHand  = BASE_EMERGE_HAND,
		LowerArm = BASE_EMERGE_ARM,
	},

	-- 2) Raise of Hand (Apex Wind-up - Towers high with 0.00 wrist gap)
	Raise = {
		SubHand  = BASE_RAISE_HAND,
		LowerArm = BASE_RAISE_ARM,
	},

	-- 3) Hitting Ground (Base Violent Slam Pose)
	HitGround = {
		SubHand  = BASE_HIT_HAND,
		LowerArm = BASE_HIT_ARM,
	}
}

-- Direction, length and baseline parameters of LowerArm
local BASE_ARM_ROT = BASE_HIT_ARM.Rotation
local BASE_HAND_ROT = BASE_HIT_HAND.Rotation
local BASE_ARM_VEC = BASE_HIT_ARM:PointToWorldSpace(ARM_WRIST_LOCAL) - BASE_HIT_ARM:PointToWorldSpace(ARM_SHOULDER_LOCAL)
local BASE_ARM_DIR = BASE_ARM_VEC.Unit
local ARM_LENGTH = BASE_ARM_VEC.Magnitude -- 89.214 studs

local PORTAL_ORIGIN = POSES.PortalShoulderPivot
local PALM_TO_WRIST_OFFSET = BASE_HIT_HAND:VectorToWorldSpace(HAND_WRIST_LOCAL)
local AUTHORED_DIR_XZ = Vector3.new(BASE_HIT_HAND.Position.X - PORTAL_ORIGIN.X, 0, BASE_HIT_HAND.Position.Z - PORTAL_ORIGIN.Z)
local AUTHORED_YAW = math.atan2(-AUTHORED_DIR_XZ.X, -AUTHORED_DIR_XZ.Z)

-- Calculates the exact, mathematically rigid Raise and HitGround poses for ANY target point
-- (Middle, Long Range, or Very Short Range) with GUARANTEED 0.000 studs wrist joint gap!
local function computeArticulatedPosesForTarget(circleCenter: Vector3): ({ LowerArm: CFrame, SubHand: CFrame }, { LowerArm: CFrame, SubHand: CFrame })
	-- 1. Slam HitGround Pose:
	-- The palm lands squarely on circleCenter at ground contact level (Y = 61.17)
	local wristTarget = Vector3.new(circleCenter.X, 61.17, circleCenter.Z) + PALM_TO_WRIST_OFFSET
	local aimDir = (wristTarget - PORTAL_ORIGIN).Unit
	local shoulderPos = wristTarget - (aimDir * ARM_LENGTH)

	local rotDiff: CFrame
	if BASE_ARM_DIR:Cross(aimDir).Magnitude < 0.0001 then
		rotDiff = CFrame.identity
	else
		rotDiff = CFrame.fromAxisAngle(
			BASE_ARM_DIR:Cross(aimDir).Unit,
			math.acos(math.clamp(BASE_ARM_DIR:Dot(aimDir), -1, 1))
		)
	end

	local newArmRot = rotDiff * BASE_ARM_ROT
	local armPos = shoulderPos - (newArmRot * ARM_SHOULDER_LOCAL)
	local armCF = CFrame.new(armPos) * newArmRot

	local armWristWorld = armCF:PointToWorldSpace(ARM_WRIST_LOCAL)
	local newHandRot = rotDiff * BASE_HAND_ROT
	local handPos = armWristWorld - (newHandRot * HAND_WRIST_LOCAL)
	local handCF = CFrame.new(handPos) * newHandRot

	local dynamicHitPose = {
		LowerArm = armCF,
		SubHand  = handCF,
	}

	-- 2. Apex Wind-Up Raise Pose:
	-- Smoothly rotates the arm toward the target yaw from portal shoulder hinge
	local targetDirXZ = Vector3.new(circleCenter.X - PORTAL_ORIGIN.X, 0, circleCenter.Z - PORTAL_ORIGIN.Z)
	local targetYaw = math.atan2(-targetDirXZ.X, -targetDirXZ.Z)
	local deltaYaw = math.atan2(math.sin(targetYaw - AUTHORED_YAW), math.cos(targetYaw - AUTHORED_YAW))
	deltaYaw = math.clamp(deltaYaw, math.rad(-25), math.rad(25))

	local raisePivotCF = CFrame.new(PORTAL_ORIGIN) * CFrame.Angles(0, deltaYaw, 0) * CFrame.new(-PORTAL_ORIGIN)
	local solvedRaiseArm = raisePivotCF * BASE_RAISE_ARM
	local raiseWristWorld = solvedRaiseArm:PointToWorldSpace(ARM_WRIST_LOCAL)
	local solvedRaiseHand = CFrame.new(raiseWristWorld) * (solvedRaiseArm.Rotation * BASE_RAISE_REL_ROT) * CFrame.new(-HAND_WRIST_LOCAL)

	local dynamicRaisePose = {
		LowerArm = solvedRaiseArm,
		SubHand  = solvedRaiseHand,
	}

	return dynamicRaisePose, dynamicHitPose
end

-- ============================================================================
-- CALL THIS AT THE START OF EVERY NEW GAME TO FIX HP STUCK AT 0!
-- ============================================================================
function RuinsDoorHandManager.ResetAllPlayersForNewGame()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		-- If player died in Game 1, respawn them cleanly for Game 2
		if not char or not hum or hum.Health <= 0 then
			player:LoadCharacter()
			char = player.Character or player.CharacterAdded:Wait()
			hum = char:WaitForChild("Humanoid", 5)
		end

		if hum then
			hum.MaxHealth = 100
			hum.Health = hum.MaxHealth
		end

		-- Reset any custom HP/round attributes used by Bid-to-survive
		player:SetAttribute("HP", 100)
		player:SetAttribute("Health", 100)
		player:SetAttribute("LostBet", nil)
	end

	-- Force all Client HUDs to re-bind and fill HP + Energy to 100%
	ResetHUDRemote:FireAllClients()
end

local DANGER_CIRCLE_RATIO = 0.80

-- ============================================================================
-- DYNAMIC WORKSPACE RESOLUTION
-- ============================================================================
local function resolveHazardInstances()
	local map = Workspace:FindFirstChild("BidToSurviveMap")
	local ruinsDoor = (map and (map:FindFirstChild("Ruins door") or map:FindFirstChild("RuinsDoor")))
		or Workspace:FindFirstChild("Ruins door")
		or Workspace:FindFirstChild("RuinsDoor")
		or Workspace:FindFirstChild("Ruins door", true)

	local doorSlide: BasePart? = nil
	local blackHole: Instance? = nil

	if ruinsDoor then
		doorSlide = (ruinsDoor:FindFirstChild("doorSlide", true) or ruinsDoor:FindFirstChild("DoorSlide", true)) :: BasePart?
		blackHole = ruinsDoor:FindFirstChild("Blackhole", true)
			or ruinsDoor:FindFirstChild("BlackHole", true)
			or ruinsDoor:FindFirstChild("black hole", true)
	end

	-- Resolve Hand model and its articulated parts
	local handModel = (ruinsDoor and (ruinsDoor:FindFirstChild("hand", true) or ruinsDoor:FindFirstChild("Hand", true)))
		or (map and (map:FindFirstChild("hand", true) or map:FindFirstChild("Hand", true)))
		or Workspace:FindFirstChild("hand")
		or Workspace:FindFirstChild("Hand")

	local subHand: BasePart? = nil
	local lowerArm: BasePart? = nil

	if handModel then
		subHand = (handModel:FindFirstChild("LeftHand") or handModel:FindFirstChild("Hand") or handModel:FindFirstChild("hand")) :: BasePart?
		lowerArm = (handModel:FindFirstChild("LeftLowerArm") or handModel:FindFirstChild("LowerArm") or handModel:FindFirstChild("lowerarm") or handModel:FindFirstChild("lower arm")) :: BasePart?
	end

	if not subHand and ruinsDoor then
		subHand = ruinsDoor:FindFirstChild("LeftHand", true) :: BasePart?
	end
	if not lowerArm and ruinsDoor then
		lowerArm = (ruinsDoor:FindFirstChild("LeftLowerArm", true) or ruinsDoor:FindFirstChild("LowerArm", true)) :: BasePart?
	end

	-- Strip any rigid welding locks or joints that prevent CFrame tweens from animating freely
	local animatedParts = { doorSlide, subHand, lowerArm }
	for _, part in ipairs(animatedParts) do
		if part and part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("JointInstance") or child:IsA("Constraint") then
					child:Destroy()
				end
			end
		end
	end

	if blackHole then
		for _, d in ipairs(blackHole:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
	end

	return ruinsDoor, doorSlide, blackHole, handModel, subHand, lowerArm
end

-- Helper: Computes GameplayArea Walkway Bounds, Top Surface Y, Size, Color, and Material
local function getGameplayAreaBounds(): (Vector3, Vector3, Color3, Enum.Material)
	local map = Workspace:FindFirstChild("BidToSurviveMap")
	local gameplayArea = (map and map:FindFirstChild("GameplayArea"))
		or Workspace:FindFirstChild("GameplayArea")
		or Workspace:FindFirstChild("Arena")

	local walkway = (gameplayArea and gameplayArea:FindFirstChild("Walkway", true))
		or Workspace:FindFirstChild("Walkway", true)

	if walkway and walkway:IsA("BasePart") then
		local topY = walkway.Position.Y + (walkway.Size.Y * 0.5)
		return Vector3.new(walkway.Position.X, topY, walkway.Position.Z), walkway.Size, walkway.Color, walkway.Material
	elseif gameplayArea and gameplayArea:IsA("BasePart") then
		local topY = gameplayArea.Position.Y + (gameplayArea.Size.Y * 0.5)
		return Vector3.new(gameplayArea.Position.X, topY, gameplayArea.Position.Z), gameplayArea.Size, gameplayArea.Color, gameplayArea.Material
	elseif gameplayArea and gameplayArea:IsA("Model") then
		local cf, size = gameplayArea:GetBoundingBox()
		local basePart = gameplayArea.PrimaryPart or gameplayArea:FindFirstChildWhichIsA("BasePart", true)
		local topY = cf.Position.Y + (size.Y * 0.5)
		local color = basePart and basePart.Color or Color3.fromRGB(58, 125, 21)
		local mat = basePart and basePart.Material or Enum.Material.Plastic
		return Vector3.new(cf.Position.X, topY, cf.Position.Z), size, color, mat
	end

	-- Absolute studio fallback coordinates
	return Vector3.new(-161.53, 58.65, -24.93), Vector3.new(140, 1, 140), Color3.fromRGB(58, 125, 21), Enum.Material.Plastic
end

-- Helper: Reads a player's betting metrics from custom data table, attributes, or leaderstats
local function getPlayerBettingData(player: Player, customDataMap: any?)
	if customDataMap then
		local uid = player.UserId
		local d = customDataMap[uid] or customDataMap[player]
		if d then
			return d.Wallet or d.Money or 0, d.CurrentBid or d.Bid or 0, d.SubmitTime or d.BetTime or 10.0, d.LostBet
		end
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local walletObj = leaderstats and (leaderstats:FindFirstChild("Wallet") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash"))
	local bidObj = leaderstats and (leaderstats:FindFirstChild("Bid") or leaderstats:FindFirstChild("CurrentBid"))

	local wallet = player:GetAttribute("Wallet") or player:GetAttribute("Money") or (walletObj and walletObj.Value) or 0
	local bid = player:GetAttribute("CurrentBid") or player:GetAttribute("Bid") or (bidObj and bidObj.Value) or 0
	local betTime = player:GetAttribute("SubmitTime") or player:GetAttribute("BetTime") or 10.0
	local explicitLostBet = player:GetAttribute("LostBet")

	return wallet, bid, betTime, explicitLostBet
end

-- ============================================================================
-- LEADERBOARD-MATCHED TARGETING:
-- 1. Bottom 50% Bet Losers
-- 2. Primary: Highest Wallet Money
-- 3. Tie-breaker: Fastest Bet Timestamp (lowest SubmitTime)
-- ============================================================================
function RuinsDoorHandManager.CalculateTargetDangerCircle(customPlayerData: any?): (Vector3, number, Color3, Enum.Material, any?)
	local arenaCenter, arenaSize, floorColor, floorMat = getGameplayAreaBounds()
	local arenaSpan = math.min(arenaSize.X, arenaSize.Z)

	-- 80% Danger Circle Radius
	local circleRadius = (arenaSpan * DANGER_CIRCLE_RATIO) * 0.5

	local activeEntries = {}

	if customPlayerData and typeof(customPlayerData) == "table" then
		for id, data in pairs(customPlayerData) do
			if typeof(data) == "table" and data.IsAlive and (data.ParticipationState == nil or data.ParticipationState == "Active") then
				local char = data.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local wallet = data.Money or data.Wallet or 0
					local bid = data.CurrentBid or data.Bid or 0
					local betTime = data.SubmitTime or data.BetTime or 10.0
					local explicitLostBet = data.LostBet
					table.insert(activeEntries, {
						Player = (typeof(id) == "number" and id > 0) and Players:GetPlayerByUserId(id) or char,
						UserId = id,
						Character = char,
						Root = root,
						Wallet = wallet,
						Bid = bid,
						BetTime = betTime,
						LostBet = explicitLostBet,
					})
				end
			end
		end
	end

	if #activeEntries == 0 then
		for _, player in ipairs(Players:GetPlayers()) do
			if player:GetAttribute("IsInGame") == true then
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local wallet, bid, betTime, explicitLostBet = getPlayerBettingData(player, customPlayerData)
					table.insert(activeEntries, {
						Player = player,
						UserId = player.UserId,
						Character = char,
						Root = root,
						Wallet = wallet,
						Bid = bid,
						BetTime = betTime,
						LostBet = explicitLostBet,
					})
				end
			end
		end
	end

	if #activeEntries == 0 then
		return arenaCenter, circleRadius, floorColor, floorMat, nil
	end

	-- 1. Isolate the 50% who lost the bet
	local betLosers = {}
	for _, entry in ipairs(activeEntries) do
		if entry.LostBet == true then
			table.insert(betLosers, entry)
		end
	end

	if #betLosers == 0 then
		-- Sort by Bid ascending (lowest bid loses; later bet loses tie)
		table.sort(activeEntries, function(a, b)
			if math.abs(a.Bid - b.Bid) > 0.001 then
				return a.Bid < b.Bid
			end
			return a.BetTime > b.BetTime
		end)

		local loserCount = math.max(1, math.ceil(#activeEntries * 0.5))
		for i = 1, loserCount do
			table.insert(betLosers, activeEntries[i])
		end
	end

	-- 2. Among Bet Losers: Rank by HIGHEST WALLET MONEY
	-- Tie-breaker: FASTEST BET TIMESTAMP (lowest BetTime wins tie)
	table.sort(betLosers, function(a, b)
		if math.abs(a.Wallet - b.Wallet) > 0.001 then
			return a.Wallet > b.Wallet
		end
		return a.BetTime < b.BetTime
	end)

	local primaryTarget = betLosers[1]
	local targetPos = primaryTarget.Root.Position

	-- Clamp circle so at least ~20% of the arena floor remains safe on the opposite side
	local maxOffsetX = (arenaSize.X * 0.5) - (circleRadius * 0.45)
	local maxOffsetZ = (arenaSize.Z * 0.5) - (circleRadius * 0.45)

	local clampedX = math.clamp(targetPos.X, arenaCenter.X - maxOffsetX, arenaCenter.X + maxOffsetX)
	local clampedZ = math.clamp(targetPos.Z, arenaCenter.Z - maxOffsetZ, arenaCenter.Z + maxOffsetZ)

	local finalCircleCenter = Vector3.new(clampedX, arenaCenter.Y, clampedZ)
	return finalCircleCenter, circleRadius, floorColor, floorMat, primaryTarget.Player or primaryTarget.Character
end

-- Attaches pulsing overhead "GREEDY TARGET" marker during the 2.20s Stalking Phase
local function markGreedyTargetPlayer(targetPlayer: any?, stalkDuration: number)
	if not targetPlayer then return end
	local character = (typeof(targetPlayer) == "Instance" and targetPlayer:IsA("Player")) and targetPlayer.Character or targetPlayer
	local head = character and character:FindFirstChild("Head")
	if not head then return end

	local existing = head:FindFirstChild("GreedyTargetMarker")
	if existing then existing:Destroy() end

	local bb = Instance.new("BillboardGui")
	bb.Name = "GreedyTargetMarker"
	bb.Size = UDim2.new(0, 190, 0, 52)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.AlwaysOnTop = true
	bb.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "⚠ TARGET LOCKED ⚠\n[RUN AWAY FROM THEM!]"
	label.TextColor3 = Color3.fromRGB(255, 45, 55)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Parent = bb

	task.delay(stalkDuration, function()
		if bb.Parent then bb:Destroy() end
	end)
end

-- ============================================================================
-- TWEEN & SCALE HELPERS
-- ============================================================================
local function tweenObjectCFrame(instance: Instance?, targetCFrame: CFrame, tweenInfo: TweenInfo): Tween?
	if not instance then return nil end

	if instance:IsA("BasePart") then
		instance.Anchored = true
		local tween = TweenService:Create(instance, tweenInfo, { CFrame = targetCFrame })
		tween:Play()
		return tween
	elseif instance:IsA("Model") then
		local cfValue = Instance.new("CFrameValue")
		cfValue.Value = instance:GetPivot()
		local conn = cfValue.Changed:Connect(function(newCF)
			instance:PivotTo(newCF)
		end)
		local tween = TweenService:Create(cfValue, tweenInfo, { Value = targetCFrame })
		tween.Completed:Once(function()
			conn:Disconnect()
			cfValue:Destroy()
		end)
		tween:Play()
		return tween
	end
	return nil
end

local function setBlackholeParticlesEnabled(bhInstance: Instance?, enabled: boolean)
	if not bhInstance then return end
	for _, desc in ipairs(bhInstance:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = enabled
		end
	end
end

local function tweenBlackHoleScale(bhInstance: Instance?, startScale: number, endScale: number, duration: number, easingStyle: Enum.EasingStyle, easingDir: Enum.EasingDirection?)
	if not bhInstance then return end
	local safeStart = math.max(startScale, 0.001)
	local safeEnd = math.max(endScale, 0.001)
	local direction = easingDir or Enum.EasingDirection.Out
	local startTime = os.clock()
	local isExpanding = (safeEnd > safeStart)
	local lastEmit = 0

	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startTime
		local progress = math.clamp(elapsed / duration, 0, 1)
		local alpha = TweenService:GetValue(progress, easingStyle, direction)
		local currentScale = safeStart + (safeEnd - safeStart) * alpha
		local safeScale = math.max(currentScale, 0.001)

		if bhInstance:IsA("Model") then
			bhInstance:ScaleTo(safeScale)
		elseif bhInstance:IsA("BasePart") then
			local mesh = bhInstance:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				mesh.Scale = Vector3.new(safeScale, safeScale, safeScale)
			end
		end

		if isExpanding and (elapsed - lastEmit >= 0.18) then
			lastEmit = elapsed
			for _, desc in ipairs(bhInstance:GetDescendants()) do
				if desc:IsA("ParticleEmitter") then
					desc:Emit(1)
				end
			end
		end

		if progress >= 1 then
			if conn then
				conn:Disconnect()
				conn = nil
			end
			if isExpanding then
				for _, desc in ipairs(bhInstance:GetDescendants()) do
					if desc:IsA("ParticleEmitter") then
						desc:Emit(3)
					end
				end
			else
				for _, desc in ipairs(bhInstance:GetDescendants()) do
					if desc:IsA("ParticleEmitter") then
						desc:Clear()
					end
				end
			end
		end
	end)
end

local function setBlackHoleVisibility(bhInstance: Instance?, isVisible: boolean)
	if not bhInstance then return end
	for _, desc in ipairs(bhInstance:GetDescendants()) do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = isVisible
		elseif desc:IsA("Light") then
			desc.Enabled = isVisible
		elseif desc:IsA("BasePart") and desc.Name == "Main" then
			desc.Transparency = isVisible and 0 or 1
		end
	end
end

local function setHandPartsState(subHand: BasePart?, lowerArm: BasePart?, isVisible: boolean)
	local parts = { subHand, lowerArm }
	for _, part in ipairs(parts) do
		if part and part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.Transparency = isVisible and 0 or 1
		end
	end
end

local function setDoorBlockerVisibility(ruinsDoor: Instance?, isOpen: boolean)
	if not ruinsDoor then return end
	for _, desc in ipairs(ruinsDoor:GetDescendants()) do
		local nameLower = desc.Name:lower()
		if nameLower:find("partinvinciblewhenopening") or nameLower:find("partinvisiblewhenopening") then
			if desc:IsA("BasePart") then
				desc.Transparency = isOpen and 1 or 0
				desc.CanCollide = not isOpen
			end
		end
	end
end

-- Kinematic Arm & Hand Driver: Pins the wrist attachment point of SubHand to LowerArm
-- on every single Heartbeat frame, eliminating linear tween chord separation mid-swing!
local function tweenArticulatedArm(
	subHand: BasePart?,
	lowerArm: BasePart?,
	targetPose: { LowerArm: CFrame, SubHand: CFrame },
	tweenInfo: TweenInfo
): Tween?
	if not lowerArm or not subHand then
		return nil
	end

	local startArmCF = lowerArm.CFrame
	local targetArmCF = targetPose.LowerArm
	local startSubCF = subHand.CFrame
	local targetSubCF = targetPose.SubHand

	local startRelRot = startArmCF.Rotation:Inverse() * startSubCF.Rotation
	local targetRelRot = targetArmCF.Rotation:Inverse() * targetSubCF.Rotation

	local armTween = tweenObjectCFrame(lowerArm, targetArmCF, tweenInfo)
	if not armTween then return nil end

	local startTime = os.clock()
	local duration = math.max(tweenInfo.Time, 0.001)
	local style = tweenInfo.EasingStyle
	local dir = tweenInfo.EasingDirection

	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		if not lowerArm or not lowerArm.Parent or not subHand or not subHand.Parent then
			if conn then conn:Disconnect() conn = nil end
			return
		end

		local elapsed = os.clock() - startTime
		local progress = math.clamp(elapsed / duration, 0, 1)
		local alpha = TweenService:GetValue(progress, style, dir)

		local curArmCF = lowerArm.CFrame
		local curRelRot = startRelRot:Lerp(targetRelRot, alpha)
		local armWristWorld = curArmCF:PointToWorldSpace(ARM_WRIST_LOCAL)
		local curSubCF = CFrame.new(armWristWorld) * (curArmCF.Rotation * curRelRot) * CFrame.new(-HAND_WRIST_LOCAL)

		subHand.CFrame = curSubCF
	end)

	armTween.Completed:Once(function()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if lowerArm then lowerArm.CFrame = targetPose.LowerArm end
		if subHand then subHand.CFrame = targetPose.SubHand end
	end)

	return armTween
end

-- ============================================================================
-- AUTHORITATIVE SEQUENCE EXECUTION
-- ============================================================================
local isSequenceActive = false

function RuinsDoorHandManager.ExecuteSequenceAndDamage(
	damageAmountOrCallback: any?,
	customPlayerData: any?,
	setDoorPartsVisibilityCallback: ((isOpen: boolean) -> ())?
)
	if isSequenceActive then
		warn("[RuinsDoorHandManager] Sequence already active! Bypassing duplicate call.")
		return
	end
	isSequenceActive = true

	local success, err = pcall(function()
		local ruinsDoor, doorSlide, blackHole, handModel, subHand, lowerArm = resolveHazardInstances()

		print("[RuinsDoorHandManager] Starting 5-Stage Cinematic Sequence...")

		if setDoorPartsVisibilityCallback then
			setDoorPartsVisibilityCallback(true)
		else
			setDoorBlockerVisibility(ruinsDoor, true)
		end

		setBlackholeParticlesEnabled(blackHole, false)
		if blackHole and blackHole:IsA("Model") and doorSlide then
			local doorwayCenter = Vector3.new(blackHole:GetPivot().Position.X, POSES.DoorOrigin.Position.Y, POSES.DoorOrigin.Position.Z)
			blackHole:PivotTo(CFrame.new(doorwayCenter) * blackHole:GetPivot().Rotation)
			blackHole:ScaleTo(0.001)
		end

		if doorSlide then
			doorSlide.CFrame = POSES.DoorOrigin
		end

		-- Pre-calculate initial target candidate for Stalking phase marker
		local initialCenter, initialRadius, floorColor, floorMat, stalkTarget =
			RuinsDoorHandManager.CalculateTargetDangerCircle(customPlayerData)

		-- ------------------------------------------------------------------------
		-- STAGE 1: DOOR SLIDE & BLACK HOLE EXPANSION (1.35s) - STALKING PHASE
		-- ------------------------------------------------------------------------
		local doorOpenTime = 1.35

		if RunService:IsRunning() and RunService:IsServer() then
			PortalRemote:FireAllClients(true, doorOpenTime, POSES.BlackHoleTargetScale)
		end

		-- Mark the #1 Greedy Bet Loser so everyone scatters away from them!
		markGreedyTargetPlayer(stalkTarget, 2.20)

		local doorTween = tweenObjectCFrame(
			doorSlide,
			POSES.DoorOpen,
			TweenInfo.new(doorOpenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		)

		setBlackHoleVisibility(blackHole, true)
		setBlackholeParticlesEnabled(blackHole, true)

		if doorTween then doorTween.Completed:Wait() else task.wait(doorOpenTime) end
		if blackHole and blackHole:IsA("Model") then
			blackHole:ScaleTo(POSES.BlackHoleTargetScale)
		end

		-- ------------------------------------------------------------------------
		-- STAGE 2: HAND EMERGES OUT OF PORTAL (0.85s)
		-- ------------------------------------------------------------------------
		setHandPartsState(subHand, lowerArm, true)

		if lowerArm then lowerArm.CFrame = POSES.Emerge.LowerArm * CFrame.new(0, 0, 30) end
		if subHand and lowerArm then
			local w = lowerArm.CFrame:PointToWorldSpace(ARM_WRIST_LOCAL)
			subHand.CFrame = CFrame.new(w) * (lowerArm.CFrame.Rotation * BASE_EMERGE_REL_ROT) * CFrame.new(-HAND_WRIST_LOCAL)
		end

		local emergencePos = lowerArm and lowerArm.Position or POSES.PortalShoulderPivot
		if RunService:IsRunning() and RunService:IsServer() then
			EmergeRemote:FireAllClients(emergencePos, 0.85)
		end
		print(string.format("[RuinsDoorHandManager] Stage 2: Hand emergence triggered at %s", tostring(emergencePos)))

		local emergeTween = tweenArticulatedArm(
			subHand,
			lowerArm,
			POSES.Emerge,
			TweenInfo.new(0.85, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		)
		if emergeTween then emergeTween.Completed:Wait() else task.wait(0.85) end

		-- ------------------------------------------------------------------------
		-- STAGE 3: HAND RAISE / APEX WIND-UP - HARD LOCK 80% RED CIRCLE (0.70s + 0.14s)
		-- ------------------------------------------------------------------------
		local circleCenter, circleRadius, currentFloorColor, currentFloorMat, lockedTarget =
			RuinsDoorHandManager.CalculateTargetDangerCircle(customPlayerData)

		local slamTime = 0.22
		local raiseDuration = 0.70
		local apexHold = 0.14
		local lockedWarningTime = raiseDuration + apexHold + slamTime

		-- Fire 80% Red Warning Circle to all clients NOW!
		if RunService:IsRunning() and RunService:IsServer() then
			TelegraphRemote:FireAllClients(circleCenter, circleRadius, lockedWarningTime, lockedTarget)
		end

		local dynamicRaisePose, dynamicHitPose = computeArticulatedPosesForTarget(circleCenter)

		local raiseTween = tweenArticulatedArm(
			subHand,
			lowerArm,
			dynamicRaisePose,
			TweenInfo.new(raiseDuration, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		)
		if raiseTween then raiseTween.Completed:Wait() else task.wait(raiseDuration) end

		-- Dramatic apex hang-time before plunge
		task.wait(apexHold)

		-- ------------------------------------------------------------------------
		-- STAGE 4: GROUND SLAM & SYNCHRONIZED PLAYER DAMAGE (0.22s)
		-- ------------------------------------------------------------------------
		local slamTween = tweenArticulatedArm(
			subHand,
			lowerArm,
			dynamicHitPose,
			TweenInfo.new(slamTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
		)
		if slamTween then slamTween.Completed:Wait() else task.wait(slamTime) end

		-- EXACT MILLISECOND OF IMPACT: VFX & DAMAGE CHECK
		local handFootprint = Vector3.new(circleRadius * 2, 14, circleRadius * 2)
		if RunService:IsRunning() and RunService:IsServer() then
			ImpactRemote:FireAllClients(circleCenter, handFootprint, currentFloorColor or floorColor, currentFloorMat or floorMat, circleRadius)
		else
			print(string.format("[RuinsDoorHandManager] Impact at %s (radius=%.1f)", tostring(circleCenter), circleRadius))
		end

		local hitPlayers = {}
		local escapedPlayers = {}

		-- Distance check against 80% Red Circle
		local participantsToCheck = {}
		if customPlayerData and typeof(customPlayerData) == "table" then
			for id, data in pairs(customPlayerData) do
				if typeof(data) == "table" and data.IsAlive and (data.ParticipationState == nil or data.ParticipationState == "Active") then
					local char = data.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if root and hum and hum.Health > 0 then
						local pObj = (typeof(id) == "number" and id > 0) and Players:GetPlayerByUserId(id) or char
						table.insert(participantsToCheck, { Target = pObj, Root = root, Hum = hum })
					end
				end
			end
		end

		if #participantsToCheck == 0 then
			for _, player in ipairs(Players:GetPlayers()) do
				if player:GetAttribute("IsInGame") == true then
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if root and hum and hum.Health > 0 then
						table.insert(participantsToCheck, { Target = player, Root = root, Hum = hum })
					end
				end
			end
		end

		for _, item in ipairs(participantsToCheck) do
			local target = item.Target
			local root = item.Root
			local hum = item.Hum
			local flatVector = Vector3.new(root.Position.X - circleCenter.X, 0, root.Position.Z - circleCenter.Z)
			local flatDist = flatVector.Magnitude

			if flatDist <= circleRadius then
				-- Inside 80% Red Circle: Full Damage!
				table.insert(hitPlayers, target)
				if typeof(damageAmountOrCallback) == "number" then
					hum:TakeDamage(damageAmountOrCallback)
				end
			elseif flatDist <= (circleRadius * 1.15) then
				-- Edge-Grazing Shockwave Wave (escaped by < 15% margin): 0 damage + dive tumble!
				table.insert(escapedPlayers, target)
				local blastDir = (flatDist > 0.1) and flatVector.Unit or Vector3.new(0, 0, 1)
				root.AssemblyLinearVelocity = (blastDir * 58) + Vector3.new(0, 32, 0)
				hum.PlatformStand = true
				task.delay(0.45, function()
					if hum and hum.Health > 0 then
						hum.PlatformStand = false
					end
				end)
			else
				-- Cleanly escaped
				table.insert(escapedPlayers, target)
			end
		end

		if typeof(damageAmountOrCallback) == "function" then
			task.spawn(damageAmountOrCallback, escapedPlayers, hitPlayers)
		end

		print(string.format("[RuinsDoorHandManager] Impact registered! Hit=%d, Escaped=%d (circleRadius=%.1f)", #hitPlayers, #escapedPlayers, circleRadius))

		-- ------------------------------------------------------------------------
		-- STAGE 5: IMPACT HOLD, RETRACT & SEAL (0.75s + 0.65s + 1.0s)
		-- ------------------------------------------------------------------------
		task.wait(0.75)

		local retractTween = tweenArticulatedArm(
			subHand,
			lowerArm,
			POSES.Emerge,
			TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		)
		if retractTween then retractTween.Completed:Wait() else task.wait(0.65) end

		setHandPartsState(subHand, lowerArm, false)

		if RunService:IsRunning() and RunService:IsServer() then
			PortalRemote:FireAllClients(false, 1.0, 0.001)
		end

		local closeTween = tweenObjectCFrame(
			doorSlide,
			POSES.DoorOrigin,
			TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		)
		if closeTween then closeTween.Completed:Wait() else task.wait(1.0) end

		if blackHole and blackHole:IsA("Model") then
			blackHole:ScaleTo(0.001)
		end
		setBlackHoleVisibility(blackHole, false)
		setBlackholeParticlesEnabled(blackHole, false)

		if setDoorPartsVisibilityCallback then
			setDoorPartsVisibilityCallback(false)
		else
			setDoorBlockerVisibility(ruinsDoor, false)
		end

		print("[RuinsDoorHandManager] Sequence complete. Door sealed.")
	end)

	isSequenceActive = false
	if not success then
		warn("[RuinsDoorHandManager] Error in sequence execution: " .. tostring(err))
	end
end

RuinsDoorHandManager.POSES = POSES
RuinsDoorHandManager.ResolveInstances = resolveHazardInstances
RuinsDoorHandManager.ResetActiveState = function() isSequenceActive = false end
RuinsDoorHandManager.IsActive = function() return isSequenceActive end

return RuinsDoorHandManager
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="28">
      <Properties>
        <string name="Name">SpawnAndAFKManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/SpawnAndAFKManager.server.luau
-- Manages invisible/non-collidable spawn pads, procedural fence perimeter barrier walls,
-- and AFK teleport logic.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- 1. Ensure RemoteEvents exist in ReplicatedStorage & Network
local Network = ReplicatedStorage:FindFirstChild("Network")
local AFKRemote: RemoteEvent = (Network and Network:FindFirstChild("AFKToggleEvent"))
	or ReplicatedStorage:FindFirstChild("AFKToggleEvent") :: any

if not AFKRemote then
	AFKRemote = Instance.new("RemoteEvent")
	AFKRemote.Name = "AFKToggleEvent"
	AFKRemote.Parent = Network or ReplicatedStorage
end

local SetAFK: RemoteEvent = (Network and Network:FindFirstChild("SetAFK"))
	or ReplicatedStorage:FindFirstChild("SetAFK") :: any

-- 2. Make all SpawnLocations Invisible & Non-Collidable
local primarySpawnCFrame = CFrame.new(48.11, 85.14, 2.92)

for _, desc in ipairs(Workspace:GetDescendants()) do
	if desc:IsA("SpawnLocation") then
		desc.Transparency = 1
		desc.CanCollide = false
		desc.CanQuery = false
		desc.CanTouch = false
		primarySpawnCFrame = desc.CFrame

		-- Hide default Spawn decal if present
		for _, child in ipairs(desc:GetChildren()) do
			if child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = 1
			end
		end
	end
end

-- 3. Calculate Invisible Bounding Box around Spawn from Fences
local function buildSpawnBoxFromFences()
	local existingBox = Workspace:FindFirstChild("SpawnFenceBarrierBox")
	if existingBox then
		existingBox:Destroy()
	end

	local fenceParts = {}

	-- Searches for any model/folder/parts named "Fence" or "Fences" near Spawn
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") then
			local nameLower = string.lower(desc.Name)
			local parentNameLower = desc.Parent and string.lower(desc.Parent.Name) or ""
			if string.find(nameLower, "fence") or string.find(parentNameLower, "fence") then
				if (desc.Position - primarySpawnCFrame.Position).Magnitude < 250 then
					table.insert(fenceParts, desc)
				end
			end
		end
	end

	if #fenceParts == 0 then
		warn("[SpawnAndAFKManager] No Fence parts found near Spawn!")
		return
	end

	local minX, maxX = math.huge, -math.huge
	local minZ, maxZ = math.huge, -math.huge
	local minY, maxY = math.huge, -math.huge

	for _, part in ipairs(fenceParts) do
		local cf = part.CFrame
		local half = part.Size * 0.5
		for _, sx in ipairs({-1, 1}) do
			for _, sy in ipairs({-1, 1}) do
				for _, sz in ipairs({-1, 1}) do
					local corner = cf:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
					minX = math.min(minX, corner.X)
					maxX = math.max(maxX, corner.X)
					minY = math.min(minY, corner.Y)
					maxY = math.max(maxY, corner.Y)
					minZ = math.min(minZ, corner.Z)
					maxZ = math.max(maxZ, corner.Z)
				end
			end
		end
	end

	local boxFolder = Instance.new("Folder")
	boxFolder.Name = "SpawnFenceBarrierBox"
	boxFolder.Parent = Workspace

	local wallHeight = 45
	local wallThickness = 2
	local centerX = (minX + maxX) * 0.5
	local centerZ = (minZ + maxZ) * 0.5
	local centerY = minY + (wallHeight * 0.5)
	local widthX = (maxX - minX) + wallThickness
	local depthZ = (maxZ - minZ) + wallThickness

	local walls = {
		-- North & South Walls (along X)
		{ Name = "SpawnBarrierWall_North", Size = Vector3.new(widthX, wallHeight, wallThickness), Pos = Vector3.new(centerX, centerY, minZ) },
		{ Name = "SpawnBarrierWall_South", Size = Vector3.new(widthX, wallHeight, wallThickness), Pos = Vector3.new(centerX, centerY, maxZ) },
		-- East & West Walls (along Z)
		{ Name = "SpawnBarrierWall_West",  Size = Vector3.new(wallThickness, wallHeight, depthZ), Pos = Vector3.new(minX, centerY, centerZ) },
		{ Name = "SpawnBarrierWall_East",  Size = Vector3.new(wallThickness, wallHeight, depthZ), Pos = Vector3.new(maxX, centerY, centerZ) },
	}

	for _, w in ipairs(walls) do
		local barrier = Instance.new("Part")
		barrier.Name = w.Name
		barrier.Anchored = true
		barrier.CanCollide = true
		barrier.CanQuery = false
		barrier.Transparency = 1
		barrier.Size = w.Size
		barrier.Position = w.Pos
		barrier.Parent = boxFolder
	end

	print(string.format("[SpawnAndAFKManager] Built 4 fence safety walls around Spawn (Width=%.1f, Depth=%.1f, Height=%.1f)", widthX, depthZ, wallHeight))
end

buildSpawnBoxFromFences()

-- 3.5 Ensure Thick Mud Foundation Exists Beneath Both Grass Walkways
local function ensureMudFoundations()
	local map = Workspace:FindFirstChild("BidToSurviveMap")
	if not map then return end

	-- 1. Spawn Area Mud Foundation (20 studs thick)
	local spawnArea = map:FindFirstChild("SpawnArea")
	local spawnGround = spawnArea and spawnArea:FindFirstChild("Ground")
	local spawnWalkway = spawnGround and spawnGround:FindFirstChild("Walkway")
	if spawnWalkway and spawnGround and not spawnGround:FindFirstChild("MudFoundation") then
		local height = 20
		local topY = spawnWalkway.Position.Y - (spawnWalkway.Size.Y * 0.5)
		local centerY = topY - (height * 0.5)

		local mud = Instance.new("Part")
		mud.Name = "MudFoundation"
		mud.Size = Vector3.new(spawnWalkway.Size.X, height, spawnWalkway.Size.Z)
		mud.Position = Vector3.new(spawnWalkway.Position.X, centerY, spawnWalkway.Position.Z)
		mud.Material = Enum.Material.Mud
		mud.Color = Color3.fromRGB(86, 58, 38)
		mud.Anchored = true
		mud.CanCollide = true
		mud.CanTouch = true
		mud.CanQuery = true
		mud.TopSurface = Enum.SurfaceType.Smooth
		mud.BottomSurface = Enum.SurfaceType.Smooth
		mud.Parent = spawnGround
		print("[SpawnAndAFKManager] ✅ Created 20-stud thick Mud Foundation under Spawn Area.")
	end

	-- 2. Gameplay Area Mud Foundation (24 studs thick)
	local gameArea = map:FindFirstChild("GameplayArea")
	local gameWalkway = gameArea and gameArea:FindFirstChild("Walkway")
	if gameWalkway and gameArea and not gameArea:FindFirstChild("MudFoundation") then
		local height = 24
		local topY = gameWalkway.Position.Y - (gameWalkway.Size.Y * 0.5)
		local centerY = topY - (height * 0.5)

		local mud = Instance.new("Part")
		mud.Name = "MudFoundation"
		mud.Size = Vector3.new(gameWalkway.Size.X, height, gameWalkway.Size.Z)
		mud.Position = Vector3.new(gameWalkway.Position.X, centerY, gameWalkway.Position.Z)
		mud.Material = Enum.Material.Mud
		mud.Color = Color3.fromRGB(86, 58, 38)
		mud.Anchored = true
		mud.CanCollide = true
		mud.CanTouch = true
		mud.CanQuery = true
		mud.TopSurface = Enum.SurfaceType.Smooth
		mud.BottomSurface = Enum.SurfaceType.Smooth
		mud.Parent = gameArea
		print("[SpawnAndAFKManager] ✅ Created 24-stud thick Mud Foundation under Gameplay Area.")
	end
end

ensureMudFoundations()

-- 4. Unified AFK Attribute Handler (No immediate teleportation)
local function handleAFKToggle(player: Player, isAFK: boolean?)
	local newAFK: boolean
	if isAFK ~= nil then
		newAFK = (isAFK == true)
	else
		local currentAFK = (player:GetAttribute("IsAFK") == true)
		newAFK = not currentAFK
	end
	player:SetAttribute("IsAFK", newAFK)
	print(string.format("[SpawnAndAFKManager] %s set IsAFK = %s (no teleport)", player.Name, tostring(newAFK)))
end

AFKRemote.OnServerEvent:Connect(handleAFKToggle)

print("[SpawnAndAFKManager] Initialized successfully.")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">TestPlayerSpawner</string>
        <string name="Source"><![CDATA[--!strict
-- src/server/round/TestPlayerSpawner.luau
-- Authoritative Test Player & Bot Spawning Engine for Bid-to-survive.
-- Spawns fully-rigged R6 Humanoid characters that the game engine treats as real players.
-- Features:
-- 1. Authentic R6 Humanoid Rigs with limbs, HumanoidRootPart, and distinct avatar appearances.
-- 2. Overhead Name, HP Bar & Wallet BillboardGui for in-world live match tracking.
-- 3. Smart Proportional Bidding AI (conserves wallet so matches can run for unlimited rounds).
-- 4. Autonomous Scramble & Dodge AI (unprotected bots actively sprint out of the danger circle).
-- 5. Organic damage & elimination (only taking damage when caught inside red circle and unprotected).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local TestPlayerSpawner = {}
TestPlayerSpawner.__index = TestPlayerSpawner

export type TestPlayerData = {
	UserId: number,
	Name: string,
	DisplayName: string,
	Money: number,
	Wallet: number?,
	Health: number,
	IsAlive: boolean,
	IsAFK: boolean,
	ParticipationState: string,
	CurrentBid: number,
	SubmitTime: number?,
	Votes: number,
	IsBot: boolean,
	IsTestPlayer: boolean,
	Character: Model?,
	Billboard: BillboardGui?,
}

local activeTestPlayers: {TestPlayerData} = {}
local gameplayArea: Instance? = nil
local walkway: BasePart? = nil
local gameConfig: any = nil

local BOT_NAMES = {
	"ApeSlayer", "ShadowRunner", "LuckyBids", "AlphaTitan", "RiskHunter",
	"ViperStrike", "CyberGhost", "BlazeWarrior", "EchoPhantom", "IronClaw",
	"ThunderVolt", "FrostBite", "NeonReaper", "QuantumDash", "ApexPredator",
}

local AVATAR_PALETTES = {
	{ Torso = Color3.fromRGB(35, 115, 230), Legs = Color3.fromRGB(40, 45, 55), Skin = Color3.fromRGB(234, 184, 146) },
	{ Torso = Color3.fromRGB(220, 50, 50),   Legs = Color3.fromRGB(30, 30, 35), Skin = Color3.fromRGB(212, 161, 126) },
	{ Torso = Color3.fromRGB(45, 185, 95),  Legs = Color3.fromRGB(50, 55, 65), Skin = Color3.fromRGB(240, 200, 165) },
	{ Torso = Color3.fromRGB(245, 160, 25), Legs = Color3.fromRGB(35, 35, 40), Skin = Color3.fromRGB(195, 145, 110) },
	{ Torso = Color3.fromRGB(160, 45, 215), Legs = Color3.fromRGB(25, 25, 30), Skin = Color3.fromRGB(225, 175, 135) },
	{ Torso = Color3.fromRGB(30, 195, 205), Legs = Color3.fromRGB(45, 50, 60), Skin = Color3.fromRGB(234, 184, 146) },
	{ Torso = Color3.fromRGB(235, 70, 150), Legs = Color3.fromRGB(35, 40, 50), Skin = Color3.fromRGB(215, 165, 130) },
	{ Torso = Color3.fromRGB(220, 215, 50), Legs = Color3.fromRGB(40, 45, 55), Skin = Color3.fromRGB(240, 200, 165) },
	{ Torso = Color3.fromRGB(90, 100, 120), Legs = Color3.fromRGB(25, 30, 35), Skin = Color3.fromRGB(180, 130, 95) },
	{ Torso = Color3.fromRGB(180, 40, 40),  Legs = Color3.fromRGB(20, 20, 25), Skin = Color3.fromRGB(230, 180, 140) },
}

function TestPlayerSpawner.Init(config: any, gpArea: Instance, walkPart: BasePart)
	gameConfig = config
	gameplayArea = gpArea
	walkway = walkPart
end

function TestPlayerSpawner.CleanupTestPlayers()
	for _, data in ipairs(activeTestPlayers) do
		if data.Character and data.Character.Parent then
			data.Character:Destroy()
		end
	end
	table.clear(activeTestPlayers)
end

-- Builds a clean overhead status billboard for in-world match observation
local function attachOverheadHUD(character: Model, name: string, startHealth: number, startWallet: number): BillboardGui?
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then return nil end

	local bbg = Instance.new("BillboardGui")
	bbg.Name = "TestPlayerOverhead"
	bbg.Adornee = head
	bbg.Size = UDim2.new(0, 130, 0, 46)
	bbg.StudsOffset = Vector3.new(0, 2.8, 0)
	bbg.AlwaysOnTop = true
	bbg.MaxDistance = 140
	bbg.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0, 18)
	nameLabel.Position = UDim2.new(0, 0, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextSize = 13
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.Text = name
	nameLabel.Parent = bbg

	local barBg = Instance.new("Frame")
	barBg.Name = "HPBarBg"
	barBg.Size = UDim2.new(1, -12, 0, 8)
	barBg.Position = UDim2.new(0, 6, 0, 20)
	barBg.BackgroundColor3 = Color3.fromRGB(40, 10, 15)
	barBg.BorderSizePixel = 0
	barBg.Parent = bbg

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 3)
	barCorner.Parent = barBg

	local barFill = Instance.new("Frame")
	barFill.Name = "Fill"
	barFill.Size = UDim2.new(math.clamp(startHealth / 100, 0, 1), 0, 1, 0)
	barFill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 3)
	fillCorner.Parent = barFill

	local walletLabel = Instance.new("TextLabel")
	walletLabel.Name = "WalletLabel"
	walletLabel.Size = UDim2.new(1, 0, 0, 14)
	walletLabel.Position = UDim2.new(0, 0, 0, 30)
	walletLabel.BackgroundTransparency = 1
	walletLabel.Font = Enum.Font.GothamBold
	walletLabel.TextSize = 11
	walletLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	walletLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	walletLabel.TextStrokeTransparency = 0.4
	walletLabel.Text = string.format("$%.2f", startWallet)
	walletLabel.Parent = bbg

	return bbg
end

local function updateOverheadHUD(data: TestPlayerData)
	if not data.Billboard or not data.Billboard.Parent then return end
	local barBg = data.Billboard:FindFirstChild("HPBarBg") :: Frame?
	local fill = barBg and barBg:FindFirstChild("Fill") :: Frame?
	local walletLabel = data.Billboard:FindFirstChild("WalletLabel") :: TextLabel?

	if fill then
		local hpRatio = math.clamp(data.Health / 100, 0, 1)
		fill.Size = UDim2.new(hpRatio, 0, 1, 0)
		if hpRatio > 0.5 then
			fill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
		elseif hpRatio > 0.25 then
			fill.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
		else
			fill.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
		end
	end

	if walletLabel then
		walletLabel.Text = string.format("$%.2f", data.Money)
	end
end

-- Creates an authentic, fully articulated R6 Humanoid Character
local function buildR6CharacterModel(name: string, paletteIndex: number, spawnPos: Vector3): Model
	local palette = AVATAR_PALETTES[((paletteIndex - 1) % #AVATAR_PALETTES) + 1]

	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = palette.Skin
	desc.TorsoColor = palette.Torso
	desc.LeftArmColor = palette.Skin
	desc.RightArmColor = palette.Skin
	desc.LeftLegColor = palette.Legs
	desc.RightLegColor = palette.Legs

	local model: Model
	local ok, created = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)

	if ok and created then
		model = created
	else
		-- Fallback manual R6 construct
		model = Instance.new("Model")
		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = Vector3.new(2, 2, 1)
		hrp.Transparency = 1
		hrp.CanCollide = false
		hrp.Parent = model
		model.PrimaryPart = hrp

		local torso = Instance.new("Part")
		torso.Name = "Torso"
		torso.Size = Vector3.new(2, 2, 1)
		torso.Color = palette.Torso
		torso.Parent = model

		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(1.2, 1.2, 1.2)
		head.Color = palette.Skin
		head.Parent = model

		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R6
		hum.MaxHealth = 100
		hum.Health = 100
		hum.WalkSpeed = 16
		hum.Parent = model

		local rootJoint = Instance.new("Motor6D")
		rootJoint.Name = "RootJoint"
		rootJoint.Part0 = hrp
		rootJoint.Part1 = torso
		rootJoint.Parent = hrp
	end

	model.Name = name

	-- Ensure humanoid properties are tuned for match play
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.MaxHealth = 100
		hum.Health = 100
		hum.WalkSpeed = 16
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	-- Prevent default death sound / prompt collisions
	for _, c in ipairs(model:GetDescendants()) do
		if c:IsA("LuaSourceContainer") or c:IsA("Tool") or c.Name == "PlayPrompt" then
			c:Destroy()
		end
	end

	model:PivotTo(CFrame.new(spawnPos))
	return model
end

function TestPlayerSpawner.CreateTestPlayer(name: string, id: number, paletteIdx: number, startPos: Vector3, playerData: {[number]: any}): TestPlayerData
	local char = buildR6CharacterModel(name, paletteIdx, startPos)

	local startMoney = (gameConfig and gameConfig.StartingMoney) or 20.00
	local maxHealth = (gameConfig and gameConfig.MaxHealth) or 100

	local bbg = attachOverheadHUD(char, name, maxHealth, startMoney)

	char:SetAttribute("UserId", id)
	char:SetAttribute("Name", name)
	char:SetAttribute("DisplayName", name)
	char:SetAttribute("Money", startMoney)
	char:SetAttribute("Wallet", startMoney)
	char:SetAttribute("Health", maxHealth)
	char:SetAttribute("HP", maxHealth)
	char:SetAttribute("IsInGame", true)

	if gameplayArea then
		char.Parent = gameplayArea
	else
		char.Parent = Workspace
	end

	local data: TestPlayerData = {
		UserId = id,
		Name = name,
		DisplayName = name,
		Money = startMoney,
		Wallet = startMoney,
		Health = maxHealth,
		IsAlive = true,
		IsAFK = false,
		ParticipationState = "Active",
		CurrentBid = 0,
		Votes = 0,
		IsBot = true,
		IsTestPlayer = true,
		Character = char,
		Billboard = bbg,
	}

	table.insert(activeTestPlayers, data)
	if playerData then
		playerData[id] = data
	end

	return data
end

function TestPlayerSpawner.SpawnTestPlayers(targetTotal: number, realEligibleCount: number, playerData: {[number]: any}): {TestPlayerData}
	TestPlayerSpawner.CleanupTestPlayers()
	local botsNeeded = math.max(0, targetTotal - realEligibleCount)
	if botsNeeded == 0 or not walkway then
		return activeTestPlayers
	end

	local wPos = walkway.Position
	for i = 1, botsNeeded do
		local bName = BOT_NAMES[i] or ("PlayerBot_" .. i)
		local bId = -100 - i
		local angle = (i / math.max(1, botsNeeded)) * math.pi * 2
		local radius = 22 + (i % 3) * 14
		local spawnPos = Vector3.new(wPos.X + math.cos(angle) * radius, wPos.Y + 3.5, wPos.Z + math.sin(angle) * radius)
		TestPlayerSpawner.CreateTestPlayer(bName, bId, i, spawnPos, playerData)
	end

	print(string.format("[TestPlayerSpawner] 🤖 Spawned %d Authentic R6 Test Players into match! Total participants: %d", botsNeeded, targetTotal))
	return activeTestPlayers
end

-- Smart Proportional Bidding AI: Scales bids to remaining wallet so matches run for unlimited rounds!
function TestPlayerSpawner.GenerateBids(livingPlayers: {any})
	for _, d in ipairs(livingPlayers) do
		if d.IsBot and d.IsAlive then
			local walletCents = math.round((d.Money or 0) * 100)
			local bidCents = 0

			if walletCents >= 1200 then
				-- High wallet: Conservative early bids ($0.50 to $2.25)
				bidCents = math.random(50, 225)
			elseif walletCents >= 500 then
				-- Mid wallet: Strategic bids ($0.30 to $1.50)
				local maxBid = math.min(walletCents, 150)
				bidCents = math.random(30, maxBid)
			elseif walletCents >= 100 then
				-- Low wallet: Budget survival bids ($0.15 to $0.75)
				local maxBid = math.min(walletCents, 75)
				bidCents = math.random(15, maxBid)
			elseif walletCents > 0 then
				-- Critical cents left: Spend remaining change ($0.05 to wallet)
				bidCents = math.random(5, walletCents)
			else
				-- Empty wallet: $0.00 bid (relies purely on physical dodge survival)
				bidCents = 0
			end

			local finalBid = bidCents / 100
			d.CurrentBid = finalBid
			d.SubmitTime = math.random(120, 880) / 100 -- Authentic 1.2s to 8.8s submit delay
			d.Money = math.max(0, (walletCents - bidCents) / 100)
			d.Wallet = d.Money

			if d.Character then
				d.Character:SetAttribute("Money", d.Money)
				d.Character:SetAttribute("Wallet", d.Money)
			end
			updateOverheadHUD(d)
		end
	end
end

-- Autonomous Scramble & Dodge AI: Unprotected test players sprint away from danger circle!
function TestPlayerSpawner.ScrambleTestPlayers(dangerCenter: Vector3, dangerRadius: number)
	if not walkway then return end
	local wPos = walkway.Position
	local walkwayRadius = 48

	for _, d in ipairs(activeTestPlayers) do
		if d.IsAlive and d.Character then
			local char = d.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local isProtected = char:FindFirstChild("SafeBidGlow") ~= nil

			if hum and root and hum.Health > 0 then
				if isProtected then
					-- Protected bots with neon green shield can idle or take small confident steps
					local smallAngle = math.random() * math.pi * 2
					local targetPos = root.Position + Vector3.new(math.cos(smallAngle) * 4, 0, math.sin(smallAngle) * 4)
					hum:MoveTo(targetPos)
				else
					-- UNPROTECTED BOT: Check proximity to danger circle and actively DODGE!
					local flatToDanger = Vector3.new(root.Position.X - dangerCenter.X, 0, root.Position.Z - dangerCenter.Z)
					local distToDanger = flatToDanger.Magnitude

					if distToDanger < (dangerRadius + 14) then
						-- Inside or near blast zone: sprint outward away from danger center towards walkway ring!
						local escapeDir = (distToDanger > 1) and flatToDanger.Unit or Vector3.new(1, 0, 0)
						local escapeTarget = root.Position + (escapeDir * (dangerRadius + 8))

						-- Clamp within walkway boundaries
						local toWalkway = Vector3.new(escapeTarget.X - wPos.X, 0, escapeTarget.Z - wPos.Z)
						if toWalkway.Magnitude > walkwayRadius then
							escapeTarget = Vector3.new(wPos.X, root.Position.Y, wPos.Z) + (toWalkway.Unit * (walkwayRadius - 4))
						end

						hum.WalkSpeed = 22 -- Sprint speed during scramble!
						hum:MoveTo(escapeTarget)
					end
				end
			end
		end
	end
end

-- Repositions living test players along the walkway ring between rounds
function TestPlayerSpawner.ScatterTestPlayers()
	if not walkway then return end
	local wPos = walkway.Position
	for i, d in ipairs(activeTestPlayers) do
		if d.IsAlive and d.Character then
			local hum = d.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = 16 end
			local angle = (i / math.max(1, #activeTestPlayers)) * math.pi * 2
			local radius = 22 + (i % 3) * 14
			d.Character:PivotTo(CFrame.new(wPos.X + math.cos(angle) * radius, wPos.Y + 3.5, wPos.Z + math.sin(angle) * radius))
		end
	end
end

-- Applies damage strictly to test players that were caught inside the danger zone and NOT protected
function TestPlayerSpawner.ApplyImpactDamage(hitParticipants: {any}?, dmg: number)
	local hitSet = {}
	if hitParticipants then
		for _, item in ipairs(hitParticipants) do
			hitSet[item] = true
			if typeof(item) == "Instance" then
				hitSet[item.Name] = true
			end
		end
	end

	for _, d in ipairs(activeTestPlayers) do
		if d.IsAlive and d.Character then
			local char = d.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local isProtected = (char:FindFirstChild("SafeBidGlow") ~= nil)
			local wasHit = (hitParticipants == nil) or (hitSet[char] or hitSet[char.Name] or hitSet[d.UserId])

			if not isProtected and wasHit and hum and hum.Health > 0 then
				d.Health = math.max(0, d.Health - dmg)
				hum.Health = d.Health
				char:SetAttribute("Health", d.Health)
				char:SetAttribute("HP", d.Health)
				updateOverheadHUD(d)

				if d.Health <= 0 then
					d.IsAlive = false
					d.ParticipationState = "Eliminated"
					char:BreakJoints()
					task.delay(3.5, function()
						if char and char.Parent then
							char:Destroy()
						end
					end)
				end
			end
		end
	end
end

function TestPlayerSpawner.ResetParticipation()
	for _, data in ipairs(activeTestPlayers) do
		if data.IsAlive then
			data.ParticipationState = "Active"
			updateOverheadHUD(data)
		end
	end
end

function TestPlayerSpawner.GetActiveTestPlayers(): {TestPlayerData}
	return activeTestPlayers
end

return TestPlayerSpawner
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="30">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="31">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="32">
      <Properties>
        <string name="Name">BidToSurviveUI</string>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">ClientUIController</string>
          <string name="Source"><![CDATA[--!strict
-- src/client/ClientUIController.client.luau
-- Authoritative Client UI Orchestrator: Connects ReplicatedStorage.Network events
-- to modular UI views (Docks, Banner, Modals, Hammer Spinner, Effects).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local StarterGui = game:GetService("StarterGui")

-- Eliminate default Roblox top-right Health Bar completely
task.spawn(function()
	local maxRetries = 20
	while maxRetries > 0 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then break end
		task.wait(0.2)
		maxRetries -= 1
	end
end)

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local gui = (script:FindFirstAncestorWhichIsA("ScreenGui") or playerGui:WaitForChild("BidToSurviveUI")) :: ScreenGui

-- Shared Modules & Network
local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig")) :: any
local Network = ReplicatedStorage:WaitForChild("Network")

local StateChanged = Network:WaitForChild("StateChanged") :: RemoteEvent
local PromptBid = Network:WaitForChild("PromptBid") :: RemoteEvent
local BidSubmitted = Network:WaitForChild("BidSubmitted") :: RemoteEvent
local RankingsRevealed = Network:WaitForChild("RankingsRevealed") :: RemoteEvent
local HammerSmash = Network:WaitForChild("HammerSmash") :: RemoteEvent
local RoundOver = Network:WaitForChild("RoundOver") :: RemoteEvent
local MatchOver = Network:WaitForChild("MatchOver") :: RemoteEvent
local StatsUpdated = Network:WaitForChild("StatsUpdated") :: RemoteEvent

local SetAFK = Network:FindFirstChild("SetAFK") :: RemoteEvent?
if not SetAFK then
	SetAFK = Instance.new("RemoteEvent")
	SetAFK.Name = "SetAFK"
	SetAFK.Parent = Network
end

local ParticipationChanged = Network:FindFirstChild("ParticipationChanged") :: RemoteEvent?
if not ParticipationChanged then
	ParticipationChanged = Instance.new("RemoteEvent")
	ParticipationChanged.Name = "ParticipationChanged"
	ParticipationChanged.Parent = Network
end

-- Modular UI Views
local ClientUI = ReplicatedStorage:WaitForChild("ClientUI")
local ControlsDockView = require(ClientUI:WaitForChild("components"):WaitForChild("ControlsDockView")) :: any
local PhaseBannerView = require(ClientUI:WaitForChild("components"):WaitForChild("PhaseBannerView")) :: any
local ActionDockView = require(ClientUI:WaitForChild("components"):WaitForChild("ActionDockView")) :: any
local HammerRouletteView = require(ClientUI:WaitForChild("components"):WaitForChild("HammerRouletteView")) :: any
local BiddingModalView = require(ClientUI:WaitForChild("modals"):WaitForChild("BiddingModalView")) :: any
local RankingsModalView = require(ClientUI:WaitForChild("modals"):WaitForChild("RankingsModalView")) :: any
local MatchOverModalView = require(ClientUI:WaitForChild("modals"):WaitForChild("MatchOverModalView")) :: any
local ScreenEffectsView = require(ClientUI:WaitForChild("effects"):WaitForChild("ScreenEffectsView")) :: any

-- State
local CurrentMoney = GameConfig.StartingMoney or 20.00
local CurrentHealth = GameConfig.MaxHealth or 100
local IsAlive = true
local IsAFK = false
local CurrentParticipationState = "WaitingInLobby"
local CurrentPhase = "Intermission"
local CurrentRound = 0
local SessionToken = 0

local function IsActiveInRound(): boolean
	return (CurrentParticipationState == "Active") or (LocalPlayer:GetAttribute("IsInGame") == true)
end

-- Clean up obsolete legacy StatsCard if present
local oldStatsCard = gui:FindFirstChild("StatsCard")
if oldStatsCard then
	oldStatsCard:Destroy()
end
local legacyStatsCard = playerGui:FindFirstChild("BidToSurviveUI") and playerGui.BidToSurviveUI:FindFirstChild("StatsCard")
if legacyStatsCard then
	legacyStatsCard:Destroy()
end

-- Initialize Components
local screenEffects = ScreenEffectsView.new(gui)
local controlsDock = ControlsDockView.new(gui, SetAFK)
local phaseBanner = PhaseBannerView.new(gui)
local biddingModal = BiddingModalView.new(gui, BidSubmitted, nil)
local rankingsModal = RankingsModalView.new(gui, nil)
local matchOverModal = MatchOverModalView.new(gui, nil)

local actionDock = ActionDockView.new(gui, function()
	if IsActiveInRound() and CurrentPhase == "Phase3_Bid" then
		biddingModal:Open(CurrentMoney)
	end
end, function()
	if IsActiveInRound() and CurrentPhase == "Phase4_Reveal" then
		rankingsModal:Open()
	end
end)

local hammerRoulette = HammerRouletteView.new(gui, GameConfig, function(intensity, duration)
	screenEffects:ShakeCamera(intensity, duration, IsActiveInRound)
end)

local function updateActionButtons()
	actionDock:UpdateVisibility(CurrentPhase, IsActiveInRound(), biddingModal:IsVisible(), rankingsModal:IsVisible())
end

-- Link visibility change callbacks to actionDock
biddingModal.ModalFrame:GetPropertyChangedSignal("Visible"):Connect(updateActionButtons)
rankingsModal.ModalFrame:GetPropertyChangedSignal("Visible"):Connect(updateActionButtons)

-- Bind damage flash
if LocalPlayer.Character then
	screenEffects:BindCharacterHealth(LocalPlayer.Character, IsActiveInRound)
end
LocalPlayer.CharacterAdded:Connect(function(newChar)
	screenEffects:BindCharacterHealth(newChar, IsActiveInRound)
end)

local function forceHideAllRoundUI()
	biddingModal:Close()
	rankingsModal:Close()
	matchOverModal:Hide()
	hammerRoulette:Stop()
	actionDock:SetVisible(false)
	if CurrentPhase ~= "Intermission" then
		phaseBanner:SetVisible(false)
	end
end

-- Network Listeners
StateChanged.OnClientEvent:Connect(function(arg1, arg2)
	local phase: string = ""
	local data: any = nil
	if typeof(arg1) == "table" then
		data = arg1
		phase = arg1.Phase or ""
	else
		phase = tostring(arg1 or "")
		data = arg2 or {}
	end

	CurrentPhase = phase
	SessionToken += 1
	local myToken = SessionToken

	local deadline = (data and data.Deadline) or 0
	local round = (data and (data.Round or data.CurrentRound)) or CurrentRound
	CurrentRound = round
	local living = (data and data.LivingCount) or (data and data.Living) or 0

	phaseBanner:UpdateParticipation(IsActiveInRound(), IsAFK)
	phaseBanner:SetPhase(phase, round, living, deadline)

	if not IsActiveInRound() then
		forceHideAllRoundUI()
		if phase == "Intermission" then
			phaseBanner:SetVisible(not IsAFK)
		else
			phaseBanner:SetVisible(false)
		end
		return
	end

	updateActionButtons()

	if phase == "Intermission" then
		phaseBanner:SetVisible(true)
		forceHideAllRoundUI()
	elseif phase == "Phase1_Spawn" then
		phaseBanner:SetVisible(true)
		biddingModal:Close()
		rankingsModal:Close()
		local rarity = data and data.Rarity
		if rarity then
			local spinnerReel = (data.Extra and data.Extra.SpinnerReel) or data.SpinnerReel
			task.spawn(function()
				hammerRoulette:Play(rarity, data.RouletteDuration or 6.0, spinnerReel, IsActiveInRound, myToken, function() return SessionToken end)
			end)
		end
	elseif phase == "Phase2_Vote" then
		phaseBanner:SetVisible(true)
		hammerRoulette:Stop()
		biddingModal:Close()
		rankingsModal:Close()
	elseif phase == "Phase3_Bid" then
		phaseBanner:SetVisible(true)
		hammerRoulette:Stop()
		rankingsModal:Close()
	elseif phase == "Phase4_Reveal" then
		phaseBanner:SetVisible(false)
		hammerRoulette:Stop()
		biddingModal:Close()
		biddingModal:Reset()
	elseif phase == "Phase5_Scramble" then
		phaseBanner:SetVisible(true)
		hammerRoulette:Stop()
		rankingsModal:Close()
		biddingModal:Close()
		biddingModal:Reset()
	elseif phase == "Phase6_Smash" then
		phaseBanner:SetVisible(true)
		hammerRoulette:Stop()
		biddingModal:Close()
		rankingsModal:Close()
	elseif phase == "Phase7_Settlement" then
		phaseBanner:SetVisible(true)
		hammerRoulette:Stop()
		biddingModal:Close()
		rankingsModal:Close()
	elseif phase == "MatchOver" then
		phaseBanner:SetVisible(false)
		hammerRoulette:Stop()
		biddingModal:Close()
		biddingModal:Reset()
		rankingsModal:Close()
	end

	updateActionButtons()
end)

PromptBid.OnClientEvent:Connect(function(_data)
	CurrentPhase = "Phase3_Bid"
	if not IsActiveInRound() then
		biddingModal:Close()
		updateActionButtons()
		return
	end
	biddingModal:Reset()
	biddingModal:Open(CurrentMoney)
	updateActionButtons()
end)

RankingsRevealed.OnClientEvent:Connect(function(data)
	CurrentPhase = "Phase4_Reveal"
	if not IsActiveInRound() then
		rankingsModal:Close()
		updateActionButtons()
		return
	end
	phaseBanner:SetVisible(false)
	rankingsModal:Populate(data, LocalPlayer, CurrentRound)
	updateActionButtons()
end)

HammerSmash.OnClientEvent:Connect(function(data)
	if not IsActiveInRound() then return end
	local rarity = data and data.Rarity
	local impactDelay = (data and data.ImpactDelay) or 1.33
	local myToken = SessionToken

	task.delay(impactDelay, function()
		if (not IsActiveInRound()) or myToken ~= SessionToken then return end
		local intensity = (rarity and rarity.CameraShake) or 1.0
		screenEffects:ShakeCamera(intensity * 3, 0.8, IsActiveInRound)
	end)
end)

RoundOver.OnClientEvent:Connect(function()
	rankingsModal:Close()
	biddingModal:Close()
	updateActionButtons()
end)

MatchOver.OnClientEvent:Connect(function(data)
	if IsAFK then return end
	matchOverModal:Show(data, LocalPlayer)
end)

StatsUpdated.OnClientEvent:Connect(function(stats)
	CurrentMoney = stats.Money or CurrentMoney
	CurrentHealth = stats.Health or CurrentHealth
	IsAlive = (stats.IsAlive ~= nil) and stats.IsAlive or IsAlive
	if stats.IsAFK ~= nil then
		IsAFK = stats.IsAFK
		controlsDock:SetAFK(IsAFK)
	end
	if stats.ParticipationState ~= nil then
		CurrentParticipationState = stats.ParticipationState
	end

	phaseBanner:UpdateParticipation(IsActiveInRound(), IsAFK)
	if not IsActiveInRound() then
		forceHideAllRoundUI()
	else
		updateActionButtons()
	end
end)

if ParticipationChanged then
	ParticipationChanged.OnClientEvent:Connect(function(newState: string)
		CurrentParticipationState = newState
		phaseBanner:UpdateParticipation(IsActiveInRound(), IsAFK)
		if not IsActiveInRound() then
			forceHideAllRoundUI()
		else
			updateActionButtons()
		end
	end)
end

LocalPlayer:GetAttributeChangedSignal("IsInGame"):Connect(function()
	phaseBanner:UpdateParticipation(IsActiveInRound(), IsAFK)
	if not IsActiveInRound() then
		forceHideAllRoundUI()
	else
		updateActionButtons()
	end
end)

-- Developer hotkey F4 to test Results UI in Studio
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.F4 then
		matchOverModal:Show({
			Winner = LocalPlayer.DisplayName,
			TotalDuration = 83,
			Podium = {
				{ Rank = 1, UserId = LocalPlayer.UserId, Name = LocalPlayer.Name, DisplayName = LocalPlayer.DisplayName, SurvivalTime = 83 },
				{ Rank = 2, UserId = 1, Name = "RunnerUp", DisplayName = "RunnerUp", SurvivalTime = 72 },
				{ Rank = 3, UserId = 2, Name = "Contender", DisplayName = "Contender", SurvivalTime = 58 },
			},
		}, LocalPlayer)
	end
end)
]]></string>
        </Properties>
      </Item>
